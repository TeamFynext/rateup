{
  "version": "2.0.0",
  "presentation": {
    "echo": true,
    "reveal": "always",
    "focus": false,
    "panel": "new",
    "showReuseMessage": false
  },
  "tasks": [
    {
      "label": "Backend",
      "type": "shell",
      "command": "vp run rateup-api#dev",
      "isBackground": true,
      "presentation": { "group": "backend" }
    },
    {
      "label": "Frontend",
      "type": "shell",
      "command": "vp -C apps/rateup-ui dev",
      "isBackground": true,
      "presentation": { "group": "frontend" }
    },
    {
      "label": "Admin",
      "type": "shell",
      "command": "vp -C apps/rateup-admin dev",
      "isBackground": true,
      "presentation": { "group": "admin" }
    },
    {
      "label": "bullmq",
      "type": "shell",
      "command": "vp run rateup-api#dev:bullmq",
      "isBackground": true,
      "presentation": { "group": "system" }
    },
    {
      "label": "kafka Worker",
      "type": "shell",
      "command": "vp run rateup-api#dev:kafka",
      "isBackground": true,
      "presentation": { "group": "system" }
    },
    {
      "label": "Launch All",
      "dependsOn": ["Backend", "Frontend", "bullmq", "kafka Worker"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
