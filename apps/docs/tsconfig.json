{
  "extends": "@rateup/tsconfig/vite-react.json",
  "include": ["**/*.ts", "**/*.tsx", "**/*.mdx"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      "collections/*": ["./.source/*"]
    },
    // The docs site never set these; null resets them to TypeScript's defaults.
    "allowArbitraryExtensions": null,
    "resolveJsonModule": null,
    "moduleDetection": null
  }
}
