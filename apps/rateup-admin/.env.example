# rateup-api's origin; the console calls it directly (the API's STAFF_CONSOLE_ORIGIN must be
# this console's origin). Inlined at build time, so set it before `npm run build`.
VITE_API_URL=http://localhost:3001

# Header environment badge (local / staging / production).
VITE_APP_ENV=local
# Dev only: sign in as a fake staff user without the API. Has no effect in `vite build`.
# To use the real API locally with a personal Google account, leave this false: with
# NODE_ENV=development the API accepts any domain (see STAFF_GOOGLE_HD in its .env.example).
VITE_STAFF_MOCK=false
# Workspace domain staff sign in with (matches the API's STAFF_GOOGLE_HD). `vite dev` accepts
# any domain in the Add staff form, as a NODE_ENV=development API does.
VITE_STAFF_DOMAIN=rateup.app
