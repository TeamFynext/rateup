# Dev-server proxy only (vite.config.ts). In production these are Cloudflare Pages env vars.
API_ORIGIN=http://localhost:3001
STAFF_PROXY_SECRET=

# Header environment badge (local / staging / production).
VITE_APP_ENV=local
# Dev only: sign in as a fake staff user without the API. Has no effect in `vite build`.
VITE_STAFF_MOCK=false
