# rateup-api's origin; the console calls it directly (the API's STAFF_CONSOLE_ORIGIN must be
# this console's origin). Inlined at build time, so set it before `npm run build`.
VITE_API_URL=http://localhost:3001

# Header environment badge (local / staging / production).
VITE_APP_ENV=local
# Dev only: sign in as a fake staff user without the API. Has no effect in `vite build`.
# To use the real API locally without Google, leave this false and set
# STAFF_DEV_BYPASS_EMAIL in rateup-api's .env instead (localhost only; see its .env.example).
VITE_STAFF_MOCK=false
# Workspace domain staff sign in with (matches the API's STAFF_GOOGLE_HD)
VITE_STAFF_DOMAIN=rateup.app
