{
  // Emit only this app's files. Types were checked by tsconfig.json (the build runs it
  // first); at runtime @rateup/api resolves to its compiled dist/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": false,
    "noCheck": true,
    "customConditions": null
  },
  "include": ["src/**/*.ts"]
}
