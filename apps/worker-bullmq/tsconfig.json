{
  // Type check: loads @rateup/api from source, plus its global declarations
  // (Fastify route config, PrismaJson and friends), which nothing imports directly.
  "extends": "@rateup/tsconfig/node.json",
  "compilerOptions": {
    // Nothing is emitted here; the root only has to contain the @rateup/api sources.
    "rootDir": "../..",
    "noEmit": true
  },
  // The API's .tsx files are listed so `tsx` (dev) compiles them with this config's
  // "jsx": "react-jsx"; it skips a tsconfig for files outside its include and falls back
  // to classic JSX, which throws "React is not defined" when an email renders.
  "include": ["src/**/*.ts", "../../apps/api/src/types/*.d.ts", "../../apps/api/src/**/*.tsx"]
}
