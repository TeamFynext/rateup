# rateup-api — copy to .env and fill in.
#
# One build, three services (see AGENTS.md → Deployment Topology):
#   api     `pnpm run dev`         HTTP, WebSocket, Kafka producer
#   bullmq  `pnpm run dev:bullmq`  queue consumers + the wall-clock schedule
#   kafka   `pnpm run dev:kafka`   status-events consumer
# The two workers run this app's code, so their .env.example files are copies of this one.
#
# Simplest setup is one env shared by all three. If you scope them separately on
# Railway, the minimum each needs is marked below:
#   [all]     every service
#   [api]     HTTP service only
#   [workers] bullmq + kafka only
# Anything unmarked is optional and has a working default or a disabled feature.
#
# Rules: on/off switches take `true` or `false` (nothing else — 1, yes or a typo is ignored
# with a warning). URLs never end in a slash. `node scripts/env-rename.mjs --sort` puts an
# existing .env into the order below.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# HTTP listener. Defaults: 3001 / ::. The bullmq and kafka services also listen on
# PORT (defaults 3002 / 3003) for /health and /metrics; Railway sets it.
# PORT=3001
# HOST=::
LOG_LEVEL=info
# One line per entry by default outside development; true prints readable multi-line logs.
# LOG_PRETTY=false
# Turns every log line off (tests, scripts).
# LOG_DISABLED=false
# When set, enables the api's /api/health/metrics (Bearer auth).
# METRICS_TOKEN=
# Serves the Scalar API docs UI. The OpenAPI JSON is always served.
API_DOCS_ENABLED=false
# ffmpeg transcodes one API process runs at once for public video/audio uploads (more
# wait in a short queue, then 503). Default 2.
# UPLOAD_TRANSCODE_CONCURRENCY=2

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000                              # [all] used in emails and CORS
# Also the origin customers are redirected through (loyalty feedback review links), so in
# production it must be the public HTTPS address, not an internal one.
API_URL=http://localhost:3001
# Extra CORS origins beyond FRONTEND_URL, comma separated.
CORS_ALLOWED_ORIGINS=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/rateup   # [all]
# Max connections per pg pool, per process (Prisma's adapter pool and the raw
# pool in src/utils/db.ts each get this many). Budget it against Postgres'
# max_connections across every replica of api/bullmq/kafka. Default 10.
DB_POOL_MAX=10                                                  # [all] optional
# How long a transaction may wait for a pooled connection, then how long it may run (ms).
# DB_TRANSACTION_MAX_WAIT_MS=15000
# DB_TRANSACTION_TIMEOUT_MS=30000

# ── Redis & Kafka ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379                                # [all]
# One broker (host:port), or several separated by commas. See docker-compose.yaml.
KAFKA_BROKERS=localhost:9092                                    # [all]
# Replication factor for the topics created at boot (src/utils/kafka.ts). Must
# not exceed the broker count. Default 1.
# KAFKA_REPLICATION_FACTOR=1                                    # [all] optional
# Producers are idempotent by default; false turns it off (see kafkaProducerConfig).
# KAFKA_IDEMPOTENT=true                                         # [all] optional

# ── Workers ──────────────────────────────────────────────────────────────────
# In-flight campaign sends per bullmq process (waMessage.processor.ts). Pairs
# with DB_POOL_MAX: keep it within ~5x the pool and raise the two together.
# Default 50.
CAMPAIGN_SEND_CONCURRENCY=50                                    # [workers] optional
# Spacing between campaign send batches, in ms. Defaults to 24h when unset.
# CAMPAIGN_BATCH_INTERVAL_MS=86400000
# How many wa-webhooks partitions one kafka-service replica works on at once.
# WA_WEBHOOK_PARTITIONS_CONCURRENTLY=4
# Conversations (Kafka keys) worked on at once within one batch. Default 16.
# WA_WEBHOOK_LANE_CONCURRENCY=16
# Logs a running count of message statuses received. On by default only in development
# and test; true turns it on anywhere (e.g. against the mock), false off.
# STATUS_TALLY_ENABLED=

# ── Security & rate limits ───────────────────────────────────────────────────
# Proxy hops in front of the API whose X-Forwarded-For entries are trusted (Cloudflare,
# then Railway's edge = 2). The client IP used for rate limits is read past them; with
# CF-Connecting-IP present it wins. 0 = trust none (direct exposure). Default 2.
# TRUST_PROXY_HOPS=2
# Shared with the web app's SSR_SHARED_SECRET. When the web app renders a storefront it sends
# the visitor's address with this secret, and rate limits count that visitor instead of
# the web server. Unset: every server render shares the web server's bucket.
SSR_SHARED_SECRET=                                              # [api]
# Some routes refuse (503) when Redis is down rather than going unlimited. true lets them
# through instead, for an emergency.
# RATE_LIMIT_FAIL_CLOSED_DISABLED=false
# Comma-separated /api/<module> prefixes where a permission refusal is only logged and the
# request goes through, for a rollout soak.
# AUTHZ_AUDIT_ONLY=
# A route that declares no permission stops boot instead of being logged (vitest sets it).
# AUTHZ_STRICT=false

# ── Sign-in (SuperTokens) ────────────────────────────────────────────────────
SUPERTOKENS_CONNECTION_URI=http://localhost:3567                # [api]
SUPERTOKENS_API_KEY=                                            # [api]
SUPERTOKENS_GOOGLE_CLIENT_ID=
SUPERTOKENS_GOOGLE_CLIENT_SECRET=
SUPERTOKENS_SMS_API_KEY=
# Sign in with Apple.
APPLE_CLIENT_ID=
APPLE_IOS_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Phone (SMS OTP) sign-in creates an account for an unknown number unless this is false;
# false refuses unknown numbers and stops SMS to them. The web app's phone sign-up needs it
# left unset/true.
# PASSWORDLESS_PHONE_SIGNUP_ENABLED=true
# SuperTokens' admin dashboard at /api/auth/dashboard is off unless true; then only the
# comma-separated emails in SUPERTOKENS_DASHBOARD_ADMINS may manage users.
# SUPERTOKENS_DASHBOARD_ENABLED=false
# SUPERTOKENS_DASHBOARD_ADMINS=
# Cloudflare Turnstile secret. When set, sign-up and SMS-code requests need a CAPTCHA token;
# set the web app's VITE_TURNSTILE_SITE_KEY first, or sign-up stops working. Unset = off.
# Cloudflare's test secret 1x0000000000000000000000000000000AA accepts every token (local dev).
# TURNSTILE_SECRET_KEY=

# ── Meta (WhatsApp, Instagram, Messenger) ────────────────────────────────────
# The Meta app (developers.facebook.com → App settings → Basic). The web app's
# VITE_META_APP_ID is the same id.
META_APP_ID=
META_APP_SECRET=                                                # also signs Meta webhooks
# Encrypts stored access tokens, Flow keys and Meta Agent data — hex, and shared by api and
# workers. Change it and everything stored with it becomes undecryptable.
META_ENCRYPTION_KEY=                                            # [all]
# Path under FRONTEND_URL that Meta's OAuth dialog returns to.
META_OAUTH_REDIRECT_PATH=
# The "Verify token" entered with the webhook URL in the Meta app dashboard.
META_WEBHOOK_VERIFY_TOKEN=
# Meta webhook signature check (X-Hub-Signature-256, signed with META_APP_SECRET) on the
# WhatsApp, Instagram and Messenger webhooks: enforce | log | off. Defaults to enforce
# (unsigned or mis-signed deliveries get 401); log processes them with a warning and is the
# rollback. Local tools that post unsigned webhooks (e.g. @rateup/meta-mock) need log.
# META_WEBHOOK_SIGNATURES=enforce
# WhatsApp webhook ingress: kafka (default) publishes each delivery to the `wa-webhooks`
# topic and only then answers Meta 200 — the kafka service processes it. inline answers 200
# and processes in the request (the old, lossy behaviour), as a fallback.
# WA_WEBHOOK_INGRESS=kafka
# WA_WEBHOOK_PRODUCE_TIMEOUT_MS=8000
WA_REGISTRATION_PIN=
# WhatsApp Flows key pair, as JSON (see encryption.utils.ts).
WA_FLOW_ENCRYPTION_KEYS=
# Signs the WhatsApp Flow `flow_token`, which carries the run context (survey
# mapping, org, respondent) through Meta and back. Any long random string;
# rotating it invalidates flows already open with respondents.
FLOW_TOKEN_SECRET=change-me                                     # [all]
# Development only: logs what a failed Flow signature check expected. Ignored in production.
# FLOW_SIGNATURE_DEBUG=false

# ── Meta mock (local development) ────────────────────────────────────────────
# Redirects the Graph host at @rateup/meta-mock for local development.
# LEAVE UNSET IN PRODUCTION — set here, real sends go to the mock instead of Meta.
# META_API_BASE_URL=http://localhost:8081
# META_API_BASE_URL is only honoured outside production (NODE_ENV=development/test, or a
# Railway environment other than "production"). Set ALLOW_META_MOCK=true to force it, e.g. a
# staging service with no RAILWAY_ENVIRONMENT_NAME.
# ALLOW_META_MOCK=false
# Only meaningful with META_API_BASE_URL: identifies the account the mock replays
# inbound messages for. Must match the WhatsappSettings row you are testing.
# META_MOCK_WABA_ID=
# META_MOCK_PHONE_NUMBER_ID=

# ── Email (AWS SES) ──────────────────────────────────────────────────────────
# Suppress every outbound email. Set it in development, and in any environment
# restored from a copy of production data — the addresses on file there belong
# to real people, and a campaign that finishes emails every user on the team.
# In-app and push notifications still work; only the SES call is skipped.
EMAIL_DISABLED=false                                            # [all] optional
AWS_SES_REGION=ap-south-1                                       # [all]
AWS_SES_ACCESS_KEY_ID=                                          # [all]
AWS_SES_SECRET_ACCESS_KEY=                                      # [all]
# The SNS topic SES publishes bounces/complaints to (set as the sending identity's default
# configuration set in the SES console); only this topic may post to
# /api/public/customer-comms/ses-events. Unset = no bounce suppression.
# SES_EVENTS_TOPIC_ARN=                                         # [api]

# ── File storage & CDN (AWS S3) ──────────────────────────────────────────────
AWS_S3_REGION=
AWS_S3_BUCKET=
# Private bucket for files with customer data (shop invoices), handed out only as signed
# links. Must not sit behind the public CloudFront distribution. Falls back to AWS_S3_BUCKET.
AWS_S3_PRIVATE_BUCKET=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
# CDN for uploaded media (attachments, avatars, survey uploads). The web and mobile apps
# read the same URL as VITE_MEDIA_CDN_URL / EXPO_PUBLIC_MEDIA_CDN_URL.
MEDIA_CDN_URL=                                                  # [all] media in outbound messages
MEDIA_CDN_DOMAIN=                                               # its host alone, no https://
# CDN for images made on the dashboard (VITE_ / EXPO_PUBLIC_WEB_IMAGES_CDN_URL elsewhere).
WEB_IMAGES_CDN_URL=                                             # [all] images in email templates

# ── Push notifications ───────────────────────────────────────────────────────
# Both default to Expo's public endpoints; override only to point at a mock.
EXPO_PUSH_URL=
EXPO_PUSH_RECEIPTS_URL=
# iOS VoIP pushes for incoming calls, with a .p8 key from the Apple Developer account.
# Unset = off; calls fall back to the ordinary Expo push.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# The .p8 contents (PEM; `\n` escapes are accepted).
# APNS_AUTH_KEY=
# Defaults to the app's bundle id.
# APNS_BUNDLE_ID=
# production (TestFlight / App Store, the default) or development (a build from Xcode).
# APNS_ENV=production

# ── Payments ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_API_KEY=
RAZORPAY_API_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Integrations ─────────────────────────────────────────────────────────────
# Integration security: signs OAuth state and encrypts the secret fields of
# Integration.credential. 32 random bytes, base64: `openssl rand -base64 32`.
# Unset = credentials stored unencrypted (with a warning). Once set, never
# change it by replacing it: every encrypted credential needs this exact key.
INTEGRATION_SECRET_KEY=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated; must match [access_scopes] in shopify.app.toml, which is what Shopify
# actually grants (managed installation, pushed with `shopify app deploy`). A scope added
# there is offered to installed merchants by Shopify and lands via app/scopes_update.
# `write_discounts` is what lets a loyalty redemption code become a real discount code at
# the shop's checkout (shopifyDiscount.service.ts).
SHOPIFY_SCOPES=
# The customer HubSpot integration: the app defined in hubspot-app/ (a HubSpot developer
# project, uploaded with `hs project upload`; client ID and secret are on its Auth tab).
# Its redirect URL must be <FRONTEND_URL>/dashboard/settings/integrations/hubspot/callback,
# its scopes must equal HUBSPOT_SCOPES, and its webhook target URL must be
# <API_URL>/api/public/integrations/hubspot/webhooks — all three set in hubspot-app/src/app.
# Not the same as HUBSPOT_PRIVATE_APP_ACCESS_TOKEN (RateUp's own CRM, further down).
# Deliveries are signed with HUBSPOT_CLIENT_SECRET (v3), and API_URL must be the exact
# public address HubSpot calls.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# The customer Pipedrive integration: a private app in RateUp's Pipedrive Developer Hub.
# Its callback URL must be <FRONTEND_URL>/dashboard/settings/integrations/pipedrive/callback;
# its OAuth scopes are chosen there: deals and contacts (persons, notes) full access, webhooks
# full access, users read. RateUp creates each company's webhooks itself, pointed at API_URL,
# so API_URL must be reachable from Pipedrive (a public tunnel in development).
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=

# ── Other services ───────────────────────────────────────────────────────────
# The AI service that writes survey-response summaries.
AI_API_URL=
# Reverse geocoding (coordinates → address).
GEOAPIFY_API_KEY=
UNSPLASH_API_URL=
UNSPLASH_ACCESS_KEY=

# ── Analytics ────────────────────────────────────────────────────────────────
# Analytics responses (/dashboard/analytics) go through a short Redis cache; nothing needs
# setting. Emergency switch: true sends every analytics request straight to the database.
# The cache already fails open when Redis is down, so this is only for when cached numbers
# themselves are the problem.
# ANALYTICS_CACHE_DISABLED=false                                # [api]

# ── Staff console (apps/admin, /api/staff) ───────────────────────────────────
# Off unless STAFF_CONSOLE_ORIGIN is set; once it is, the rest (and API_URL) are required
# at boot. The console calls this API directly, so the origin is also added to CORS.
# The console's own origin, e.g. https://admin.rateup.app (local: http://localhost:4000).
STAFF_CONSOLE_ORIGIN=
# Signs the sign-in state cookie. At least 32 characters.
STAFF_COOKIE_SECRET=
# The origin the console calls this API on, when it is not API_URL (defaults to API_URL).
# Locally, with API_URL pointing at a tunnel for webhooks: http://localhost:3001
STAFF_API_ORIGIN=
# A Google OAuth client of its own (not SUPERTOKENS_GOOGLE_*). Redirect URI:
#   <STAFF_API_ORIGIN or API_URL>/api/staff/auth/google/callback
STAFF_GOOGLE_CLIENT_ID=
STAFF_GOOGLE_CLIENT_SECRET=
# Workspace domain staff sign in from. Defaults to rateup.app. Not applied when
# NODE_ENV=development: locally any Google account on the staff list can sign in (add one
# with `pnpm run staff:add you@gmail.com --owner`).
STAFF_GOOGLE_HD=rateup.app
# Cloudflare Access in front of the console. false skips the check (production logs a warning).
STAFF_CF_ACCESS_ENABLED=true
CF_ACCESS_TEAM=
CF_ACCESS_AUD=

# ── RateUp's own org ─────────────────────────────────────────────────────────
# RateUp's own organisation: its WhatsApp number sends customer comms (staff console →
# Engage), with the AWS_SES_* keys for email, replying to ROOT_ORG_EMAIL. ROOT_ORG_EMAIL
# also receives the book-a-demo and contact forms.
ROOT_ORG_ID=
ROOT_ORG_EMAIL=
# RateUp's own HubSpot CRM, which new sign-ups are synced to.
HUBSPOT_PRIVATE_APP_ACCESS_TOKEN=
# The survey copied into every new team, and the team whose surveys are the templates.
INITIAL_SAMPLE_SURVEY_ID=
SURVEY_TEMPLATES_TEAM_ID=

# ── Tests ────────────────────────────────────────────────────────────────────
# SuperTokens tenant the test helpers use. Default public.
TEST_TENANT_ID=

# ── Not set here ─────────────────────────────────────────────────────────────
# RAILWAY_ENVIRONMENT_NAME is set by Railway; "production" there keeps META_API_BASE_URL off.
