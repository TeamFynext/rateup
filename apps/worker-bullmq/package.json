{
  "name": "@rateup/worker-bullmq",
  "version": "0.0.0",
  "private": true,
  "description": "BullMQ worker: campaign sends, imports, webhooks, scheduled jobs.",
  "license": "MIT",
  "author": "Rateup Team",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest --silent",
    "lint": "oxlint"
  },
  "dependencies": {
    "@rateup/api": "workspace:*",
    "bullmq": "catalog:",
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "@rateup/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "26.x"
  }
}
