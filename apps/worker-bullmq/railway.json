{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @rateup/worker-bullmq... run build",
    "watchPatterns": [
      "apps/worker-bullmq/**",
      "packages/server/**",
      "packages/db/**",
      "packages/tsconfig/**",
      "pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @rateup/worker-bullmq run start",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
