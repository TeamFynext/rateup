{
  "expo": {
    "name": "RateUp",
    "slug": "rateup",
    "version": "1.3.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "rateup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.rateupapp.rateup",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow RateUp to use your microphone for WhatsApp calls with customers and to record voice notes and videos for customer chats.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.rateupapp.rateup",
      "allowBackup": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RateUp to access your photos to send them in customer chats and to set your profile photo.",
          "cameraPermission": "Allow RateUp to use your camera to scan customer loyalty cards and to take photos and videos to send in customer chats.",
          "microphonePermission": "Allow RateUp to use your microphone for WhatsApp calls with customers and to record voice notes and videos for customer chats."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keepattributes SourceFile,LineNumberTable\n-renamesourcefileattribute SourceFile\n-dontwarn org.webrtc.**"
          }
        }
      ],
      "./plugins/withR8Optimize.js",
      "expo-video",
      ["expo-apple-authentication"],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.42123891439-smrmrokcalpi6j7m1dg1ep23keh4829f"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#F8951D",
          "defaultChannel": "default",
          "sounds": ["./assets/sounds/wa_call_ringtone.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow RateUp to use your microphone for WhatsApp calls with customers and to record voice notes and videos for customer chats.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-font",
      [
        "expo-document-picker",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-asset",
      "expo-status-bar",
      "expo-sqlite",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RateUp to use your camera to scan customer loyalty cards and to take photos and videos to send in customer chats.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 10,
            "NSExtensionActivationSupportsMovieWithMaxCount": 10
          },
          "iosShareExtensionName": "RateUp Share",
          "androidIntentFilters": ["image/*", "video/*"],
          "androidMultiIntentFilters": ["image/*", "video/*"]
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow RateUp to use your location so you can share it with customers in chat.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Allow RateUp to use your microphone for WhatsApp calls with customers and to record voice notes and videos for customer chats."
        }
      ],
      "./plugins/withIosCallKit.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/62982a5a-c2c6-4de4-931a-6af66d273ba8"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "62982a5a-c2c6-4de4-931a-6af66d273ba8"
      }
    },
    "owner": "rateup-app"
  }
}
