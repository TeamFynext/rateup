# Copy to `.env` and fill in. `.env` is gitignored; this file is the checked-in template,
# so it carries no real values — only the keys the app actually reads.
#
# Everything prefixed EXPO_PUBLIC_ is inlined into the JS bundle at build time and is
# readable by anyone with the app. Nothing secret belongs here.

# The RateUp API. Point this at a local tunnel while developing, or production.
EXPO_PUBLIC_API_URL=

# CDN serving uploaded media (attachments, avatars).
EXPO_PUBLIC_MEDIA_CDN_URL=

# CDN serving images authored on the web dashboard.
EXPO_PUBLIC_WEB_IMAGES_CDN_URL=

# Google OAuth client IDs used by SuperTokens sign-in. Two, because Google issues a
# separate client per platform and the iOS flow will not accept the web one.
EXPO_PUBLIC_SUPERTOKENS_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_SUPERTOKENS_GOOGLE_IOS_CLIENT_ID=

# Unsplash image host, for the survey/flow background pickers.
#   e.g. https://images.unsplash.com
EXPO_PUBLIC_UNSPLASH_IMAGES_URL=

# ── Not set here ──────────────────────────────────────────────────────────────
# Two more variables are read by `plugins/withSimulatorCodeSigning.js`, and both come
# from the build environment rather than this file:
#
#   EAS_BUILD           set automatically by EAS (cloud and `eas build --local`).
#   EXPO_APPLE_SIGNIN   set by hand to keep iOS code signing during a local prebuild:
#                       EXPO_APPLE_SIGNIN=true pnpm exec expo prebuild -p ios --clean
