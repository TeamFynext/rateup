# rateup-ui (apps/web) — copy to .env and fill in.
#
# Everything prefixed VITE_ is inlined into the client bundle at build time and
# is therefore PUBLIC. Never put a secret behind a VITE_ name — it ships to every
# visitor's browser. The last section is server-only and has no VITE_ prefix.
#
# Rules: URLs never end in a slash. `node scripts/env-rename.mjs --sort` puts an existing
# .env into the order below.

# ── URLs ─────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001        # the API (apps/api)
VITE_FRONTEND_URL=http://localhost:3000   # this app's own public URL

# ── CDN & images ─────────────────────────────────────────────────────────────
VITE_MEDIA_CDN_URL=                       # uploaded media; the API's MEDIA_CDN_URL
VITE_WEB_IMAGES_CDN_URL=                  # dashboard images; the API's WEB_IMAGES_CDN_URL
VITE_UNSPLASH_IMAGES_URL=                 # e.g. https://images.unsplash.com

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Cloudflare Turnstile site key (public). Sign-up and SMS codes then carry a CAPTCHA token.
# Deploy this before setting the API's TURNSTILE_SECRET_KEY. Unset = no CAPTCHA.
# Cloudflare's test site key 1x00000000000000000000AA always passes (pair it with the test secret).
VITE_TURNSTILE_SITE_KEY=

# ── Meta embedded signup ─────────────────────────────────────────────────────
# App id (the API's META_APP_ID) plus the per-flow configuration ids. Each config id maps
# to one signup variant (WhatsApp, WhatsApp + Instagram, + catalog, + ads, …); leave the
# variants you do not offer unset.
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
VITE_META_CONFIG_ID_ALL=
VITE_META_CONFIG_ID_WA_AD=
VITE_META_CONFIG_ID_WA_AD_CG=
VITE_META_CONFIG_ID_WA_AD_IG=
VITE_META_CONFIG_ID_WA_CG=
VITE_META_CONFIG_ID_WA_IG=
VITE_META_CONFIG_ID_WA_IG_CG=
VITE_META_USER_CONFIG_ID=
# Facebook Login for Business configs for connecting Messenger and Instagram on their own,
# without WhatsApp and without each other. One config each, asking only for that
# platform's permissions:
#   Messenger: pages_show_list, pages_messaging, pages_manage_metadata,
#              pages_read_engagement, business_management
#   Instagram: pages_show_list, pages_manage_metadata, pages_read_engagement, instagram_basic,
#              instagram_manage_messages, instagram_manage_comments, business_management
VITE_META_FACEBOOK_CONFIG_ID=
VITE_META_INSTAGRAM_CONFIG_ID=

# ── Payments ─────────────────────────────────────────────────────────────────
VITE_RAZORPAY_API_KEY=                    # publishable key only

# ── Support & tracking ───────────────────────────────────────────────────────
VITE_SUPPORT_WHATSAPP_NUMBER=             # support number shown in the UI
# The support widget's key (rk_…), from Settings › Integrations › Widget › Create widget key
VITE_SUPPORT_WIDGET_KEY=
VITE_FACEBOOK_PIXEL_ID=

# ── Dashboard ────────────────────────────────────────────────────────────────
# Comma-separated module keys to hide from the nav.
VITE_HIDDEN_MODULES=

# ── Server only (never VITE_) ────────────────────────────────────────────────
# Shared with the API's SSR_SHARED_SECRET (a long random string, the same in both).
# Lets the API rate-limit each visitor of a server-rendered storefront instead of
# this server's one address.
SSR_SHARED_SECRET=
# Proxy hops in front of this server to trust in X-Forwarded-For when telling the API who
# the visitor is. 1 = Railway's edge, which appends the address that connected to it, so a
# value the visitor wrote further left is ignored. Mirrors the API's TRUST_PROXY_HOPS
# (a whole number here).
# TRUST_PROXY_HOPS=1
# Uploads source maps during a production build (not part of the bundle); unset locally.
SENTRY_AUTH_TOKEN=
