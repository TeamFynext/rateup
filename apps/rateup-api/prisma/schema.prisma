// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  // can access all the team
  SUPER_ADMIN
  // can access only to the teams they are member of
  ADMIN
  //can access only team based survey responses, stats
  MEMBER
}

enum InviteStatus {
  // initial
  PENDING
  // accept invite
  ACCEPTED
  // decline invite
  DECLINED
}

enum InviteType {
  ORG
  TEAM
}

enum ResponsePlatform {
  WEB
  WHATSAPP
  APP
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  createdAt    DateTime     @default(now())
  email        String       @unique
  name         String?
  profilePhoto String?
  phone        String?
  gender       Gender?
  org          Org[]
  orgMember    OrgMember[]
  teamMember   TeamMember[]
  surveys      Survey[]
}

model Org {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt           DateTime     @default(now())
  name                String
  owner               User         @relation(fields: [ownerId], references: [id])
  ownerId             String       @db.Uuid
  whatsappAccessToken String?
  members             OrgMember[]
  teams               Team[]
  invitations         Invitation[]
}

model OrgMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id])
  orgId     String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
  role      Role

  @@unique([userId, orgId], name: "userId_orgId")
}

model Team {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime     @default(now())
  name        String
  code        String
  googleLink  String?
  org         Org          @relation(fields: [orgId], references: [id])
  orgId       String       @db.Uuid
  members     TeamMember[]
  surveys     Survey[]
  invitations Invitation[]

  Respondent Respondent[]
  RGroup     RGroup[]

  menu Menu[]

  @@unique([name, orgId], name: "team_name_org_id_unique")
  @@unique([code, orgId], name: "team_code_org_id_unique")
}

model TeamMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
}

model Invitation {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  name      String
  type      InviteType
  org       Org          @relation(fields: [orgId], references: [id])
  orgId     String       @db.Uuid
  team      Team?        @relation(fields: [teamId], references: [id])
  teamId    String?      @db.Uuid
  invitedBy String
  createdAt DateTime     @default(now())
  status    InviteStatus @default(PENDING)

  @@unique([email, teamId], name: "team_id_email_unique")
}

model Survey {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime?                     @updatedAt
  title                       String
  description                 String?                       @default("")
  questions                   Json[]                        @default([])
  languages                   String[]
  user                        User                          @relation(fields: [createdBy], references: [id])
  createdBy                   String                        @db.Uuid
  team                        Team                          @relation(fields: [teamId], references: [id])
  teamId                      String                        @db.Uuid
  active                      Boolean                       @default(true)
  responses                   SurveyResponse[]
  sessions                    WaSession[]
  isProtected                 Boolean                       @default(false)
  kioskMode                   Boolean                       @default(false)
  password                    String?
  surveyStats                 SurveyStats?
  type                        String                        @default("web")
  getLocation                 Boolean                       @default(false)
  welcomePageEnabled          Boolean                       @default(true)
  RespondentSurveySendHistory RespondentSurveySendHistory[]
  RGroupSurveySendHistory     RGroupSurveySendHistory[]
}

model SurveyLanding {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt
  title              String
  header             String    @default("")
  description        String?   @default("")
  surveys            String[]
  createdBy          String    @db.Uuid
  welcomePageEnabled Boolean   @default(true)
}

model SurveyResponse {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt           DateTime         @default(now())
  survey              Survey           @relation(fields: [surveyId], references: [id])
  surveyId            String           @db.Uuid
  responses           Json[]
  language            String           @default("")
  platform            ResponsePlatform @default(WEB)
  respondent          Respondent?      @relation(fields: [respondentId], references: [id])
  respondentId        String?          @db.Uuid
  locationCoordinates Json? // { latitude: string, longitude: string }
}

model SurveyStats {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  survey    Survey @relation(fields: [surveyId], references: [id])
  surveyId  String @unique @db.Uuid
  visited   Int    @default(0)
  started   Int    @default(0)
  completed Int    @default(0)
}

// Whatsapp session
model WaSession {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt         DateTime @default(now())
  phone             String   @unique
  survey            Survey   @relation(fields: [surveyId], references: [id])
  surveyId          String   @db.Uuid
  currentQuestionId String?
  responses         Json[]
  language          String   @default("")
}

// TODO: Add relation to team or org
model Respondent {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                   DateTime                      @default(now())
  name                        String?
  phone                       String
  email                       String?
  team                        Team                          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId                      String                        @db.Uuid
  responses                   SurveyResponse[]
  rgroups                     RespondentGroupRelation[]
  RespondentSurveySendHistory RespondentSurveySendHistory[]

  @@unique([phone, teamId], name: "respondent_phone_team_id_unique")
}

// Respondent groups to send surveys to
model RGroup {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt               DateTime                  @default(now())
  name                    String
  respondents             RespondentGroupRelation[]
  RGroupSurveySendHistory RGroupSurveySendHistory[]
  team                    Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId                  String                    @db.Uuid

  @@unique([name, teamId], name: "group_name_team_id_unique")
}

model RespondentGroupRelation {
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  respondentId String     @db.Uuid
  rgroup       RGroup     @relation(fields: [rgroupId], references: [id], onDelete: Cascade)
  rgroupId     String     @db.Uuid

  @@id([respondentId, rgroupId])
}

// survey "send" history
// records when a survey was sent to a respondent
model RespondentSurveySendHistory {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  survey       Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  surveyId     String     @db.Uuid
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  respondentId String     @db.Uuid
  createdAt    DateTime   @default(now())
}

model RGroupSurveySendHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rgroup    RGroup   @relation(fields: [rgroupId], references: [id], onDelete: Cascade)
  rgroupId  String   @db.Uuid
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  surveyId  String   @db.Uuid
  createdAt DateTime @default(now())
}

//----------welcome page styles-----------
model WelcomeTheme {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt
  landingId    String?   @db.Uuid
  surveyId     String?   @db.Uuid
  headerText   String    @default("")
  descText     String    @default("")
  buttonText   String    @default("")
  headerStyles Json
  descStyles   Json
  buttonStyles Json
  bgStyles     Json
  logoStyles   Json
  logoUrl      String?
  bgUrl        String?
  bgType       String?   @default("bgcolor")
}

model Menu {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime @default(now())
  name         String // name of the menu
  displayName  String // name displayed to clients (eg: Restaurant's Name)
  locationText String? // location of the restaurant
  locationUrl  String? // google maps url
  websiteUrl   String? // website url
  websiteText  String? // text to display for website url
  logo         String? // logo url

  categories MenuCategory[]
  // add a relation to team
  team       Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId     String         @db.Uuid
}

model MenuCategory {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime   @default(now())
  name      String
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId    String     @db.Uuid
  items     MenuItem[]
  image     String?
}

model MenuItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime @default(now())
  name        String
  description String
  images      String[]
  videoUrl    String?
  // Since items might have different variants, we store price as a json.
  // The json will have the following structure:
  // {
  //   "price": 100,    |  if there are no variants this is the price
  //   "variants": [
  //     {
  //       "name": "small",
  //       "price": 100
  //     }
  //   ]
  // }

  price      Json
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String       @db.Uuid
}

//homepage contact form
model ContactForm {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  name      String
  email     String
  message   String
}
