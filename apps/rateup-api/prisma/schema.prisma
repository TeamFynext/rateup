  active                        Boolean                    @default(true)
  description                   String?
  message                       Json?
  action_id                     String?
  rewardId                      String?                    @db.Uuid
  reward                        LoyaltyReward?             @relation("referrer_reward", fields: [rewardId], references: [id], onDelete: Cascade)
  refereeRewardId               String?                    @db.Uuid
  refereeReward                 LoyaltyReward?             @relation("referee_reward", fields: [refereeRewardId], references: [id], onDelete: Cascade)
