// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// for having typed Json fields
// TODO: remove this when prisma allows types for Json
generator json {
  provider  = "prisma-json-types-generator"
  namespace = "PrismaJson"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  // can access all the team
  // can access only to the teams they are member of
  SUPER_ADMIN
  ADMIN
  //can access only team based survey responses, stats
  MEMBER
}

enum TeamFeature {
  inbox
  analytics
  contacts
  campaigns
  flows
  chatbots
  templates
  automation
  loyalty
  web_forms
  /// RETIRED: the ticket boards this gated were removed, along with every Ticket*
  /// table. The value is kept because teams in production still carry it in
  /// TeamFeatureAccess; dropping it would rewrite the enum and fail on those rows.
  tickets
  pipeline
  qr_studio
  ai_chatbot
  apps_services
  settings
}

enum InviteStatus {
  // initial
  PENDING
  // accept invite
  ACCEPTED
  // decline invite
  DECLINED
}

enum InviteType {
  ORG
  TEAM
}

enum ResponsePlatform {
  WEB
  WHATSAPP
  APP
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserRecipes {
  EmailPassword
  ThirdPartyGoogle
  PasswordLess
  ThirdPartyApple
}

enum TemplateType {
  GENERAL_NOTIFICATION
  ORDER_DETAILS
  PAYMENT_CONFIRMATION
  LOYALTY
  CAROUSEL
}

enum ContactGroupType {
  NORMAL
  LOYALTY
}

enum UserPresenceMode {
  automatic
  manual
}

enum CustomerRewardStatus {
  ISSUED
  REDEEMED
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  createdAt      DateTime         @default(now())
  email          String           @unique
  name           String?
  profilePhoto   String?
  phone          String?
  active         Boolean          @default(true)
  gender         Gender?
  recipeName     UserRecipes?
  isPaused       Boolean?         @default(false)
  pausedBy       String?
  /// The UI language this account prefers, as an ISO code ("en", "ar", …).
  prefLanguage   String?          @default("en")
  deletedAt      DateTime?
  lastLoggedInAt DateTime?
  presenceMode   UserPresenceMode @default(automatic)

  org                         Org[]
  orgMember                   OrgMember[]
  teamMember                  TeamMember[]
  surveys                     Survey[]
  Order                       Order[]
  linktree                    Linktree[]
  generateQr                  GenerateQr[]
  WaMessage                   WaMessage[]
  waInboxAssign               WaInboxAssign[]
  expoPushTokens              ExpoPushToken[]
  // Add relation for WaAutomatedReply many-to-many
  UserAssignedCount           UserAssignedCount[]
  AuditLog                    AuditLog[]
  LastClosedContacts          Contact[]
  ClosedConversations         Conversation[]
  AssignedConversations       ConversationAssignedUserTeamMap[] @relation("ConversationAssignedUser")
  removedAssignees            ConversationAssignedUserTeamMap[] @relation("ConversationRemovedUser")
  assignedStafftoConversation ConversationAssignedUserTeamMap[] @relation("ConversationAssignedByUser")
  inboxMentions               InboxMention[]
  inboxNotes                  InboxNote[]                       @relation("InboxNoteAuthor")
  deletedInboxNotes           InboxNote[]                       @relation("InboxNoteDeletedBy")
  assignedLeads               LeadAssignee[]                    @relation("LeadAssignee")
  ownedLeads                  Lead[]                            @relation("LeadOwner")
  closedLeads                 Lead[]                            @relation("LeadClosedBy")
  leadNotes                   LeadNote[]
  leadActivities              LeadActivity[]
  leadTasks                   LeadTask[]
}

model Org {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                DateTime @default(now())
  name                     String
  owner                    User     @relation(fields: [ownerId], references: [id])
  ownerId                  String   @db.Uuid
  logo                     String?
  phone                    String?
  address                  String?
  encryptionKeys           Json? //{privateKey:string,publicKey:string}
  isPaused                 Boolean? @default(false)
  waAssignedChatPermission String   @default("All")

  onboarding          Json?
  onboardingCompleted Boolean @default(false)

  showLifecycle Boolean @default(true)

  isConversionApiActive        Boolean @default(false)
  onboardingChecklist          Json?
  onboardingChecklistCompleted Boolean @default(false)

  deletionMailSent DateTime?
  addons           SubscriptionAddon[]

  members                 OrgMember[]
  teams                   Team[]
  invitations             Invitation[]
  templates               WaTemplate[]
  Subscription            Subscription?
  Order                   Order[]
  WaFlow                  WaFlow[]
  contacts                Contact[]
  linktree                Linktree[]
  ApiAccessToken          ApiAccessToken?
  externalIdempotency     ExternalIdempotencyRecord[]
  surveyThemes            WebSurveyTheme[]
  UsageStats              UsageStats?
  meteredConversations    MeteredConversation[]
  chatbot                 Chatbot[]
  Survey                  Survey[]
  WaAccountSettings       WaAccountSettings?
  generateQr              GenerateQr[]
  Integration             Integration[]
  waMessageSchedule       WaMessageSchedule[]
  loyaltyProgram          LoyaltyProgram?
  loyaltyTemplates        LoyaltyWaCommand[]
  WaAutomatedReplyMessage WaAutomatedReplyMessage[]
  WaAutomatedReply        WaAutomatedReply[]
  whatsappQuickReplies    WhatsappQuickReply[]
  loyaltyApiSettings      LoyaltyApiSettings[]
  expoPushTokens          ExpoPushToken[]
  WhatsappSettings        WhatsappSettings[]
  metaBusinessAgents      MetaBusinessAgent[]
  WaCatalog               WhatsappCatalog[]
  productSets             WhatsappProductSet[]
  UserAssignedCount       UserAssignedCount[]
  Lifecycle               Lifecycle[]
  ContactCustomField      ContactCustomField[]
  AuditLog                AuditLog[]
  ContactLabel            ContactLabel[]
  businessHours           BusinessHour[]
  rules                   Rule[]
  shopifyCheckouts        ShopifyCheckout[]
  ruleMessageBodyLocks    RuleMessageBodyLock[]
  waMessageOrgTeamMaps    WaMessageOrgTeamMap[]
  Webhook                 Webhook?
  inboxAutomations        InboxAutomation[]
  inboxStats              InboxStats?
  inboxMentions           InboxMention[]
  inboxNotes              InboxNote[]
  conversationTags        ConversationTag[]
  pipelines               Pipeline[]

  /// Suspended by RateUp staff (src/modules/staff). Deliberately NOT `isPaused`: the
  /// customer's own admin and a Shopify uninstall both set that one, so reusing it would
  /// let a customer lift their own suspension — and would leave staff unable to tell the
  /// two apart. Null means not suspended.
  suspendedAt        DateTime?
  /// Why, in staff's words. Not shown to the customer; the audit row carries it too.
  suspendedReason    String?
  /// The StaffUser who suspended. No FK: a staff member can be deleted, the record stays.
  suspendedByStaffId String?   @db.Uuid
  staffNotes         OrgNote[]

  @@index([suspendedAt])
}

/// A note staff keep on an org: context for whoever picks the account up next.
/// Never shown to the customer.
model OrgNote {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String    @db.Uuid
  /// No FK to StaffUser: the note survives the author being removed from the allowlist.
  staffUserId String?   @db.Uuid
  /// Kept beside the id so an old note still says who wrote it.
  staffEmail  String
  body        String
  /// Pinned notes show on the org's Overview tab.
  pinned      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete: a note staff removed stays readable in the audit trail.
  deletedAt   DateTime?

  @@index([orgId, pinned, createdAt])
}

model UsageStats {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String   @unique @db.Uuid

  teamsCount              Int @default(0)
  teamMembersCount        Int @default(0)
  surveysCount            Int @default(0)
  surveyResponsesCount    Int @default(0)
  waSurveysCount          Int @default(0)
  waSurveyResponsesCount  Int @default(0)
  messagesCount           Int @default(0)
  aiPromptTokensCount     Int @default(0)
  aiCompletionTokensCount Int @default(0)
  loyaltyActionCount      Int @default(0)
  loyaltyRewardCount      Int @default(0)
  loyaltyCustomerCount    Int @default(0)
  waAutomationCount       Int @default(0)

  annualConversationsCount  Int @default(0)
  monthlySurveyResponses    Int @default(0)
  monthlyWaSurveyResponses  Int @default(0)
  monthlyConversationsCount Int @default(0)

  /// Metered 24h conversation windows — the plan allowance unit (see
  /// MeteredConversation). Distinct from monthly/annualConversationsCount, which
  /// count inbox tickets and remain for inbox analytics only.
  monthlyMeteredConversationsCount Int @default(0)
  annualMeteredConversationsCount  Int @default(0)

  /// Set the first time the org trips its conversation allowance in the current
  /// cycle, so the limit notification fires once rather than on every subsequent
  /// over-limit message. Cleared by resetMonthlyCounts/resetAnnualCounts.
  conversationLimitNotifiedAt DateTime?

  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?

  allowedTeams           Int @default(0)
  allowedTeamMembers     Int @default(0)
  allowedSurveys         Int @default(0)
  allowedSurveyResponses Int @default(0)
  allowedMessagesCount   Int @default(0)

  annualTemplateMessageCount  Int @default(0)
  monthlyTemplateMessageCount Int @default(0)
  templateMessagesCount       Int @default(0)

  monthlyAutomationTriggerCount Int @default(0)

  lastMonthlyResettedDate DateTime? @db.Date()
}

enum StageCategory {
  active
  won
  lost
}

model Lifecycle {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  ordering    Int           @default(0)
  isDefault   Boolean       @default(false)
  category    StageCategory
  emoji       String
  description String
  isWon       Boolean       @default(false)
  color       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]

  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String? @db.Uuid
}

model WhatsappSettings {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String @db.Uuid

  accessToken              String // encrypted
  accessToken_iv           String?
  wabaId                   String? // WhatsApp Business Account ID
  phoneId                  String? @unique
  phone                    String? @unique
  appId                    String
  webhookPassword          String?
  fbPageId                 String? @unique //Facebook Page ID
  ibaId                    String? @unique //Instagram Business Account ID
  pageAccessToken          String? //Facebook Page access token
  igUserName               String?
  igDisplayName            String?
  /// [PInstagramIceBreakers]
  instagramIceBreakers     Json?
  /// [PInstagramPersistentMenu]
  instagramPersistentMenu  Json?
  conversationalAutomation Json?
  phoneDisplayName         String?
  /// Meta's per-second send ceiling for this number, when it differs from the
  /// platform default (80/s). NULL means "use the default". Read by the campaign
  /// dispatcher's per-phone rate limiter; see workers/shared/phoneRateLimit.ts.
  messagesPerSecond        Int?

  fbUserName String?

  type                    String // enums.ts: WaConfigType
  status                  String                @default("ACTIVE")
  createdAt               DateTime              @default(now())
  /// [PWaEncryptionKeys]
  encryption              Json? // for flow {publicKey: string, privateKey: string}
  WaTemplate              WaTemplate[]
  LoyaltyWaCommand        LoyaltyWaCommand[]
  metaAssets              MetaAssets[]
  catalog                 CatalogPhoneIdMap?
  assets                  String[]              @default([]) //enum.ts MetaLoginAssets (assets selected on login)
  conversionsApiDatasetId String?
  /// [PMetaConversionSettings]
  conversionData          Json?
  paymentMethod           String                @default("NATIVE") // NATIVE, SHOPIFY_LINK
  metaBusinessAgent       MetaBusinessAgent?
  teamAccess              TeamWhatsappChannel[] // teams explicitly granted this channel
  waFlows                 WaFlow[] // flows created under this channel's WABA
}

model MetaBusinessAgent {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String @db.Uuid

  whatsappSettings   WhatsappSettings @relation(fields: [whatsappSettingsId], references: [id], onDelete: Cascade)
  whatsappSettingsId String           @unique @db.Uuid

  agentId              String? // Meta-assigned agent id, returned by agent_onboarding
  channel              String    @default("whatsapp")
  isEligible           Boolean?
  eligibilityCheckedAt DateTime?
  status               String    @default("NOT_ONBOARDED") // NOT_ONBOARDED, ONBOARDED, DISABLED

  // agent_config/settings, cached locally, pushed to Meta on save
  rolloutEnabled          Boolean?
  handoffEnabled          Boolean?
  handoffMessage          String?
  handoffMessageSelection String? // DEFAULT, AGENT, CUSTOM
  followupEnabled         Boolean?
  followupIntervalSeconds Int?
  followupMessage         String?
  aiAudience              String? // EVERYONE, ALLOWLISTED_ONLY
  neverSayPhrases         String[]  @default([])
  settingsSyncedAt        DateTime?

  /// Local only, never sent to Meta: when a ticket is closed or resolved while
  /// staff hold the thread, hand it back to the agent. Without it, Meta AI stays
  /// silent for that customer until someone releases the thread by hand.
  releaseOnTicketClose    Boolean   @default(true)

  /// The Business Manager that owns the agent. Only agent_budget is addressed by
  /// it (every other agent endpoint takes the phone number id), so it is looked
  /// up from the WABA the first time a budget is read or saved.
  businessManagerId       String?
  // agent_budget, cached locally, replaced wholesale at Meta on save
  /// [PMetaAgentBudgets]
  budgets                 Json?
  budgetsSyncedAt         DateTime?

  /// bcrypt hash of the key the built-in RateUp connector sends. Meta holds the
  /// key itself; a reinstall rotates it.
  rateupToolsKeyHash      String?

  // agent_config/business_info, cached locally
  /// [PMetaAgentBusinessInfo]
  businessInfo         Json?
  businessInfoSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allowlist  MetaAgentAllowlistEntry[]
  faqs       MetaAgentFaq[]
  files      MetaAgentFile[]
  websites   MetaAgentWebsite[]
  skills     MetaAgentSkill[]
  uiSkills   MetaAgentUiSkill[]
  connectors MetaAgentConnector[]
}

model MetaAgentAllowlistEntry {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent   MetaBusinessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String            @db.Uuid

  metaId              String? // id returned by Meta, null until synced
  consumerPhoneNumber String

  createdAt DateTime @default(now())
}

model MetaAgentFaq {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent   MetaBusinessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String            @db.Uuid

  metaId   String?
  question String
  answer   String
  /// [PMetaAgentFaqMetadata]
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MetaAgentFile {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent   MetaBusinessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String            @db.Uuid

  metaId   String?
  fileName String

  createdAt DateTime @default(now())
}

model MetaAgentWebsite {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent   MetaBusinessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String            @db.Uuid

  metaId        String?
  url           String
  crawlStatus   String?
  /// Meta's readable reason when crawlStatus is failed; empty otherwise.
  crawlError    String?
  pagesCrawled  Int?
  lastCrawledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MetaAgentSkill {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent   MetaBusinessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String            @db.Uuid

  metaId      String?
  title       String
  description String
  skill       String
  channel     String? // channel Meta filed the skill under, returned on read
  /// Meta's content review: active, pending_review or blocked. A blocked skill
  /// is stored but never applied.
  status      String?
  /// [PMetaAgentSkillMetadata]
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// agent-ui-skills — the rich WhatsApp components (carousels, CTAs, flows) the
/// agent is allowed to send. A separate Meta endpoint from `agent_config/skills`.
model MetaAgentUiSkill {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent   MetaBusinessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String            @db.Uuid

  metaId        String?
  title         String
  componentType String // carousel_quick_reply, carousel_url, cta_url, flow, image, interactive_list, location, location_request
  status        String  @default("enabled") // enabled, disabled
  instruction   String
  // Meta types this as an integer, but flow ids run to 16 digits — kept as text
  // so nothing rounds on the way through, and parsed at the Meta boundary.
  flowId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MetaAgentConnector {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent   MetaBusinessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String            @db.Uuid

  metaId              String?
  name                String
  description         String
  baseUrl             String
  authType            String  @default("NONE") // OAUTH2_CLIENT_CREDENTIALS, OAUTH2, API_KEY, BASIC, CUSTOM, NONE
  requiresCertificate Boolean @default(false)
  connectionStatus    String  @default("PENDING_OAUTH") // PENDING_OAUTH, ACTIVE, EXPIRED, ERROR
  // Meta returns connection_status as an object; the failure reason rides along
  // with the status and is the only thing that explains an ERROR to the user.
  connectionError     String?
  /// Set on the connector RateUp installs for itself ("rateup"); its key and
  /// tools are managed by RateUp, not edited by hand.
  builtIn             String?

  /// [PMetaAgentUserAuthInjectionConfig]
  userAuthInjectionConfig Json?
  /// Non-secret mTLS metadata Meta echoes back (fingerprint, subject, expiry).
  /// [PMetaAgentMtlsConfig]
  mtlsConfig              Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tools MetaAgentConnectorTool[]
}

model MetaAgentConnectorTool {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connector   MetaAgentConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  connectorId String             @db.Uuid

  metaId               String?
  name                 String
  description          String
  /// [PMetaAgentRequestDefinition]
  requestDefinition    Json
  userAuthRequired     Boolean @default(false)
  /// How to pull tokens out of an auth/refresh call's response.
  /// [PMetaAgentUserAuthActionConfig]
  userAuthActionConfig Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rule {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id])
  orgId String @db.Uuid

  name                     String
  platform                 RulePlatform @default(WHATSAPP)
  operator                 RuleOperator @default(AND) // AND / OR
  isActive                 Boolean      @default(true)
  triggerEvent             TriggerEvent
  whatsappSettingsPhoneIds String[]     @default([]) //for multiple whatsapp integration
  /// [PWaRuleOptions]
  options                  Json? // Stores sendOncePerDay and businessHours configuration

  groups  RuleConditionGroup[]
  actions RuleAction[]

  shopifyCheckoutReminders ShopifyCheckoutReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, orgId], name: "rule_name_org_id_unique")
}

/// A Shopify checkout, kept from its checkouts/create and checkouts/update webhooks so an
/// abandoned one can be reminded about. Carries customer data: expired rows are deleted by
/// the daily cleanup, and customers/redact and shop/redact delete them on request.
model ShopifyCheckout {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String                    @db.Uuid
  org              Org                       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The myshopify domain; shop/redact arrives after uninstall, when only this names the rows.
  shop             String
  /// The REST checkout id from the webhook.
  shopifyId        String
  /// Matches `checkout_token` on the order the checkout turns into.
  token            String
  /// E.164, parsed once on arrival; null when the buyer gave no usable number.
  phone            String?
  email            String?
  acceptsMarketing Boolean                   @default(false)
  /// The webhook payload, which is the snake_case shape rule variables are mapped against.
  body             Json
  /// `gid://shopify/Product/…`, the form rule product filters store.
  productIds       String[]                  @default([])
  shopifyUpdatedAt DateTime
  status           ShopifyCheckoutStatus     @default(OPEN)
  recoveredOrderId String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  reminders        ShopifyCheckoutReminder[]

  @@unique([orgId, shopifyId])
  @@index([orgId, token])
  @@index([shop])
  @@index([status, shopifyUpdatedAt])
}

enum ShopifyCheckoutStatus {
  OPEN
  RECOVERED
  EXPIRED
}

/// One abandoned-checkout rule's reminder for one checkout. The row is the send's claim:
/// the delayed job only decides when it is looked at.
model ShopifyCheckoutReminder {
  id         String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkoutId String                        @db.Uuid
  checkout   ShopifyCheckout               @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  ruleId     String                        @db.Uuid
  rule       Rule                          @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dueAt      DateTime
  status     ShopifyCheckoutReminderStatus @default(SCHEDULED)
  /// Why a reminder was skipped or failed.
  reason     String?
  sentAt     DateTime?
  /// The code in the reminder's tracked recovery link, /api/public/r/<linkCode>.
  linkCode          String                        @unique
  /// The WhatsApp message id (wamid) the send returned; WaMessage.messageId holds the same.
  waMessageId       String?
  clickedAt         DateTime?
  clickCount        Int                           @default(0)
  /// The order this reminder recovered: the last one sent before that order was placed.
  attributedOrderId String?
  attributedAt      DateTime?
  /// The order total in the shop's own currency.
  revenue           Decimal?                      @db.Decimal(12, 2)
  currency          String?
  createdAt  DateTime                      @default(now())
  updatedAt  DateTime                      @updatedAt

  @@unique([checkoutId, ruleId])
  @@index([status, dueAt])
  @@index([ruleId, sentAt])
}

enum ShopifyCheckoutReminderStatus {
  SCHEDULED
  SENDING
  SENT
  SKIPPED
  FAILED
  CANCELLED
}

enum RulePlatform {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
}

enum RuleOperator {
  AND
  OR
}

model RuleConditionGroup {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rule   Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId String @db.Uuid

  operator   RuleOperator    @default(AND)
  conditions RuleCondition[]
}

model RuleCondition {
  id      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group   RuleConditionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String             @db.Uuid

  field           ConditionField
  operator        ConditionOperator
  value           String? // 'order', '@gmail.com', 'yes', etc.
  messageBodyLock RuleMessageBodyLock?
}

enum ConditionField {
  MESSAGE_BODY
  CONTACT_EMAIL
  // ELAPSED_TIME
  CONTACT_GROUP
  CONTACT_LABEL
  CONTACT_LIFECYCLE
  /// The board column the contact's lead sits in. Replaces CONTACT_LIFECYCLE;
  /// both exist while rules written against the old one are still running.
  CONTACT_STAGE
}

enum ConditionOperator {
  CONTAINS
  EQUALS
  STARTS_WITH
  ENDS_WITH
}
// abhinav/integrations didnt run migration
enum TriggerEvent {
  MESSAGE_RECEIVED
  CHAT_CLOSED
  CHAT_ASSIGNED
  CONTACT_CREATED
  LIFECYCLE_UPDATED
  /// A lead moved to a different board column. Replaces LIFECYCLE_UPDATED; both
  /// exist while rules written against the old one are still running.
  STAGE_UPDATED
  SHOPIFY_EVENT
  /// A WooCommerce order reached a status (processing, completed, …); see woocommerce.orders.ts.
  WOOCOMMERCE_EVENT
  INSTAGRAM_COMMENT
  INSTAGRAM_STORY_MENTION
}

model RuleAction {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rule   Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId String @db.Uuid

  type  ActionType
  value Json? // userId, labelId, message text, templateId, etc.
}

enum ActionType {
  CLOSE_TICKET
  ATTACH_LABEL
  ASSIGN_USER
  ASSIGN_TEAM
  ASSIGN_LIFECYCLE
  /// Move the contact's lead to a pipeline column. Replaces ASSIGN_LIFECYCLE;
