/// A self-derived, fixed 24-hour conversation window — the unit metered against a
/// plan's monthly conversation allowance.
///
/// Deliberately NOT keyed on Meta's `conversation.id`: under per-message pricing
/// Meta no longer sends a `conversation` object at all (status webhooks carry only
/// `pricing`), and inbound `messages[]` webhooks never carried one. Rateup owns the
/// clock instead: a window opens on the first message in either direction, spans a
/// fixed 24h from that message, and absorbs every later message until it expires.
/// That makes it self-closing, unlike the inbox `Conversation` ticket, which stays
/// open until an agent or an automation closes it.
model MeteredConversation {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String       @db.Uuid
  org           Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  platform      PlatformType
  /// The business-side channel identity (`sourceIdentifier`). Empty string, never
  /// NULL: Postgres treats NULLs as distinct in a unique constraint, which would
  /// silently defeat the dedupe this table exists for.
  channelId     String
  /// The customer-side identity — wa_id / igsId / psid, i.e. `from`.
  customerId    String
  contactId     String?      @db.Uuid
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  openedAt      DateTime
  expiresAt     DateTime
  lastMessageAt DateTime
  messageCount  Int          @default(0)
  inboundCount  Int          @default(0)
  outboundCount Int          @default(0)

  /// Meta pricing annotations, promoted from status webhooks. Analytics only.
  category     WaConversationCategory?
  pricingModel WaPricingModel?
  billable     Boolean                 @default(false)
  pricingType  String?

  createdAt DateTime    @default(now())
  messages  WaMessage[]

  @@unique([orgId, platform, channelId, customerId, openedAt])
  // Serves the find-open-window probe in recordMessageInWindow.
  @@index([orgId, platform, channelId, customerId, expiresAt])
  @@index([orgId, openedAt])
}

model WaMessage {
  id                              String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                       DateTime                          @default(now())
  waCreatedAt                     DateTime?
  /// [PWaMessageBody]
  messageBody                     Json
  /// [PWaTemplateComponentParams]
  templateComponentParams         Json?
  contact                         Contact?                          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId                       String?                           @db.Uuid
  messageId                       String?
  stats                           Json?                             @default("{\"failed\": \"\",\"sent\": \"\",\"delivered\": \"\" ,\"read\": \"\"}")
  WaMessageCampaginParticipantMap WaMessageCampaginParticipantMap[]
  sendBy                          String?                           @db.Uuid
  sender                          User?                             @relation(fields: [sendBy], references: [id], onDelete: Cascade)
  errorMessage                    String?
  readUsers                       String[]                          @default([])
  sourcePlatform                  PlatformType?
  sourceIdentifier                String?
  conversationId                  String?                           @db.Uuid
  Conversation                    Conversation?                     @relation(fields: [conversationId], references: [id])
  waMessageOrgTeamMaps            WaMessageOrgTeamMap[]
  /// [PWaGraphApiErrorDetail]
  logs                            Json?
  /// Meta Graph error code for a failed send, lifted out of `logs` so retry
  /// eligibility and the failure-reason breakdown are indexable queries rather
  /// than jsonb path scans.
  errorCode                       Int?
  /// Source of the message (e.g., api, inbox, campaign, automation)
  sourceMessage                   String?
  /// Set when the sender revoked (deleted) the message on WhatsApp. The body is
  /// deliberately kept — the thread renders the message as deleted rather than
  /// losing what was said.
  deletedAt                       DateTime?
  /// The metered 24h billing window this message was attributed to when it was
  /// written (see MeteredConversation). Statuses annotate *this* window, never
  /// whichever window happens to be open when the status is processed.
  meteredConversationId           String?                           @db.Uuid
  meteredConversation             MeteredConversation?              @relation(fields: [meteredConversationId], references: [id])
  /// Raw Meta pricing signals off the status webhook. Stored for analytics and
  /// support only — they never gate metering or enforcement. Meta bills the
  /// customer's WABA directly; Rateup bears no per-message cost.
  pricingCategory                 WaConversationCategory?
  pricingModel                    WaPricingModel?
  pricingBillable                 Boolean?
  pricingType                     String?

  @@index([contactId, waCreatedAt(sort: Desc)])
  @@index([contactId])
  @@index([sourceIdentifier, contactId])
  @@index([sendBy, waCreatedAt])
  @@index([conversationId])
  // Speeds the conversation backfill scan: EXISTS(WaMessage WHERE contactId = c.id
  // AND conversationId IS NULL) can be answered from this index alone.
  @@index([contactId, conversationId])
  // Status writes match on the Meta message id (`WHERE wm."messageId" = ANY(...)`)
  // in bulkUpdateStatuses; without this the batch degrades to a seq scan.
  @@index([messageId])
  // Unused by reads, but deleting an org cascades to MeteredConversation, and each
  // deleted row's foreign-key check would otherwise scan all of WaMessage.
  @@index([meteredConversationId])
}

model WaMessageCampaginParticipantMap {
  campaignParticipant            CampaignParticipant           @relation(fields: [campaignParticipantId], references: [id], onDelete: Cascade)
  campaignParticipantId          String                        @db.Uuid
  waMessage                      WaMessage                     @relation(fields: [waMessageId], references: [id], onDelete: Cascade)
  waMessageId                    String                        @unique @db.Uuid
  CampaignParticipantDripStage   CampaignParticipantDripStage? @relation(fields: [campaignParticipantDripStageId], references: [id])
  campaignParticipantDripStageId String?                       @db.Uuid
  /// The send session this message belongs to. This table already has exactly
  /// one row per WaMessage and is already joined by the status consumer, so it
  /// is the cheapest attribution point for per-attempt analytics.
  campaignSend                   CampaignSend?                 @relation(fields: [campaignSendId], references: [id], onDelete: SetNull)
  campaignSendId                 String?                       @db.Uuid

  /// Every "what was this participant's latest message" lookup filters on this —
  /// the analytics failure breakdown and the retry cohort both do it once per
  /// failed participant. Without the index each of those is a sequential scan of
  /// the whole table.
  @@index([campaignParticipantId])
  @@index([campaignSendId])
}

