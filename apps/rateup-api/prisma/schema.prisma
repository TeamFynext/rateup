  dailySendLimit Int?

  team                 Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId               String                @db.Uuid
  waTemplate           WaTemplate?           @relation(fields: [waTemplateId], references: [id], onDelete: Cascade)
  waTemplateId         String?               @db.Uuid
  flowId               String?
  // TODO: add email template?
  campaignParticipants CampaignParticipant[]
  campaignSentAt       DateTime?
  scheduledStatuses    String[]              @default([])
  errorMessage         String?
  /// Why the platform stopped this campaign on its own — enums.ts:
  /// CampaignPauseReason. Only meaningful while `status` is PAUSED; the banner
  /// on the campaign page is keyed on the pair, so a stale value is harmless.
  pauseReason          String?
  pausedAt             DateTime?
  dynamicTags          String[]              @default([])
  useUserConsent       Boolean               @default(true)
  /// IANA zone the schedule is expressed in. A campaign scheduled for "10:00" is
  /// scheduled for 10:00 *somewhere*, and the person who set it is rarely in the
  /// same place as the server or the next person to open the campaign.
  timezone             String                @default("Etc/UTC")
