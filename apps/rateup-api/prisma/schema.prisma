model CampaignDripStage {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delay      Int
  delayUnit  String // "days", "hours", etc.
  sendAtTime String? // "16:00" for 4 PM, format: "HH:mm"

  totalRead      Int @default(0)
  totalSend      Int @default(0)
  totalCompleted Int @default(0)
  totalDelivered Int @default(0)
  totalFailed    Int @default(0)

  campaignId String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  waTemplateId String     @db.Uuid
  waTemplate   WaTemplate @relation(fields: [waTemplateId], references: [id], onDelete: Cascade)

  CampaignParticipantDripStage CampaignParticipantDripStage[]
}

model CampaignParticipantDripStage {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime  @default(now())
  scheduledAt  DateTime?
  sentAt       DateTime?
  status       String    @default("PENDING") // "PENDING" | "SENT" | "FAILED"
  errorMessage String?

  participant   CampaignParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String              @db.Uuid

  dripStage                       CampaignDripStage                 @relation(fields: [dripStageId], references: [id], onDelete: Cascade)
  dripStageId                     String                            @db.Uuid
  WaMessageCampaginParticipantMap WaMessageCampaginParticipantMap[]

  @@unique([participantId, dripStageId], name: "participant_stage_unique")
}

/// One send or resend of a campaign. Every outbound message belongs to exactly
/// one, so "this retry re-attempted 340 and 210 landed" is a query, not a guess.
///
/// Scheduling for automatic retries lives here rather than as multi-day BullMQ
/// delayed jobs: a row in SCHEDULED is the source of truth, so cancelling is a
/// DB update, the schedule survives a Redis flush, and the UI can render the
/// next attempt without scanning a queue.
model CampaignSend {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String   @db.Uuid

  /// 0 = the initial send. 1..n = automatic retries.
  attemptNo Int                 @default(0)
  trigger   CampaignSendTrigger
  status    CampaignSendStatus  @default(SCHEDULED)

  /// Participant statuses this send targeted, e.g. ["PENDING"] or ["FAILED"].
  targetStatuses String[] @default([])
  dripStageId    String?  @db.Uuid

  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  /// Recipients this send fanned out to, decided at fire time.
  totalTargeted Int @default(0)
  /// Recipients dropped because the conversation allowance ran out.
  totalSkipped  Int @default(0)

  totalSent      Int @default(0)
  totalDelivered Int @default(0)
  totalRead      Int @default(0)
  totalFailed    Int @default(0)
  totalCompleted Int @default(0)

  /// Why this attempt exists, or why it was cancelled/skipped.
  note String?

  messages WaMessageCampaginParticipantMap[]

  @@unique([campaignId, attemptNo])
  @@index([status, scheduledFor])
  @@index([campaignId])
}

enum CampaignSendTrigger {
  MANUAL
  SCHEDULED
  AUTO_RETRY
  DRIP
}

enum CampaignSendStatus {
  SCHEDULED
  QUEUING
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}

/// Retry behaviour for a campaign's failed messages. 1:1 with the campaign;
/// an absent row means retries are off.
model CampaignRetryPolicy {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String   @unique @db.Uuid

  enabled       Boolean               @default(false)
  strategy      CampaignRetryStrategy @default(SMART)
