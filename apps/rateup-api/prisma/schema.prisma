model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  name   String?
  phone  String?
  source String?

  org                          Org                       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId                        String                    @db.Uuid
  responses                    SurveyResponse[]
  contactGroups                ContactGroupMap[]
  campaignParticipants         CampaignParticipant[]
  tags                         Json?
  /// [PContactIntegrationIds]
  integrationIds               Json?
  WaMessage                    WaMessage[]
  consent                      Boolean                   @default(true)
  email                        String?
  dob                          DateTime?
  external_id                  String?
  aiWaChat                     Boolean                   @default(false)
  isAiBotActive                Boolean                   @default(false)
  chatbotId                    String                    @default("")
  waMessageAssignStatus        InboxStatus               @default(UNASSIGNED)
  waInboxAssign                WaInboxAssign[]
  lastReceivedMessageTimeStamp DateTime?
  whatsappUserName             String? //whatsapp or instagram username
  blockedOnWhatsApp            Boolean                   @default(false)
  /// Spam lives on the *contact*, not on a conversation: marking someone spam is a
  /// statement about the person, so it survives their tickets. A spam contact is
  /// hidden from every other inbox tab and listed once — contact-grained — in Spam.
  isSpam                       Boolean                   @default(false)
  spamMarkedAt                 DateTime?
  /// User id of whoever marked it; no FK relation, Contact already owns one to User.
  spamMarkedBy                 String?                   @db.Uuid
  waCatalogOrders              WaCatalogOrder[]
  igsId                        String? //Instagram Scoped User ID
  profilePic                   String?
  followerCount                Int?
  isIgVerifiedUser             Boolean?
  psid                         String? // Page-Scoped ID for Facebook Messenger 
  other                        String?
  Lifecycle                    Lifecycle?                @relation(fields: [lifecycleId], references: [id])
  lifecycleId                  String?                   @db.Uuid
  customFields                 ContactCustomFieldValue[]
  closedAt                     DateTime?
  closedBy                     String?                   @db.Uuid
  closedByUser                 User?                     @relation(fields: [closedBy], references: [id])

  lastMessageBody             Json?
  lastMessageWaCreatedAt      DateTime?
  lastMessagePlatform         String?
  lastReceivedMetadata        Json?
  lastMessageSourceIdentifier String?
  lastSentMessageTimeStamp    DateTime?
  ContactLabelMap             ContactLabelMap[]
  notes                       String?
  Conversations               Conversation[]
  loyaltyAccounts             CustomerLoyaltyAccount[]
  ticketCards                 TicketCard[]
  inboxMentions               InboxMention[]

  @@unique([external_id, orgId], name: "external_id_org_id_unique")
  @@unique([phone, orgId], name: "contact_phone_org_id_unique")
  @@unique([igsId, orgId], name: "contact_igsid_org_id_unique")
  @@unique([psid, orgId], name: "contact_psid_org_id_unique")
  @@index([orgId])
  @@index([orgId, id])
  @@index([orgId, waMessageAssignStatus])
  @@index([lastReceivedMessageTimeStamp])
  @@index([orgId, waMessageAssignStatus, lastReceivedMessageTimeStamp(sort: Desc)])
  @@index([orgId, blockedOnWhatsApp, lastReceivedMessageTimeStamp(sort: Desc)])
  @@index([orgId, isSpam])
  @@index([orgId, lifecycleId])
  @@index([name])
}

