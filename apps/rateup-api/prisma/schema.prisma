// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// for having typed Json fields
// TODO: remove this when prisma allows types for Json
// https://github.com/prisma/prisma/issues/3219
generator json {
  provider  = "prisma-json-types-generator"
  namespace = "PrismaJson"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  // can access all the team
  SUPER_ADMIN
  // can access only to the teams they are member of
  ADMIN
  //can access only team based survey responses, stats
  MEMBER
}

enum InviteStatus {
  // initial
  PENDING
  // accept invite
  ACCEPTED
  // decline invite
  DECLINED
}

enum InviteType {
  ORG
  TEAM
}

enum ResponsePlatform {
  WEB
  WHATSAPP
  APP
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  createdAt      DateTime        @default(now())
  email          String          @unique
  name           String?
  profilePhoto   String?
  phone          String?
  active         Boolean         @default(true)
  gender         Gender?
  org            Org[]
  orgMember      OrgMember[]
  teamMember     TeamMember[]
  surveys        Survey[]
  Order          Order[]
  assignedTicket Ticket[]        @relation("AssignedTicket")
  createdTicket  Ticket[]        @relation("CreatedTicket")
  TicketComment  TicketComment[]
  landingPage    LandingPage[]
}

model Org {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt         DateTime           @default(now())
  name              String
  owner             User               @relation(fields: [ownerId], references: [id])
  ownerId           String             @db.Uuid
  logo              String?
  phone             String?
  address           String?
  encryptionKeys    Json? //{privateKey:string,publicKey:string}
  members           OrgMember[]
  teams             Team[]
  invitations       Invitation[]
  whatsappSettings  WhatsappSettings?
  templates         WaTemplate[]
  Subscription      Subscription?
  Order             Order[]
  WaFlow            WaFlow[]
  googleAccessToken GoogleAccessToken?
  driveFolderId     String?
  contacts          Contact[]
  loyaltyCampaigns  LoyaltyCampaign[]
  loyaltyCustomers  LoyaltyCustomer[]
  LcReward          LcReward[]
  LcReferralCode    LcReferralCode[]
  landingPage       LandingPage[]
  WaContact         WaContact[]
  LoyaltyApiKey     LoyaltyApiKey?
  surveyThemes      WebSurveyTheme[]
  UsageStats        UsageStats?
}

model UsageStats {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  org       Org      @relation(fields: [orgId], references: [id])
  orgId     String   @unique @db.Uuid

  teamsCount           Int @default(0)
  teamMembersCount     Int @default(0)
  surveysCount         Int @default(0)
  surveyResponsesCount Int @default(0)
  menusCount           Int @default(0)
  menuViewsCount       Int @default(0)

  monthlySurveyResponses Int @default(0)
  monthlyMenuViews       Int @default(0)

  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?

  allowedTeams           Int @default(0)
  allowedTeamMembers     Int @default(0)
  allowedSurveys         Int @default(0)
  allowedSurveyResponses Int @default(0)
  allowedMenus           Int @default(0)
  allowedMenuViews       Int @default(0)
}

model WhatsappSettings {
  org   Org    @relation(fields: [orgId], references: [id])
  orgId String @unique @db.Uuid

  accessToken     String // encrypted
  accessToken_iv  String
  wabaId          String // WhatsApp Business Account ID
  phoneId         String
  phone           String
  appId           String
  webhookPassword String?

  type String // enums.ts: WaConfigType

  encryption Json? // for flow {publicKey: string, privateKey: string}
}

model OrgMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id])
  orgId     String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
  role      Role

  @@unique([userId, orgId], name: "userId_orgId")
}

model Team {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime @default(now())
  name       String
  code       String
  googleLink String?
  tags       String[] @default([])

  org                    Org                     @relation(fields: [orgId], references: [id])
  orgId                  String                  @db.Uuid
  members                TeamMember[]
  surveys                SurveyTeamMap[]
  invitations            Invitation[]
  contactGroups          ContactGroup[]
  menu                   Menu[]
  campaigns              Campaign[]
  reviewSuggestions      ReviewSuggestion[]
  Review                 Review[]
  RM_Topic               RM_Topic[]
  testimonialCollections TestimonialCollection[]
  Ticket                 Ticket[]
  WaAutomatedReply       WaAutomatedReply[]

  @@unique([name, orgId], name: "team_name_org_id_unique")
  @@unique([code, orgId], name: "team_code_org_id_unique")
}

model TeamMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
}

model Invitation {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  name      String
  type      InviteType
  org       Org          @relation(fields: [orgId], references: [id])
  orgId     String       @db.Uuid
  team      Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String?      @db.Uuid
  invitedBy String
  createdAt DateTime     @default(now())
  status    InviteStatus @default(PENDING)

  @@unique([email, teamId], name: "team_id_email_unique")
}

model Survey {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt               DateTime        @default(now())
  updatedAt               DateTime?       @updatedAt
  title                   String
  description             String?         @default("")
  /// [PQuestion]
  questions               Json[]          @default([])
  languages               String[]
  user                    User            @relation(fields: [createdBy], references: [id])
  createdBy               String          @db.Uuid
  teams                   SurveyTeamMap[]
  active                  Boolean         @default(true)
  isPublished             Boolean         @default(false)
  isProtected             Boolean         @default(false)
  kioskMode               Boolean         @default(false)
  uniqueDeviceResponse    Boolean         @default(false) //avoid duplicate entry from same IP
  password                String?
  type                    String          @default("web")
  getLocation             Boolean         @default(false)
  welcomePageEnabled      Boolean         @default(true)
  tags                    String[]        @default([])
  skipPreview             Boolean         @default(true)
  enableNotificationEmail Boolean         @default(false)
  notificationEmail       String          @default("")
  enableTickets           Boolean         @default(false)
  enableTicketEmailAlerts Boolean         @default(false)
  shareSettings           Json?
  publicKey               String?
  isEncrypted             Boolean         @default(false)
  surveyTheme             SurveyTheme?
  webSurveyThemeId        String?         @db.Uuid
  webSurveyTheme          WebSurveyTheme? @relation(fields: [webSurveyThemeId], references: [id])
  WaFlow                  WaFlow?
  spreadSheetId           String?
  redirect                Json            @default("{\"url\": \"/\",\"time\": \"5\" }")
}

model SurveyTeamMap {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId    String           @db.Uuid
  teamId      String           @db.Uuid
  shortUrlId  String?          @unique
  survey      Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  responses   SurveyResponse[]
  sessions    WaSession[]
  surveyStats SurveyStats?
  campaign    Campaign[]
  menuLanding MenuLanding[]
}

//this is the model for grouped surveys
model SurveyLanding {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt
  title              String
  header             String    @default("")
  description        String?   @default("")
  surveys            String[]
  createdBy          String    @db.Uuid
  welcomePageEnabled Boolean   @default(true)
}

model SurveyResponse {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime         @default(now())
  surveyTeamMap      SurveyTeamMap    @relation(fields: [surveyTeamMapId], references: [id], onDelete: Cascade)
  surveyTeamMapId    String           @db.Uuid
  /// [PQuestionResponse]
  responses          Json[]           @default([])
  encryptedResponses String?
  language           String           @default("")
  platform           ResponsePlatform @default(WEB)
  tag                String?          @default("")

  ip                   String?
  location             Json? // { 
  //                      coordinates: {latitude: number, longitude: number},
  //                      city: string, state: string, country: string
  //                    }
  deviceData           Json?
  Contact              Contact?              @relation(fields: [contactId], references: [id])
  contactId            String?               @db.Uuid
  CampaignParticipants CampaignParticipant[]
  Testimonial          Testimonial[]
  Ticket               Ticket[]
}

model SurveyStats {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyTeamMap   SurveyTeamMap @relation(fields: [surveyTeamMapId], references: [id], onDelete: Cascade)
  surveyTeamMapId String        @unique @db.Uuid
  visited         Int           @default(0)
  started         Int           @default(0)
  completed       Int           @default(0)
}

// Whatsapp session
model WaSession {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt             DateTime             @default(now())
  phone                 String
  surveyTeamMap         SurveyTeamMap?       @relation(fields: [surveyTeamMapId], references: [id])
  surveyTeamMapId       String?              @db.Uuid
  template              WaTemplate?          @relation(fields: [templateId], references: [id])
  templateId            String?              @db.Uuid
  currentQuestionId     String?
  campaignParticipant   CampaignParticipant? @relation(fields: [campaignParticipantId], references: [id])
  campaignParticipantId String?              @unique @db.Uuid
  /// [PQuestionResponse]
  responses             Json[]
  language              String               @default("")
  orgId                 String               @db.Uuid
  ip                    String?
  type                  String               @default("survey") // WaSessionType
  tag                   String?              @default("")

  @@unique([phone, orgId])
}

model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  name   String?
  phone  String?
  email  String?
  source String?

  org                  Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId                String                @db.Uuid
  responses            SurveyResponse[]
  contactGroups        ContactGroupMap[]
  campaignParticipants CampaignParticipant[]
  waContact            WaContact?

  @@unique([phone, orgId], name: "contact_phone_org_id_unique")
  @@unique([email, orgId], name: "contact_email_org_id_unique")
}

model ContactGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  name String
  icon String?

  contacts             ContactGroupMap[]
  team                 Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId               String                @db.Uuid
  campaignParticipants CampaignParticipant[]

  @@unique([name, teamId], name: "group_name_team_id_unique")
}

model ContactGroupMap {
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId      String       @db.Uuid
  contactGroup   ContactGroup @relation(fields: [contactGroupId], references: [id], onDelete: Cascade)
  contactGroupId String       @db.Uuid

  @@id([contactId, contactGroupId])
}

model Campaign {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  name      String
  startedAt DateTime?
  endedAt   DateTime?
  status    String    @default("INACTIVE") // enums.ts: CampaignStatus
  type      String // enums.ts: CampaignType

  team                 Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId               String                @db.Uuid
  surveyTeamMap        SurveyTeamMap         @relation(fields: [surveyTeamMapId], references: [id], onDelete: Cascade)
  surveyTeamMapId      String                @db.Uuid
  waTemplate           WaTemplate?           @relation(fields: [waTemplateId], references: [id], onDelete: Cascade)
  waTemplateId         String?               @db.Uuid
  // TODO: add email template?
  campaignParticipants CampaignParticipant[]
}

model CampaignParticipant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  status      String    @default("PENDING") // enums.ts: CampaignParticipantStatus
  sentAt      DateTime?
  respondedAt DateTime?
  source      String    @default("INDIVIDUAL") // enums.ts: CampaignParticipantSource

  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId     String          @db.Uuid
  contact        Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId      String          @db.Uuid
  contactGroup   ContactGroup?   @relation(fields: [contactGroupId], references: [id], onDelete: Cascade)
  contactGroupId String?         @db.Uuid
  response       SurveyResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  responseId     String?         @db.Uuid
  WaSession      WaSession?

  @@unique([campaignId, contactId], name: "campaign_contact_unique")
}

model SurveyTheme {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt
  surveyId      String    @unique @db.Uuid
  survey        Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  welcomeTheme  Json
  surveyTheme   Json
  thankyouTheme Json
}

model WebSurveyTheme {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String    @db.Uuid
  org       Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  name      String
  theme     Json
  survey    Survey[]

  @@unique([orgId, name])
}

model Menu {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt               DateTime       @default(now())
  name                    String // name of the menu
  displayName             String // name displayed to clients (eg: Restaurant's Name)
  locationText            String? // location of the restaurant
  locationUrl             String? // google maps url
  websiteUrl              String? // website url
  websiteText             String? // text to display for website url
  logo                    String? // logo url
  isPublished             Boolean        @default(false)
  categories              MenuCategory[]
  team                    Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId                  String         @db.Uuid
  menuLanding             MenuLanding?
  currency                String         @default("0")
  menuBanner              MenuBanner[]
  shareSettings           Json?
  hideUnavailableCategory Boolean        @default(false)
  shortUrlId              String?        @unique
}

model MenuCategory {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime   @default(now())
  name            String
  itemOrder       Int        @default(0)
  menu            Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId          String     @db.Uuid
  items           MenuItem[]
  image           String?
  scheduleEnabled Boolean    @default(false)
  startTime       DateTime?
  endTime         DateTime?
}

model MenuItem {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now())
  name          String
  description   String
  images        String[]
  videoUrl      String?
  price         Json
  itemOrder     Int          @default(0)
  disabled      Boolean      @default(false)
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId    String       @db.Uuid
  foodLabels    String[]     @default([])
  unsplashImage String[]     @default([])
}

//homepage contact form
model ContactForm {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  name      String
  email     String
  message   String
}

//media associated with the election
model Media {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  type      String
  name      String
  image     String
}

model WaTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now())
  /// [PWaTemplateWithTypesData]
  data         Json
  acceptButton String // QuickReplyButton text which on clicking will send the survey to the user

  org       Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String      @db.Uuid
  waSession WaSession[]
  Campaign  Campaign[]
}

model MenuLanding {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt             DateTime       @default(now())
  updatedAt             DateTime?      @updatedAt
  headerText            String?
  headerStyle           Json?
  titleStyle            Json?
  otherStyle            Json?
  logoStyles            Json?
  backgroundImage       String?
  mobileBackgroundImage String?
  menuPageEnabled       Boolean        @default(true)
  feedbackPageEnabled   Boolean        @default(false)
  catalogue             Boolean        @default(false)
  visited               Int            @default(0)
  menu                  Menu           @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId                String         @unique @db.Uuid
  surveyTeamMap         SurveyTeamMap? @relation(fields: [surveyTeamMapId], references: [id], onDelete: Cascade)
  surveyTeamMapId       String?        @db.Uuid
  unsplashImage         Json?
}

model ReviewSuggestion {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String @db.Uuid
  review   String
  language String @default("English")
}

model Review {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewedAt     DateTime        @default(now())
  review         String?
  title          String?
  rating         Int?
  platform       String
  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId         String          @db.Uuid
  meta           Json?
  ReviewAnalysis ReviewAnalysis?
  Ticket         Ticket[]
}

// result of sentiment analysis
model ReviewAnalysis {
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId  String @unique @db.Uuid
  entities  Json[] // {name: string, score: number}[]
  sentences Json[] // {text: string, sentiment: number}[]
  sentiment Float
}

model RM_Topic {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  keywords String[]
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String   @db.Uuid

  @@unique([name, teamId], name: "rm_topic_name_team_id_unique")
}

model NLP_Cache {
  text   String @unique
  result Json
}

model MenuBanner {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime @default(now())
  name        String
  description String
  image       String?
  videoUrl    String?
  price       Json
  menu        Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId      String   @db.Uuid
  foodLabels  String[] @default([])
}

model Subscription {
  org             Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId           String      @unique @db.Uuid
  features        Json
  renewedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime    @default(now())
  basePlan        RateupPlan? @relation(fields: [basePlanId], references: [id])
  basePlanId      String?     @db.Uuid
  subscriptionRef String? //gateway Subscription id
}

// used to tokenize some data
model Temporary_Tokenization {
  token     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  data      Json
  createdAt DateTime @default(now()) // gets deleted after 24 hours. shouldn't be used for long term storage
}

enum PaymentPlanStatus {
  NULL
  LIVE
  ACTIVE
  INACTIVE
}

model PaymentPlans {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId      String
  amount      Float
  currency    String
  name        String
  description String?
  createdAt   Int
  period      String
  interval    Int
  status      PaymentPlanStatus @default(NULL)
  RateupPlan  RateupPlan?
}

enum OrderStatus {
  PENDING
  COMPLETE
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Order {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  createdAt      DateTime      @default(now())
  createdBy      User          @relation(fields: [createdById], references: [id])
  createdById    String        @db.Uuid
  org            Org           @relation(fields: [orgId], references: [id])
  orgId          String        @db.Uuid
  status         OrderStatus   @default(PENDING)
  planId         String
  subscriptionId String        @unique
  payment        Payments?     @relation("PaymentOrder")
  paymentId      String?       @unique @db.Uuid
  orderPayment   Payments?     @relation("OrderPayment", fields: [paymentId], references: [id])
  paymentStatus  PaymentStatus @default(PENDING)
}

model Payments {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payId          String //gateway payment id
  createdAt      Int
  rateupOrderId  String  @unique @db.Uuid
  order          Order   @relation("PaymentOrder", fields: [rateupOrderId], references: [id])
  amount         Float
  currency       String
  method         String
  description    String?
  customer_email String?
  customer_phone String?
  OrderPayment   Order?  @relation("OrderPayment")
}

enum PaymentPlanType {
  BASE
  ADDON
}

model RateupPlan {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  displayName     String?
  displayWidgetId String?
  planType        PaymentPlanType
  paymentPlan     PaymentPlans?   @relation(fields: [paymentPlanId], references: [id])
  paymentPlanId   String?         @unique @db.Uuid
  Subscription    Subscription[]
  description     String[]        @default([])
  features        Json?
  createdAt       DateTime        @default(now())
}

model WaFlow {
  dbFlowId  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  flowId  String? @unique
  name    String
  status  String
  /// [PWaFlowJson]
  json    Json
  /// [PWaFlowPreview]
  preview Json?

  map        Json
  logicJumps Json @default("{}")

  /// [PWaFlowTemplateMessage]
  templateMessage Json @default("{}")

  org      Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId    String @db.Uuid
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  surveyId String @unique @db.Uuid
}

model Testimonial {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime                   @default(now())
  testimonial    Json
  responseId     String                     @db.Uuid
  surveyResponse SurveyResponse             @relation(fields: [responseId], references: [id], onDelete: Cascade)
  collections    TestimonialCollectionMap[]

  @@unique([testimonial, responseId], name: "response_testimonial_unique")
}

model TestimonialCollection {
  id           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  testimonials TestimonialCollectionMap[]
  teamId       String                     @db.Uuid
  team         Team                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  theme        Json?
  createdAt    DateTime                   @default(now())

  @@unique([name, teamId], name: "collection_name_team_id_unique")
}

model TestimonialCollectionMap {
  testimonialId String                @db.Uuid
  testimonial   Testimonial           @relation(fields: [testimonialId], references: [id], onDelete: Cascade)
  collectionId  String                @db.Uuid
  collection    TestimonialCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt     DateTime              @default(now())

  @@id([testimonialId, collectionId])
}

model Ticket {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number           Int             @unique @default(autoincrement())
  title            String
  description      String?
  type             TicketType
  createdBy        User            @relation("CreatedTicket", fields: [createdById], references: [id])
  createdById      String          @db.Uuid
  createdAt        DateTime        @default(now())
  status           TicketStatus
  priority         TicketPriority
  team             Team            @relation(fields: [teamId], references: [id])
  teamId           String          @db.Uuid
  deadline         DateTime?
  assignedTo       User            @relation("AssignedTicket", fields: [assignedToId], references: [id])
  assignedToId     String          @db.Uuid
  comments         TicketComment[]
  reviewId         String?         @db.Uuid
  surveyResponseId String?         @db.Uuid
  review           Review?         @relation(fields: [reviewId], references: [id])
  surveyResponse   SurveyResponse? @relation(fields: [surveyResponseId], references: [id])

  @@unique([number, teamId], name: "ticket_number_team_id_unique")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketType {
  REVIEW
  SURVEY_RESPONSE
  CUSTOM
}

model TicketComment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text        String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId    String   @db.Uuid
}

model GoogleAccessToken {
  accessToken  String
  orgId        String   @unique @db.Uuid
  org          Org      @relation(fields: [orgId], references: [id])
  refreshToken String
  expiryDate   String
  scopes       String[]
  userEmail    String?
}

model LoyaltyCampaign {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime @default(now())
  name           String   @unique
  type           String // enums.ts: LoyaltyCampaignType
  maxPerReferrer Int? // max number of referrals a referrer can make
  maxPerUser     Int? // max number of referralCode-redeems/transactions a user can make
  // for eg: if maxPerReferrer is 1, then a referrer can only refer a user once
  // for eg: if maxPerUser is 1, then a user can only redeem a referralCode once
  active         Boolean  @default(true)

  referrerReward   LcReward? @relation("ReferrerReward", fields: [referrerRewardId], references: [id])
  referrerRewardId String?   @db.Uuid
  userReward       LcReward? @relation("UserReward", fields: [userRewardId], references: [id])
  userRewardId     String?   @db.Uuid

  org                  Org                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId                String                 @db.Uuid
  LcReferralCode       LcReferralCode[]
  LCampaignRewardEvent LCampaignRewardEvent[]
}

model LcReward {
  // Loyalty Campaign Reward

  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  createdAt               DateTime @default(now())
  type                    String // enums.ts: CampaignRewardType
  fixedAmount             Int?
  percentage              Float?
  maxPointsPerTransaction Int?

  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String @db.Uuid

  ReferrerLoyaltyCampaign LoyaltyCampaign[] @relation("ReferrerReward")
  UserLoyaltyCampaign     LoyaltyCampaign[] @relation("UserReward")
}

model LoyaltyCustomer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  name  String?
  phone String
  email String?

  points Int @default(0)

  org            Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId          String           @db.Uuid
  LcReferralCode LcReferralCode[]

  ReferrerEvent LCampaignRewardEvent[] @relation("Referrer")
  CustomerEvent LCampaignRewardEvent[] @relation("User")

  LCustomerRewardEvent LCustomerRewardEvent[]

  @@unique([phone, orgId], name: "loyalty_customer_phone_org_unique")
  @@unique([email, orgId], name: "loyalty_customer_email_org_unique")
}

model LcReferralCode {
  createdAt DateTime @default(now())

  loyaltyCampaign   LoyaltyCampaign @relation(fields: [loyaltyCampaignId], references: [id], onDelete: Cascade)
  loyaltyCampaignId String          @db.Uuid

  customer   LoyaltyCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String          @db.Uuid

  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String @db.Uuid

  referralCode String @unique

  @@unique([loyaltyCampaignId, customerId], name: "loyalty_campaign_customer_unique")
}

model LCampaignRewardEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  loyaltyCampaign   LoyaltyCampaign @relation(fields: [loyaltyCampaignId], references: [id], onDelete: Cascade)
  loyaltyCampaignId String          @db.Uuid

  referrer   LoyaltyCustomer? @relation(name: "Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referrerId String?          @db.Uuid
  customer   LoyaltyCustomer? @relation(name: "User", fields: [customerId], references: [id], onDelete: Cascade)
  customerId String?          @db.Uuid

  transactionAmount Float?

  LCustomerRewardEvent LCustomerRewardEvent[]
}

model LCustomerRewardEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  LCampaignRewardEvent   LCampaignRewardEvent @relation(fields: [lCampaignRewardEventId], references: [id], onDelete: Cascade)
  lCampaignRewardEventId String               @db.Uuid

  customer   LoyaltyCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String          @db.Uuid

  type String // enums.ts: LoyaltyCustomerRewardType

  pointsEarned Int
}

model LandingPage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  createdAt      DateTime @default(now())
  createdById    String   @db.Uuid
  ownerOrgId     String   @db.Uuid
  shortUrlId     String   @unique
  theme          Json?
  links          Json?
  additionalData Json?
  shareSettings  Json?
  isPublished    Boolean  @default(false)
  owner          Org      @relation(fields: [ownerOrgId], references: [id], onDelete: Cascade)
  createdBy      User     @relation(fields: [createdById], references: [id])
}

model WaContact {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now())
  contactId String      @unique @db.Uuid
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  orgId     String      @db.Uuid
  org       Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  waInbox   WaMessage[]

  @@unique([contactId, orgId])
}

model WaMessage {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt               DateTime  @default(now())
  waCreatedAt             DateTime?
  waContactId             String    @db.Uuid
  /// [PWaMessageBody]
  messageBody             Json
  /// [PWaTemplateComponentParams]
  templateComponentParams Json?
  waContact               WaContact @relation(fields: [waContactId], references: [id], onDelete: Cascade)
}

model WaAutomatedReply {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String @db.Uuid

  /// [PWaAutomatedReplyMatchData]
  matchData Json
  matchType String // enums.ts: WaAutomatedReplyMatchType

  responseType       String // enums.ts: WaAutomatedReplyResponseType
  responseText       String?
  responseTemplateId String?
}

model LoyaltyApiKey {
  orgId String @unique @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // hashed key
  apiKey    String
  createdAt DateTime @default(now())
}

// TODO remove later: FOR myg vishu gift
model MyGInvoice {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceDate     DateTime
  invoiceNumber   String
  invoiceValue    Float
  mobileNumber    String
  invoiceBranch   String
  giftRedeemed    Boolean   @default(false)
  gift            String?
  redeemAttempt   Int       @default(0)
  invoiceDiscount Float?    @default(0)
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @default(dbgenerated("NULL")) @updatedAt

  @@unique([invoiceNumber, mobileNumber])
}
