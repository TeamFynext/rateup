/// Holder of a customer's WhatsApp thread under Meta Business Agent thread control.
enum MetaAgentThreadOwner {
  /// Meta AI is answering; the customer's messages arrive as `standby`.
  AI
  /// Handed to a person (escalation, or our app took the thread by replying).
  STAFF
}

/// Storage vocabulary for inbox status. Mirrored between `Contact.waMessageAssignStatus`
/// (live-inbox source of truth) and `Conversation.status`. "NEW" is a derived UI tab
/// (unassigned + recent) and "BLOCKED" is `Contact.blockedOnWhatsApp`; neither is stored here.
///
/// SPAM is DEPRECATED as a stored status — spam moved onto the contact
/// (`Contact.isSpam`) and a spam ticket is now simply CLOSED with
/// `closeReason = SPAM`. The value is kept only so pre-migration rows and the
/// internal-message event vocabulary still parse; never write it.
enum InboxStatus {
  UNASSIGNED
  ASSIGNED
  CLOSED
  SPAM
  RESOLVED
  UNRESOLVED
}

enum CloseReason {
  MANUAL
  AUTOMATION_IDLE
  RULE
  SPAM
}

/// Resolution *quality* chosen by the agent when closing a conversation/ticket.
/// Distinct from `CloseReason` (which records *why/who* closed it).
enum ResolutionResult {
  RESOLVED
  ANSWERED
  NO_RESPONSE
  DUPLICATE
}

model Conversation {
  id                     String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId              String                            @db.Uuid
  contact                Contact                           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// Denormalized from `Contact.orgId` so analytics can scope by org without joining Contact.
  orgId                  String?                           @db.Uuid
  messages               WaMessage[]
  status                 InboxStatus                       @default(UNASSIGNED)
  firstRespondedAt       DateTime?
  firstRespondedByUserAt DateTime?
  assignedUsers          ConversationAssignedUserTeamMap[]
  assignedAt             DateTime?
  closedAt               DateTime?
  closedBy               String?                           @db.Uuid
  closedByUser           User?                             @relation(fields: [closedBy], references: [id])
  /// Set only when status becomes RESOLVED; `closedAt` covers any terminal state.
  resolvedAt             DateTime?
  closeReason            CloseReason?
  closedByAutomation     Boolean                           @default(false)
  lastMessageAt          DateTime?
  lastCustomerMessageAt  DateTime?
  lastAgentMessageAt     DateTime?
  messageCount           Int                               @default(0)
  reopenCount            Int                               @default(0)
  /// Star flag is per-ticket (per-conversation), not per-contact, so one contact's
  /// tickets can be starred independently.
  isFavorite             Boolean                           @default(false)
  /// Ticket identity for the "Inbox Tickets" UI. `number` is the human-facing #code,
  /// sequential *per org* (each org starts at 1). Never set it from application code:
  /// the `conversation_assign_number` BEFORE INSERT trigger allocates it from
  /// `ConversationNumberCounter`. The `0` default is the "unset" sentinel the trigger
  /// looks for so Prisma can omit the column on create.
  number                 Int                               @default(0)
  subject                String?
  description            String?
  /// Resolution quality set when the conversation is closed with a result.
  resolutionResult       ResolutionResult?
  inboxMentions          InboxMention[]
  notes                  InboxNote[]
  /// Conversation-scoped tags. Distinct from `ContactLabel`, which sticks to the
  /// customer across every ticket they ever open.
  tags                   ConversationTagMap[]
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime?                         @updatedAt

  @@unique([orgId, number], name: "conversation_org_id_number_unique")
  @@index([contactId])
  @@index([firstRespondedAt])
  @@index([createdAt])
  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([orgId, lastMessageAt(sort: Desc)])
  @@index([orgId, isFavorite])
  // Resolution rate, resolved-per-day and the quick stats all filter on closedAt.
  @@index([orgId, closedAt])
}

/// Org-defined vocabulary for tagging a single conversation ("Bug Report",
/// "Escalated", "Follow-up"). The conversation-grained counterpart to
/// `ContactLabel`: a tag describes *this ticket*, a label describes the *customer*
/// and follows them across every ticket they open.
model ConversationTag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  color       String?  @default("#3b82f6")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orgId       String   @db.Uuid
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  conversationTags ConversationTagMap[]

  @@unique([name, orgId], name: "conversation_tag_name_org_id_unique")
  @@index([orgId])
}

model ConversationTagMap {
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  tagId String          @db.Uuid
  tag   ConversationTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([conversationId, tagId])
  @@index([conversationId])
  @@index([tagId])
}

/// Per-org allocator for `Conversation.number`. One row per org; the
/// `conversation_assign_number` trigger bumps `lastNumber` inside the inserting
/// transaction, so concurrent inserts serialize on the counter row instead of
/// racing a `max(number) + 1` read. Conversations with a null `orgId` share the
/// nil-uuid bucket.
model ConversationNumberCounter {
  orgId      String @id @db.Uuid
  lastNumber Int    @default(0)
}

/// Indexable signal for the inbox "@Mentions" filter. One row per (mention, mentioned user).
/// Written when an internal/private note resolves @mentions; `clearedAt` is set once seen.
model InboxMention {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String        @db.Uuid
  org             Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contactId       String        @db.Uuid
  contact         Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId  String?       @db.Uuid
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  mentionedUserId String        @db.Uuid
  mentionedUser   User          @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)
  noteId          String?       @db.Uuid
  note            InboxNote?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  clearedAt       DateTime?

  @@index([orgId, mentionedUserId, clearedAt])
  @@index([contactId, mentionedUserId, clearedAt])
  @@index([conversationId])
  @@index([noteId])
}

/// A private note agents leave on a ticket. Kept out of `WaMessage` so customer-traffic
/// reads never have to exclude it; the thread read merges notes back in by time.
model InboxNote {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String         @db.Uuid
  org            Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversationId String         @db.Uuid
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contactId      String         @db.Uuid
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId       String?        @db.Uuid
  author         User?          @relation("InboxNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// WhatsApp-formatted text (`*bold*`, `_italic_`), as the composer sends it.
  body           String
  /// The composer's temporary id, echoed back so its placeholder is replaced, not duplicated.
  clientId       String?
  createdAt      DateTime       @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  deletedById    String?        @db.Uuid
  deletedBy      User?          @relation("InboxNoteDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  mentions       InboxMention[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([contactId, createdAt(sort: Desc)])
}

enum WaMessageOrgTeamType {
  TEMPLATE
  CAMPAIGN
  INBOX
  FLOW
  AUTOMATED
}

model WaMessageOrgTeamMap {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime             @default(now())
  teamId           String?              @db.Uuid
  team             Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  messageId        String               @db.Uuid
  waMessage        WaMessage            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  orgId            String               @db.Uuid
  org              Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  isAutomedMessage Boolean              @default(false)
  type             WaMessageOrgTeamType
  externalApi      Boolean              @default(false)

  @@index([orgId])
  @@index([teamId])
  // Joins from WaMessage and the ON DELETE CASCADE check both look rows up by messageId.
  @@index([messageId])
  // Message analytics and the message log range-scan an org's (or one team's) sends
  // by date. Without these every query walks the org's whole history.
  @@index([orgId, createdAt])
  @@index([orgId, teamId, createdAt])
}

model Webhook {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String   @unique @db.Uuid
  url       String
  events    String[]
  /// HMAC key for the `X-Rateup-Signature` header, `encryptSecret`-encrypted.
  /// Null on rows saved before signing; the first delivery or reveal fills it.
  secret    String?
}

enum InboxAutomationAction {
  CLOSE
}

enum InboxAutomationCondition {
  UNASSIGNED
  NEW
  ASSIGNED
}

model InboxAutomation {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime                  @default(now())
  closeAfterHours Int?
  active          Boolean                   @default(true)
  action          InboxAutomationAction?
  condition       InboxAutomationCondition?

  orgId String @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, condition], name: "orgId_condition_unique")
}

model Referral {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referral_code String   @unique
  name          String
  email         String   @unique
  visit_count   Int      @default(0)
  signup_count  Int      @default(0)
  created_at    DateTime @default(now())
}

model InboxStats {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String   @unique @db.Uuid

  unassignedCount Int @default(0)
  assignedCount   Int @default(0)
  closedCount     Int @default(0)
  spamCount       Int @default(0)
  resolvedCount   Int @default(0)
  unresolvedCount Int @default(0)
  blockedCount    Int @default(0)
  totalCount      Int @default(0)
}

// ============================================================
// Lead pipeline
//
// A Pipeline is a board of ordered PipelineStages; a Lead is a card sitting in
// one stage. Stages carry the sales metadata a ticket column never had â€” win
// probability, a rotting threshold, and a mapping onto the inbox `Lifecycle`
// so moving a lead also moves the contact's lifecycle.
// ============================================================

enum LeadStatus {
  OPEN
  WON
  LOST
}

/// What a board is for. LEADS is the org's one sales funnel, the board the inbox,
/// automations and CRM syncs read; the rest are working boards with none of that.
enum PipelineType {
  LEADS
  SUPPORT
  PROJECTS
  CUSTOM
}

/// What landing in a stage does to a lead. Won and Lost stages close it and are
/// left out of open counts; the board bands its columns by this.
enum StageStatus {
  OPEN
  WON
  LOST
}

enum LeadSource {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  WEBCHAT
  SURVEY
  REFERRAL
  LOYALTY
  MANUAL
}

enum LeadChannel {
  NONE
  WHATSAPP
  INSTAGRAM
  MESSENGER
}

enum LeadTaskType {
  CALL
  MESSAGE
  MEETING
  DOCUMENT
  TODO
}

model Pipeline {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  order       Int          @default(0)
  /// Fixed at creation. At most one LEADS board per org: the partial unique index
  /// `pipeline_one_leads_per_org` (raw SQL in its migration) enforces it.
  type        PipelineType @default(LEADS)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  /// Flag leads idle past their stage's `rottingDays` as needing attention.
  rottingEnabled       Boolean @default(true)
  /// Write the stage's mapped lifecycle onto the contact whenever a lead moves.
  lifecycleSyncEnabled Boolean @default(true)
  /// Assign an incoming lead to the least-loaded member of its team.
  autoAssignEnabled    Boolean @default(false)
  /// Nudge owners about leads with no scheduled next activity.
  nudgeEnabled         Boolean @default(false)

  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String @db.Uuid

  teams           PipelineTeam[]
  /// Teams that send their contacts here by default.
  defaultForTeams Team[]               @relation("TeamDefaultPipeline")
  stages          PipelineStage[]
  leads           Lead[]
  labels          PipelineLabel[]
  lostReasons     PipelineLostReason[]

  @@unique([orgId, name], name: "pipeline_name_org_id_unique")
}

model PipelineTeam {
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId String   @db.Uuid
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId     String   @db.Uuid
  createdAt  DateTime @default(now())

  @@id([pipelineId, teamId])
}

model PipelineStage {
  id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String
  /// Short label for the drawer's stage stepper; falls back to `name`.
  short String?
  order Int     @default(0)
  /// Hex the org picked for this stage; null renders with the default accent.
  color String?

  /// Share of leads in this stage expected to convert, 0-100. Drives the forecast.
  probability Int         @default(0)
  /// Days idle before a lead here is flagged as rotting. 0 disables the check.
  rottingDays Int         @default(0)
  /// Landing here leaves the lead open, or closes it won or lost.
  status      StageStatus @default(OPEN)

  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId String   @db.Uuid

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipelineId, order])
}

model PipelineLostReason {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label String
  order Int    @default(0)

  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId String   @db.Uuid

  leads Lead[]

  createdAt DateTime @default(now())

  @@unique([pipelineId, label], name: "lost_reason_label_pipeline_id_unique")
}

model PipelineLabel {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String
  color String

  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId String   @db.Uuid

  leads LeadLabelMap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineId, name], name: "pipeline_label_name_pipeline_id_unique")
}

model LeadLabelMap {
  lead      Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String        @db.Uuid
  label     PipelineLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId   String        @db.Uuid
  createdAt DateTime      @default(now())

  @@id([leadId, labelId])
}

model Lead {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The card's share link (`/pl/<shortUrlId>`), minted like a web survey's.
  shortUrlId String? @unique
  name    String
  /// What the work is; used by the non-Leads boards, whose cards lead with a title.
  description String? @db.Text
  /// Business the lead represents; blank for walk-in customers.
  company String?
  phone   String?
  email   String?

  status  LeadStatus  @default(OPEN)
  source  LeadSource  @default(MANUAL)
  channel LeadChannel @default(NONE)

  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId String   @db.Uuid

  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  stageId String        @db.Uuid

  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId String? @db.Uuid

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?  @db.Uuid

  lostReason   PipelineLostReason? @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)
  lostReasonId String?             @db.Uuid

  /// CRM records this lead maps to, same shape as `Contact.integrationIds`.
  /// A lead with a contact stores them there instead, so the contact stays the
  /// single record for anything that has one; this is for board-only leads,
  /// which would otherwise open a fresh Bigin deal on every stage change.
  integrationIds Json?

  /// Whoever put the lead on the board. Fixed at creation and never reassigned —
  /// assignees change as the lead is handed around, the owner records who
  /// brought it in. Null for leads opened by automation rather than a person.
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String? @db.Uuid

  /// When the lead entered its current stage â€” the "Nd in stage" figure.
  stageEnteredAt  DateTime  @default(now())
  /// Last inbound or outbound touch; rotting is measured from here.
  lastActivityAt  DateTime  @default(now())
  /// Month this lead is forecast to close.
  expectedCloseAt DateTime?
  closedAt        DateTime?

  closedBy   User?   @relation("LeadClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labels     LeadLabelMap[]
  notes      LeadNote[]
  activities LeadActivity[]
  tasks      LeadTask[]
  /// A lead can be worked by several people, the same way a ticket card is.
  assignees  LeadAssignee[]

  /// One lead per contact per board. Postgres counts NULLs as distinct, so this
  /// leaves contact-less leads — walk-ins, manual board entries — unconstrained
  /// while closing the race in `setContactStage`, where two concurrent syncs
  /// could both find no lead and both create one.
  @@unique([contactId, pipelineId], name: "contact_pipeline_unique")
  @@index([pipelineId, status])
  @@index([stageId])
  /// Column paging: one stage, newest arrival first, keyset on (stageEnteredAt, id).
  @@index([stageId, stageEnteredAt(sort: Desc), id(sort: Desc)])
  /// Ungrouped list paging across the whole board.
  @@index([pipelineId, stageEnteredAt(sort: Desc), id(sort: Desc)])
  /// Rotting counts compare lastActivityAt against each stage's window.
  @@index([pipelineId, lastActivityAt])
}

model LeadAssignee {
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String   @db.Uuid
  assignee   User     @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assigneeId String   @db.Uuid
  createdAt  DateTime @default(now())

  @@id([leadId, assigneeId])
  @@index([assigneeId])
}

model LeadNote {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text String

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String @db.Uuid

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, createdAt])
}

model LeadActivity {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// CREATED, MOVED, ASSIGNEES_CHANGED, WON, LOST, REOPENED, NOTE_ADDED,
  /// TASK_ADDED, TASK_COMPLETED, LIFECYCLE_SYNCED, GETLEAD_SYNCED,
  /// GETLEAD_SKIPPED
  type    String
  /// [PLeadActivityDetails]
  details Json?

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String @db.Uuid

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String? @db.Uuid

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  /// The integration page's Sync activity panel: recent entries of the INTEGRATION_* types.
  @@index([type, createdAt])
}

/// The lead's scheduled next activity â€” the board card shows the earliest open one.
model LeadTask {
  id    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type  LeadTaskType @default(TODO)
  title String
  dueAt DateTime?

  completedAt DateTime?

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String @db.Uuid

  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, completedAt, dueAt])
}

// ---------------------------------------------------------------------------------------
// Staff console (src/modules/staff). RateUp employees who operate the platform. Not `User`s:
// they sign in with Google Workspace, never through SuperTokens, and belong to no org.
// ---------------------------------------------------------------------------------------

/// The allowlist. A Google login is refused unless its email is here and active.
model StaffUser {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  name          String?
  avatarUrl     String?
  /// Google's stable subject id, bound on first login.
  googleSub     String?   @unique
  active        Boolean   @default(true)
  /// Owners manage the allowlist; there is no other staff role yet.
  isOwner       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  createdById   String?   @db.Uuid
  lastLoginAt   DateTime?
  deactivatedAt DateTime?

  sessions  StaffSession[]
  auditLogs StaffAuditLog[]
}

/// A console session. Only a sha256 of the cookie value is stored.
model StaffSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash       String    @unique
  staffUserId     String    @db.Uuid
  staffUser       StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  /// When Google last authenticated the person; step-up checks this, not createdAt.
  authenticatedAt DateTime
  lastSeenAt      DateTime
  /// Absolute expiry; the idle timeout is judged from lastSeenAt.
  expiresAt       DateTime
  revokedAt       DateTime?
  ip              String?
  userAgent       String?

  @@index([staffUserId])
  @@index([expiresAt])
}

/// Every staff login and action. No FK to Org, so a row outlives the org it names.
model StaffAuditLog {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null for a refused login by someone who is not on the allowlist.
  staffUserId   String?    @db.Uuid
  staffUser     StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  staffEmail    String
  action        String
  method        String
  route         String
  targetOrgId   String?    @db.Uuid
  targetOrgName String?
  targetUserId  String?    @db.Uuid
  reason        String?
  before        Json?
  after         Json?
  /// The request body with secrets redacted.
  body          Json?
  ip            String?
  userAgent     String?
  createdAt     DateTime   @default(now())

  @@index([targetOrgId, createdAt])
  @@index([staffUserId, createdAt])
  @@index([createdAt])
}
