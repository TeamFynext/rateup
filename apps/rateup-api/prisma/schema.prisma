model WaFlow {
  dbFlowId  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  flowId      String?
  name        String
  status      String
  /// [PWaFlowJson]
  json        Json
  /// [PWaFlowPreview]
  preview     Json?
  // whether the flow has changes present in our db that are not saved in whatsapp
  pendingSave Boolean @default(true)

  /// [PWaFlowMap]
  map        Json
  /// [PWaFlowLogicJumps]
  logicJumps Json @default("{}")

  /// [PWaFlowTemplateMessage]
  templateMessage    Json @default("{}")
  /// [PWaFlowStartMessageConfig]
  startMessageConfig Json @default("{}")

  org          Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String  @db.Uuid
  survey       Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  surveyId     String  @unique @db.Uuid
  anonymous    Boolean @default(false)
  version      Int     @default(1)
  ///[FlowTicket[]]
  ticketIssued Json[]

  // The WhatsApp channel this flow lives on. Meta scopes `flowId` to a WABA, so a
  // flow can only be referenced (sent, or attached to a template's FLOW button) from
  // the number whose WABA it was created under. Null means "not recorded" — the org
  // default channel is used, which is what every flow did before this column existed.
  whatsappSettings   WhatsappSettings? @relation(fields: [whatsappSettingsId], references: [id], onDelete: SetNull)
  whatsappSettingsId String?           @db.Uuid

  @@unique([flowId, orgId])
  @@index([whatsappSettingsId])
}

