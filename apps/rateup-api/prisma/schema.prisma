model SurveyResponse {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime         @default(now())
  surveyTeamMap      SurveyTeamMap    @relation(fields: [surveyTeamMapId], references: [id], onDelete: Cascade)
  surveyTeamMapId    String           @db.Uuid
  /// [PQuestionResponse]
  responses          Json[]           @default([])
  encryptedResponses String?
  language           String           @default("")
  platform           ResponsePlatform @default(WEB)
  tag                String?          @default("")

  ip                   String?
  /// [PResponseLocation]
  location             Json?
  deviceData           Json?
  Contact              Contact?              @relation(fields: [contactId], references: [id])
  contactId            String?               @db.Uuid
  CampaignParticipants CampaignParticipant[]
  Testimonial          Testimonial[]
  Ticket               Ticket[]
  ticketCards          TicketCard[]
  /// Caller-supplied key that makes a submission idempotent. WhatsApp Flow runs
  /// pass their flow token: Meta retries a `data_exchange` request that 500s,
  /// and the answers may already have been filed by the attempt that failed.
  /// Null for every path that has no natural key (web responses, legacy
  /// phone-token flow runs) — Postgres treats nulls as distinct, so any number
  /// of rows may leave it unset.
  idempotencyKey       String?               @unique
}

