/// One partner-API write, remembered so a retry replays its answer instead of repeating the
/// work. This is the generic layer: it covers writes that move no points and so leave no
/// ledger row to collapse onto (applying a voucher, sending a card). Writes that DO book a
/// transaction are additionally guarded by `LoyaltyTransaction.idempotencyKey`, which is the
/// durable guarantee — this table expires.
model ExternalIdempotencyRecord {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Method + route, e.g. "POST /loyalty/points/award". Scoping by route stops one key
  /// reused against a different endpoint from replaying the wrong answer.
  scope       String
  key         String
  /// sha256 of the canonicalised body. A second request under the same key with a different
  /// body is a caller bug, answered with 409 rather than a misleading replay.
  requestHash String

  state          String @default("IN_FLIGHT") // IN_FLIGHT | COMPLETED
  responseStatus Int?
  responseBody   Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  expiresAt   DateTime

  @@unique([orgId, scope, key])
  @@index([expiresAt])
}

model Chatbot {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String  @db.Uuid
  org              Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name             String  @default("Default Chatbot")
  shortUrlId       String  @unique
  publicPageStatus String? @default("INACTIVE")
  enableWaChat     Boolean @default(false)
  waCommand        String?
  waPrompt         String?
  enableAllWaChat  Boolean @default(false)
}

model SurveyVariables {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  value    String
  type     String
  surveyId String @db.Uuid
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([name, surveyId], name: "variable_name_survey_id_unique")
}

model OtpStore {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String  @unique
  otp        String
  expiryDate String
  surveyId   String?
}

model GenerateQr {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  createdAt     DateTime @default(now())
  createdById   String   @db.Uuid
  ownerOrgId    String   @db.Uuid
  shortUrlId    String   @unique
  shareSettings Json?
  owner         Org      @relation(fields: [ownerOrgId], references: [id], onDelete: Cascade)
  createdBy     User     @relation(fields: [createdById], references: [id])
  link          String
  noOfScans     Int      @default(0)
}

model Integration {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  credential Json
  org        Org?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId      String?   @db.Uuid //case of orgId not available when getting credential. can be update later
  createdAt  DateTime? @default(now())
  active     Boolean   @default(true)
  links      IntegrationEntityLink[]
  /// Health, kept by the shared refresh cron and job runner: the last failure
  /// and how many have happened in a row. Reset by the next success. Admins are
  /// notified when the streak reaches the provider's threshold.
  lastError           String?
  lastErrorAt         DateTime?
  consecutiveFailures Int       @default(0)

  @@unique([orgId, name], name: "orgid_integration_name_unique")
}

/// Which external record a Rateup record is mirrored to, per connected
/// integration. Gives the sync idempotent upserts (look the pair up before
/// creating), dedupe, and echo suppression for two-way sync: `lastSyncHash` is
/// the hash of what Rateup last pushed, so an inbound change carrying the same
/// content is our own write coming back and is skipped.
model IntegrationEntityLink {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  integrationId String      @db.Uuid
  /// "contact", "lead", "deal", "order", … — the Rateup side's kind of record.
  entityType    String
  rateupId      String      @db.Uuid
  externalId    String
  lastSyncedAt  DateTime?
  lastSyncHash  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([integrationId, entityType, rateupId], name: "integration_entity_rateup_unique")
  @@unique([integrationId, entityType, externalId], name: "integration_entity_external_unique")
}

model WaMessageSchedule {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// [PWaScheduledMessageBody]
  messageBody     Json
  phone           String
  status          String         @default("SCHEDULED") // enums.ts: WaMessageScheduleStatus
  scheduledAt     DateTime
  createdAt       DateTime       @default(now())
  source          String?
  messageId       String?
  waTemplateId    String?        @db.Uuid
  waTemplate      WaTemplate?    @relation(fields: [waTemplateId], references: [id], onDelete: Cascade)
  orgId           String         @db.Uuid
  org             Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  surveyTeamMapId String?        @db.Uuid
  surveyTeamMap   SurveyTeamMap? @relation(fields: [surveyTeamMapId], references: [id], onDelete: Cascade)
  teamId          String?        @db.Uuid
  team            Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
}

// ============================================================================
// LOYALTY PROGRAM SYSTEM - Complete Rewrite
// ============================================================================
// This is a comprehensive loyalty program system supporting:
// - Multiple earning rules with time/customer/purchase conditions
// - Flexible rewards with complex redemption rules
// - Customer tier system with automatic progression
// - Referral system with bonuses
// - WhatsApp-native customer interactions
// - API-first design for POS/e-commerce integration
// ============================================================================

// Main loyalty program - ONE per organization
model LoyaltyProgram {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @unique @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Program Identity
  name         String
  /// The business behind the programme ("Kettle & Co"), distinct from the programme's own
  /// name ("Kettle Rewards"). Null on programmes created before the two were separated.
  businessName String?
  status       String  @default("draft") // 'draft', 'active', 'paused'

  // Currency Configuration
  currencyName       String @default("Points") // Points, Stars, Beans, etc.
  currencyCode       String @default("INR") // AED, USD, EUR, GBP, SAR, INR
  currencySymbol     String @default("₹") // د.إ, $, €, £, ﷼, ₹
  defaultCountryCode String @default("IN")

  // Self-reported typical order value, used to estimate what the program gives back as a
  // percentage of revenue (see src/modules/loyalty/giveback.ts). Nullable on purpose:
  // null means the merchant never told us, which the UI shows as a prompt. A 0 default
  // would read as a real answer and silently produce a giveback of 0%.
  averageOrderValue Decimal? @db.Decimal(12, 2)

  // Fixed Bonuses
  signupBonus       Int     @default(0)
  referralBonus     Int     @default(0) // For referrer
  referralBonusType String  @default("points") // 'points' or 'gift'
  referralRewardId  String? @db.Uuid // Reward ID when referralBonusType is 'gift'
  refereeBonus      Int     @default(0) // For new customer
  refereeBonusType  String  @default("points") // 'points' or 'gift'
  refereeRewardId   String? @db.Uuid // Reward ID when refereeBonusType is 'gift'
  /// Off keeps the amounts above for when it is switched back on; nothing is paid meanwhile.
  signupBonusEnabled   Boolean @default(true)
  referralBonusEnabled Boolean @default(true)

  // Tier Configuration
  tiersEnabled                  Boolean @default(true)
  tierResetPeriod               String? // 'never', 'yearly', 'monthly'
  // Rolling window for tier qualification: a member's tier is judged on purchase spend in
  // the trailing N months, and can move down when it lapses. Null = lifetime spend (legacy).
  tierQualificationWindowMonths Int?

  // Venue & branding profile (onboarding "profile" step). Hero image and brand colour are
  // stored now for digital wallet passes / web widgets later.
  timezone     String?
  logoUrl      String?
  brandColor   String?
  heroImageUrl String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  // Print materials — QR card and brochure copy/settings. Owned and versioned by the UI.
  materials    Json?

  // WhatsApp Business Account / Number
  whatsappSettingsId String?

  // Settings
  pointsActivityAlerts     Boolean          @default(true)
  autoApproveAdjustments   Boolean          @default(false)
  emailNotifications       Boolean          @default(true)
  whatsappNotifications    Boolean          @default(true)
  enableShopifyOrderPoints Boolean          @default(false)
  /// WooCommerce orders earn points when they reach `completed`, not on payment.
  enableWooOrderPoints     Boolean          @default(false)
  enablePointsExpiration  Boolean          @default(false)
  pointsExpirationMonths   Int              @default(12)
  // Inside an open 24-hour customer-service window, send a notification's text as a
  // plain message instead of the Meta template (free, and works before approval).
  sendTextInSession        Boolean          @default(true)
  /// The channels this programme messages members on, in fallback order. A member's own
  /// `preferredChannel` goes first when it is one of these.
  enabledChannels          LoyaltyChannel[] @default([WHATSAPP])
  referralMessageTemplate  Json             @default("[{\"type\": \"paragraph\",\"content\": [{\"type\": \"text\",\"text\": \"🎉 Welcome {{1}}!\\nYou are now registered in our Loyalty Program.\\n🔗 Your referral code: {{2}}\\nShare & earn rewards\"}]}]")

  // Guided setup wizard (/dashboard/loyalty/onboarding) progress. The wizard commits each
  // step for real while the program stays status "draft", so these track where to resume.
  onboardingPresetKey   String? // which preset pack the user picked
  onboardingStep        String? // last completed step id
  onboardingCompletedAt DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tiers            LoyaltyTier[]
  earningRules     LoyaltyEarningRule[]
  rewards          LoyaltyReward[]
  customers        CustomerLoyaltyAccount[]
  transactions     LoyaltyTransaction[]
  referrals        LoyaltyReferral[]
  eventTriggers    LoyaltyEventTrigger[]
  feedbackSetting  LoyaltyFeedbackSetting?
  feedbackRequests LoyaltyFeedbackRequest[]

  @@index([orgId])
  @@index([status])
}

// Customer tier definitions with progression thresholds
model LoyaltyTier {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId String         @db.Uuid
  program   LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  // Tier Identity
  name             String
  threshold        Decimal @default(0) @db.Decimal(12, 2) // Total spend required for this tier
  pointsMultiplier Decimal @default(1.00) @db.Decimal(4, 2) // 1.0, 1.25, 1.5, 2.0

  // Display
  color               String  @default("#999999")
  benefitsDescription String?
  priority            Int     @default(0) // For sorting/ordering

  // Metadata
  createdAt DateTime @default(now())

  // Relations
  customers CustomerLoyaltyAccount[]

  @@unique([programId, name])
  @@unique([programId, threshold])
  @@index([programId])
  @@index([programId, threshold])
}

// Configurable earning rules with time-based conditions
model LoyaltyEarningRule {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId String         @db.Uuid
  program   LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  // Rule Identity
  name        String
  description String?
  status      String  @default("active") // 'active', 'inactive', 'scheduled', 'expired'
  priority    Int     @default(0) // Higher priority = applied first

  // Earning Rate
  // Six places: "₹150 = 1 point" is 0.006667, which two places would round to 0.01 (a 50% error)
  // and "₹250 = 1 point" to 0.00 — nothing earned. Editors enter a spend/points pair.
  pointsPerUnit Decimal @default(1.00) @db.Decimal(12, 6) // Points per currency unit spent
  multiplier    Decimal @default(1.00) @db.Decimal(4, 2) // Additional multiplier (e.g., 2.0 for double points)
  bonusPoints   Int?    @default(0) // Flat bonus points per transaction

  // Time Conditions (all optional)
  validFrom         DateTime?
  validUntil        DateTime?
  allowedDays       String[] // ['monday', 'tuesday', 'saturday']
  /// [LoyaltyEarningRuleTimeRanges]
  allowedTimeRanges Json? // [{"start": "14:00", "end": "17:00"}]

  // Customer Conditions
  applicableToTiers String[] // NULL = all tiers, or array of tier IDs
  minPurchaseAmount Decimal? @db.Decimal(10, 2)
  maxPurchaseAmount Decimal? @db.Decimal(10, 2)

  // Usage Limits
  maxUsesPerCustomer Int? // NULL = unlimited
  maxTotalUses       Int? // NULL = unlimited
  currentTotalUses   Int  @default(0)

  // Additional Conditions (flexible for location, products, payment, etc.)
  /// [LoyaltyEarningRuleConditions]
  conditions Json? @default("{}")

  // Metadata
  isDefault Boolean  @default(false) // Default rule for regular earning
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid

  // Relations
  transactions LoyaltyTransaction[]

  // @@unique([programId, isDefault], map: "one_default_rule_per_program")
  @@index([programId])
  @@index([status])
  @@index([programId, priority(sort: Desc)])
  @@index([validFrom, validUntil])
  @@index([programId, isDefault])
}

// Rewards catalog - what customers can redeem
model LoyaltyReward {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId String         @db.Uuid
  program   LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  // Reward Identity
  name        String
  /// Stable, human-readable identifier for external callers. The partner API names
  /// rewards by this, never by `id` — a UUID is not something a POS can be configured with.
  code        String?
  description String?
  status      String  @default("active") // 'active', 'inactive', 'out_of_stock'

  // Reward Value
  pointsCost  Int
  rewardType  String // 'point', 'coupon', 'assigned'
  /// [LoyaltyRewardValue]
  /// [PLoyaltyRewardValue]
  rewardValue Json // Type-specific value data (e.g. { type: 'discount_fixed', amount: 10, ... })

  // Stock Management (optional)
  stockQuantity Int? // NULL = unlimited
  stockRedeemed Int  @default(0)

  waTemplateId String?     @db.Uuid
  waTemplate   WaTemplate? @relation(fields: [waTemplateId], references: [id])

  // Redemption Rules (flexible JSONB)
  /// [LoyaltyRedemptionRules]
  redemptionRules Json @default("{}")

  // Availability
  availableForTiers String[] // NULL = all tiers, or array of tier IDs

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  redemptions         LoyaltyRedemption[]
  loyaltyTransactions LoyaltyTransaction[]
  assignedRewards     CustomerReward[]
  eventTriggers       LoyaltyEventTrigger[]
  feedbackSettings    LoyaltyFeedbackSetting[]

  @@unique([programId, code])
  @@index([programId])
  @@index([status])
  @@index([pointsCost])
}

// Individual customer accounts within a loyalty program
model CustomerLoyaltyAccount {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId String         @db.Uuid
  program   LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  // Customer Identity
  contactId String  @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Points Balance
  currentPoints  Int     @default(0) // Available for redemption
  lifetimePoints Int     @default(0) // Total earned ever
  totalSpend     Decimal @default(0) @db.Decimal(12, 2) // Total lifetime spend (for tier progression)

  // Tier
  currentTierId String?      @db.Uuid
  currentTier   LoyaltyTier? @relation(fields: [currentTierId], references: [id])

  // Referral System
  referralCode String                   @unique // Unique code for this customer
  referredById String?                  @db.Uuid
  referredBy   CustomerLoyaltyAccount?  @relation("Referrals", fields: [referredById], references: [id])
  referrals    CustomerLoyaltyAccount[] @relation("Referrals")

  // Status
  status String @default("active") // 'active', 'suspended', 'closed'

  /// Where this member wants loyalty messages. Null follows the programme's order.
  preferredChannel LoyaltyChannel?

  // Null while a web self-signup waits for its first WhatsApp message or purchase; the
  // bonuses promised at signup sit in `pendingBonuses` until then. Every other signup path
  // credits immediately, so the default marks the account verified on creation.
  verifiedAt     DateTime? @default(now())
  /// [PLoyaltyPendingBonuses]
  pendingBonuses Json?

  /// The member's QR card. `cardCode` is the code the QR encodes — nine characters from
  /// the till-code alphabet, minted at enrolment for new members and on first send for
  /// older ones (null until then, which is also what keeps legacy members out of the
  /// automatic first-message send). `cardSentAt` is the last WhatsApp delivery Meta
  /// accepted; the image itself is rendered on demand, never stored.
  cardCode   String?   @unique
  cardSentAt DateTime?

  // Metadata
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// One send per occasion per member. Each scheduled reminder claims its own marker with a
  /// conditional update before sending, so a re-run or a duplicated tick is a no-op.
  lastInactivityReminderAt DateTime?
  lastBirthdayGreetedAt    DateTime?
  lastPointsExpiryAlertAt  DateTime?
  lastTierAtRiskAlertAt    DateTime?
  lastAnniversaryGreetedAt DateTime?

  // Relations
  transactions        LoyaltyTransaction[]
  redemptions         LoyaltyRedemption[]
  assignedRewards     CustomerReward[]
  referralsAsReferrer LoyaltyReferral[]        @relation("ReferrerAccount")
  referralsAsReferee  LoyaltyReferral[]        @relation("RefereeAccount")
  approvalRequests    ApprovalRequest[]
  feedbackRequests    LoyaltyFeedbackRequest[]

  @@unique([programId, contactId])
  @@index([programId])
  /// The inactivity and anniversary sweeps scan a programme's members by activity date.
  @@index([programId, lastActivityAt])
  @@index([programId, contactId])
  @@index([contactId])
  @@index([referralCode])
  @@index([currentTierId])
  @@index([referredById])
}

model CustomerReward {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shortCode        String                   @unique
  status           CustomerRewardStatus     @default(ISSUED)
  rewardId         String                   @db.Uuid
  reward           LoyaltyReward            @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  accountId        String                   @db.Uuid
  account          CustomerLoyaltyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignedAt       DateTime                 @default(now())
  feedbackRequests LoyaltyFeedbackRequest[]

  @@unique([rewardId, accountId])
  @@index([accountId])
}

enum LoyaltyFeedbackRequestStatus {
  SCHEDULED
  SENT
  COMPLETED
  CANCELLED
  FAILED
}

/// Post-visit feedback for one programme: which draft became the WhatsApp Flow, the team
/// whose Google review link happy customers are sent to, the timing, and the reward for
/// reviewing. The flow itself is an ordinary WaFlow/Survey pair, so its answers land in
/// SurveyResponse like any other flow's.
model LoyaltyFeedbackSetting {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId String         @unique @db.Uuid
  program   LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  teamId String @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  dbFlowId     String?     @db.Uuid
  flow         WaFlow?     @relation(fields: [dbFlowId], references: [dbFlowId], onDelete: SetNull)
  // The UTILITY template carrying a FLOW button, used when the customer's 24-hour
  // service window is closed — an interactive flow message can only be sent inside one.
  waTemplateId String?     @db.Uuid
  waTemplate   WaTemplate? @relation(fields: [waTemplateId], references: [id], onDelete: SetNull)

  enabled          Boolean        @default(false)
  sendDelayMinutes Int            @default(120)
  cooldownDays     Int            @default(30)
  // Granted once per customer, on the first tap of the review link.
  rewardId         String?        @db.Uuid
  reward           LoyaltyReward? @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  // Mirrors googleReview.minRating on the flow's overall-rating element.
  happyMinRating   Int            @default(4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One feedback ask to one customer. Created when points are earned, fired by a delayed
/// BullMQ job, completed by the flow's data-exchange / nfm_reply path, and clicked and
/// rewarded by the public review redirect.
model LoyaltyFeedbackRequest {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId     String                 @db.Uuid
  program       LoyaltyProgram         @relation(fields: [programId], references: [id], onDelete: Cascade)
  accountId     String                 @db.Uuid
  account       CustomerLoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Unique so one purchase can never schedule two asks, whatever races.
  transactionId String?                @unique @db.Uuid
  transaction   LoyaltyTransaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  status        LoyaltyFeedbackRequestStatus @default(SCHEDULED)
  happy         Boolean?
  overallRating Int?
  // 'interactive' inside the service window, 'template' otherwise.
  channel       String?
  failReason    String?

  scheduledFor    DateTime
  sentAt          DateTime?
  completedAt     DateTime?
  reviewClickedAt DateTime?
  rewardGrantedAt DateTime?

  customerRewardId String?         @db.Uuid
  customerReward   CustomerReward? @relation(fields: [customerRewardId], references: [id], onDelete: SetNull)
  surveyResponseId String?         @db.Uuid
  surveyResponse   SurveyResponse? @relation(fields: [surveyResponseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId, status])
  @@index([programId, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
}

// Complete ledger of all point movements
model LoyaltyTransaction {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String                 @db.Uuid
  account   CustomerLoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Transaction Details
  transactionType String // 'earn', 'redeem', 'adjust', 'expire', 'refund'
  points          Int // Positive for earn, negative for redeem
  balanceAfter    Int // Balance after this transaction

  // Source/Context
  source         String // 'purchase', 'signup_bonus', 'referral', 'reward_redemption', 'manual'
  referenceId    String? // External reference (order_id, etc.) — NOT unique, see idempotencyKey
  /// Collapses a retried write onto the row it already made. Deliberately separate from
  /// `referenceId`, which several writers share (a redemption id, `APPROVAL-<id>`, and the
  /// expiry sweep's partial allocations) and so cannot carry a unique index.
  idempotencyKey String?
  description    String?
  /// [LoyaltyTransactionMetadata]
  metadata       Json?   @default("{}")

  // Earning Rule Applied (for 'earn' transactions)
  earningRuleId         String?             @db.Uuid
  earningRule           LoyaltyEarningRule? @relation(fields: [earningRuleId], references: [id])
  earningRuleMultiplier Decimal?            @db.Decimal(4, 2)
  basePoints            Int?
  // Purchase amount behind an 'earn'/'purchase' row, as a typed column so trailing-window
  // tier qualification can be summed with an index (metadata.purchaseAmount is kept too).
  purchaseAmount        Decimal?            @db.Decimal(12, 2)

  // Related Records
  rewardId String?        @db.Uuid
  reward   LoyaltyReward? @relation(fields: [rewardId], references: [id])

  // Program reference for easier querying
  programId String         @db.Uuid
  program   LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt          DateTime                @default(now())
  createdBy          String?                 @db.Uuid
  loyaltyRedemptions LoyaltyRedemption[]
  approvalRequest    ApprovalRequest?
  feedbackRequest    LoyaltyFeedbackRequest?

  @@unique([programId, idempotencyKey])
  @@index([accountId])
  @@index([accountId, createdAt(sort: Desc)])
  @@index([transactionType])
  @@index([referenceId])
  @@index([createdAt(sort: Desc)])
  @@index([earningRuleId])
  @@index([programId])
  // The loyalty Overview scans one programme over a date window.
  @@index([programId, createdAt(sort: Desc)])
}

// Tracks reward redemption lifecycle
model LoyaltyRedemption {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String                 @db.Uuid
  account   CustomerLoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rewardId  String                 @db.Uuid
  reward    LoyaltyReward          @relation(fields: [rewardId], references: [id])

  // Transaction link (set when approved)
  transactionId String?             @unique @db.Uuid
  transaction   LoyaltyTransaction? @relation(fields: [transactionId], references: [id])

  // Redemption code for POS verification
  redemptionCode String @unique @db.VarChar(20)

  // Status workflow
  status RedemptionStatus @default(PENDING)

  // Usage tracking
  expiresAt        DateTime?
  usedAt           DateTime?
  /// Claim marker for the "your reward is about to expire" reminder — the occasion is per
  /// redemption code, so it cannot be tracked on the account.
  expiryNotifiedAt DateTime?
  /// [PLoyaltyUsedContext]
  usedContext      Json?     @default("{}") // POS details when used

  // Rule validation snapshot (at creation time)
  rulesValidatedAt      DateTime @default(now())
  rulesValidationPassed Boolean  @default(true)

  /// Mirror of this code as a discount in the connected store (Shopify or WooCommerce), when
  /// the reward is configured to sync (`redemptionRules.<store>.enabled`). `redemptionCode`
  /// *is* the discount code, so the code the customer gets over WhatsApp is the one that
  /// works at the shop's checkout. `storeDiscountError` holds why a sync did not happen — a
  /// missing scope, or a reward value with no discount equivalent — so a cashier-only code
  /// can be explained rather than just looking broken.
  ///
  /// The columns keep their Shopify names from when Shopify was the only store.
  storeDiscountId    String?   @map("shopifyDiscountId")
  storeDiscountUrl   String?   @map("shopifyDiscountUrl")
  storeDiscountError String?   @map("shopifyDiscountError")
  storeSyncedAt      DateTime? @map("shopifySyncedAt")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to approval
  approvalRequest ApprovalRequest?

  @@index([accountId])
  @@index([status])
  @@index([redemptionCode])
  /// The reward-expiring reminder looks for codes lapsing inside its lead window.
  @@index([expiresAt])
  @@map("loyalty_redemptions")
}

enum RedemptionStatus {
  PENDING // Awaiting approval
  APPROVED // Approved, code active
  USED // Used at POS
  REJECTED // Rejected (via approval system)
  CANCELLED // Cancelled after approval
  EXPIRED // Expired before use
}

model ApprovalRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // What needs approval
  requestType ApprovalRequestType
  status      ApprovalStatus      @default(PENDING)

  // Customer context
  accountId String                 @db.Uuid
  account   CustomerLoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Request details
  points      Int? // For point adjustments (positive or negative)
  reason      String @db.Text
  /// [PApprovalRequestData]
  requestData Json   @default("{}") // Type-specific additional data

  // Who requested
  requestedBy     String?         @db.Uuid // Staff/Admin user ID
  requestedByType RequestedByType @default(CUSTOMER)
  requestedByName String?         @db.VarChar(255)

  // Approval/Rejection details
  reviewedBy     String?   @db.Uuid
  reviewedByName String?   @db.VarChar(255)
  reviewedAt     DateTime?
  reviewNotes    String?   @db.Text

  // Related records (only one will be set based on type)
  redemptionId String?            @unique @db.Uuid
  redemption   LoyaltyRedemption? @relation(fields: [redemptionId], references: [id])

  transactionId String?             @unique @db.Uuid
  transaction   LoyaltyTransaction? @relation(fields: [transactionId], references: [id])

  // Auto-expiration
  expiresAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([status])
  @@index([requestType])
  @@index([createdAt])
  @@index([expiresAt], map: "idx_approval_expires") // Only for pending requests
  @@map("approval_requests")
}

enum ApprovalRequestType {
  REWARD_REDEMPTION // Customer redeeming a reward
  POINTS_ADJUSTMENT // Staff adjusting points (add or deduct)
  TIER_OVERRIDE // Staff manually changing customer tier
  ACCOUNT_SUSPENSION // Staff suspending an account
  ACCOUNT_REACTIVATION // Staff reactivating suspended account
  BULK_OPERATION // Bulk point adjustment or other mass action
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum RequestedByType {
  CUSTOMER // Customer-initiated (e.g., redemption)
  STAFF // Staff-initiated (e.g., manual adjustment)
  SYSTEM // System-initiated (e.g., auto-flagged)
}

