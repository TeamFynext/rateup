// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  // can access all the team
  SUPER_ADMIN
  // can access only to the teams they are member of
  ADMIN
  //can access only team based survey responses, stats
  MEMBER
}

enum InviteStatus {
  // initial
  PENDING
  // accept invite
  ACCEPTED
  // decline invite
  DECLINED
}

enum InviteType {
  ORG
  TEAM
}

enum ResponsePlatform {
  WEB
  WHATSAPP
  APP
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  createdAt    DateTime     @default(now())
  email        String       @unique
  name         String?
  profilePhoto String?
  phone        String?
  gender       Gender?
  org          Org[]
  orgMember    OrgMember[]
  teamMember   TeamMember[]
  surveys      Survey[]
}

model Org {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime          @default(now())
  name             String
  owner            User              @relation(fields: [ownerId], references: [id])
  ownerId          String            @db.Uuid
  logo             String?
  members          OrgMember[]
  teams            Team[]
  invitations      Invitation[]
  whatsappSettings WhatsappSettings?
  templates        WaTemplate[]
}

model WhatsappSettings {
  org   Org    @relation(fields: [orgId], references: [id])
  orgId String @unique @db.Uuid

  accessToken     String
  businessId      String
  phoneId         String
  webhookPassword String
}

model OrgMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id])
  orgId     String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
  role      Role

  @@unique([userId, orgId], name: "userId_orgId")
}

model Team {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime @default(now())
  name       String
  code       String
  googleLink String?
  tags       String[] @default([])

  org              Org               @relation(fields: [orgId], references: [id])
  orgId            String            @db.Uuid
  members          TeamMember[]
  surveys          Survey[]
  invitations      Invitation[]
  waCustomers      WaCustomer[]
  waCustomerGroups WaCustomerGroup[]
  menu             Menu[]

  @@unique([name, orgId], name: "team_name_org_id_unique")
  @@unique([code, orgId], name: "team_code_org_id_unique")
}

model TeamMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
}

model Invitation {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  name      String
  type      InviteType
  org       Org          @relation(fields: [orgId], references: [id])
  orgId     String       @db.Uuid
  team      Team?        @relation(fields: [teamId], references: [id])
  teamId    String?      @db.Uuid
  invitedBy String
  createdAt DateTime     @default(now())
  status    InviteStatus @default(PENDING)

  @@unique([email, teamId], name: "team_id_email_unique")
}

model Survey {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime?        @updatedAt
  title              String
  description        String?          @default("")
  questions          Json[]           @default([])
  languages          String[]
  user               User             @relation(fields: [createdBy], references: [id])
  createdBy          String           @db.Uuid
  team               Team             @relation(fields: [teamId], references: [id])
  teamId             String           @db.Uuid
  active             Boolean          @default(true)
  responses          SurveyResponse[]
  sessions           WaSession[]
  isProtected        Boolean          @default(false)
  kioskMode          Boolean          @default(false)
  password           String?
  surveyStats        SurveyStats?
  type               String           @default("web")
  getLocation        Boolean          @default(false)
  welcomePageEnabled Boolean          @default(true)
  tags               String[]         @default([])

  waCustomerSurveySendHistory      WaCustomerSurveySendHistory[]
  waCustomerGroupSurveySendHistory WaCustomerGroupSurveySendHistory[]
}

model SurveyLanding {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt
  title              String
  header             String    @default("")
  description        String?   @default("")
  surveys            String[]
  createdBy          String    @db.Uuid
  welcomePageEnabled Boolean   @default(true)
}

model SurveyResponse {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime         @default(now())
  survey       Survey           @relation(fields: [surveyId], references: [id])
  surveyId     String           @db.Uuid
  responses    Json[]
  language     String           @default("")
  platform     ResponsePlatform @default(WEB)
  waCustomer   WaCustomer?      @relation(fields: [waCustomerId], references: [id])
  waCustomerId String?          @db.Uuid
  ip           String?
  location     Json? // { 
  //                      coordinates: {latitude: number, longitude: number},
  //                      city: string, state: string, country: string
  //                    }
  deviceData   Json?
}

model SurveyStats {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  survey    Survey @relation(fields: [surveyId], references: [id])
  surveyId  String @unique @db.Uuid
  visited   Int    @default(0)
  started   Int    @default(0)
  completed Int    @default(0)
}

// Whatsapp session
model WaSession {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt         DateTime   @default(now())
  phone             String
  survey            Survey     @relation(fields: [surveyId], references: [id])
  surveyId          String     @db.Uuid
  template          WaTemplate @relation(fields: [templateId], references: [id])
  templateId        String     @db.Uuid
  currentQuestionId String?
  responses         Json[]
  language          String     @default("")
  orgId             String     @db.Uuid

  @@unique([phone, orgId])
}

model WaCustomer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  name      String?
  phone     String
  email     String?

  team                        Team                          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId                      String                        @db.Uuid
  responses                   SurveyResponse[]
  waCustomerGroups            WaCustomerGroupMap[]
  waCustomerSurveySendHistory WaCustomerSurveySendHistory[]

  @@unique([phone, teamId], name: "customer_phone_team_id_unique")
}

// customer groups to send surveys to
model WaCustomerGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  name      String

  waCustomers                      WaCustomerGroupMap[]
  waCustomerGroupSurveySendHistory WaCustomerGroupSurveySendHistory[]
  team                             Team                               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId                           String                             @db.Uuid

  @@unique([name, teamId], name: "group_name_team_id_unique")
}

model WaCustomerGroupMap {
  waCustomer        WaCustomer      @relation(fields: [waCustomerId], references: [id], onDelete: Cascade)
  waCustomerId      String          @db.Uuid
  waCustomerGroup   WaCustomerGroup @relation(fields: [waCustomerGroupId], references: [id], onDelete: Cascade)
  waCustomerGroupId String          @db.Uuid

  @@id([waCustomerId, waCustomerGroupId])
}

// survey "send" history
// records when a survey was sent to a customer (whatsapp)
model WaCustomerSurveySendHistory {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  survey       Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  surveyId     String     @db.Uuid
  template     WaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId   String     @db.Uuid
  waCustomer   WaCustomer @relation(fields: [waCustomerId], references: [id], onDelete: Cascade)
  waCustomerId String     @db.Uuid
  createdAt    DateTime   @default(now())
}

model WaCustomerGroupSurveySendHistory {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  waCustomerGroup   WaCustomerGroup @relation(fields: [waCustomerGroupId], references: [id], onDelete: Cascade)
  waCustomerGroupId String          @db.Uuid
  survey            Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  surveyId          String          @db.Uuid
  template          WaTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId        String          @db.Uuid
  createdAt         DateTime        @default(now())
}

//----------welcome page styles-----------
model WelcomeTheme {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt
  landingId    String?   @db.Uuid
  surveyId     String?   @db.Uuid
  headerText   String    @default("")
  descText     String    @default("")
  buttonText   String    @default("")
  headerStyles Json
  descStyles   Json
  buttonStyles Json
  bgStyles     Json
  logoStyles   Json
  logoUrl      String?
  bgUrl        String?
  bgType       String?   @default("bgcolor")
}

model Menu {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime @default(now())
  name            String // name of the menu
  displayName     String // name displayed to clients (eg: Restaurant's Name)
  locationText    String? // location of the restaurant
  locationUrl     String? // google maps url
  websiteUrl      String? // website url
  websiteText     String? // text to display for website url
  logo            String? // logo url
  backgroundImage String?

  categories MenuCategory[]
  team       Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId     String         @db.Uuid
}

model MenuCategory {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime   @default(now())
  name      String
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId    String     @db.Uuid
  items     MenuItem[]
  image     String?
}

model MenuItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime @default(now())
  name        String
  description String
  images      String[]
  videoUrl    String?
  // Since items might have different variants, we store price as a json.
  // The json will have the following structure:
  // {
  //   "price": 100,    |  if there are no variants this is the price
  //   "variants": [
  //     {
  //       "name": "small",
  //       "price": 100
  //     }
  //   ]
  // }

  price      Json
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String       @db.Uuid
}

//homepage contact form
model ContactForm {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  name      String
  email     String
  message   String
}

//media associated with the election
model Media {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  type      String
  name      String
  image     String
}

model WaTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now())
  data         Json
  acceptButton String // QuickReplyButton text which on clicking will send the survey to the user

  org                              Org                                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId                            String                             @db.Uuid
  waSession                        WaSession[]
  waCustomerSurveySendHistory      WaCustomerSurveySendHistory[]
  waCustomerGroupSurveySendHistory WaCustomerGroupSurveySendHistory[]
}
