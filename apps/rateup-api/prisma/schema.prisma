model WhatsappCatalog {
  catalogId           String               @unique
  orgId               String               @db.Uuid
  org                 Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vertical            String
  name                String?
  products            WaCatalogProduct[]
  orders              WaCatalogOrder[]
  connectedWaPhoneIds CatalogPhoneIdMap[]
  productSets         WhatsappProductSet[]

  autoCheckoutEnabled Boolean @default(false)
  checkoutMessage     String?

  @@unique([orgId, catalogId], name: "org_id_catalog_id_unique")
}

model CatalogPhoneIdMap {
  whatsappSettingsPhoneId String           @unique
  WhatsappSettings        WhatsappSettings @relation(fields: [whatsappSettingsPhoneId], references: [phoneId])
  catalogId               String
  catalog                 WhatsappCatalog  @relation(fields: [catalogId], references: [catalogId], onDelete: Cascade)

  @@index([catalogId])
}

model WhatsappProductSet {
  productSetId String          @id
  catalogId    String
  catalog      WhatsappCatalog @relation(fields: [catalogId], references: [catalogId], onDelete: Cascade)
  name         String
  orgId        String          @db.Uuid
  org          Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  filter       Json? // Stores filter criteria if dynamically generated
  productIds   String[] // Array of product retailer IDs in this set
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([orgId, productSetId], name: "org_id_product_set_id_unique")
  @@index([catalogId])
}

model WaCatalogProduct {
  productDbId       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogId         String
  catalog           WhatsappCatalog @relation(fields: [catalogId], references: [catalogId], onDelete: Cascade)
  type              String
  retailer_id       String?
  hotel_id          String?
  hotel_room_id     String?
  hotel_ratailer_id String?
  productMetaId     String?
  productProps      Json?
  hotelProps        Json?
  hotelRoomProps    Json?

  @@unique([catalogId, retailer_id], name: "catalog_retailer_id_unique")
  @@unique([catalogId, hotel_id], name: "catalog_hotel_id_unique")
  @@unique([catalogId, hotel_ratailer_id, hotel_room_id], name: "catalog_hotel_room_id_unique")
}

model WaCatalogOrder {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogId     String
  catalog       WhatsappCatalog @relation(fields: [catalogId], references: [catalogId], onDelete: Cascade)
  products      Json[]
  contactId     String          @db.Uuid
  contact       Contact         @relation(fields: [contactId], references: [id], onDelete: NoAction)
  paymentMethod String?
  paymentStatus String          @default("PENDING")
  status        String          @default("PENDING")
  transactionId String?
  createdAt     DateTime        @default(now())

  shopifyDraftOrderId String?
  shopifyInvoiceUrl   String?
}

model MetaAssets {
  whatsappSettings   WhatsappSettings @relation(fields: [whatsappSettingsId], references: [id], onDelete: Cascade)
  whatsappSettingsId String           @unique @db.Uuid
  pages              Json[]
  adAccounts         Json[]
  leads              Json[]
  leadgenForms       Json[]
}

model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgMemberId String    @db.Uuid
  orgMember   OrgMember @relation(fields: [orgMemberId], references: [id], onDelete: Cascade)
  data        Json
  source      String
  subSource   String
  createdAt   DateTime  @default(now())
}

model NotificationSetting {
  orgMemberId                 String    @unique @db.Uuid
  orgMember                   OrgMember @relation(fields: [orgMemberId], references: [id], onDelete: Cascade)
  ticketAssignNotification    Boolean   @default(false)
  waMessageAssignNotification Boolean   @default(false)
  waMessageClosedNotification Boolean   @default(false)
}

model BookDemo {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  workEmail      String
  phoneNumber    String
  companyName    String
  teamSize       String
  preferredTime  String
  primaryUseCase String
  additionalInfo String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  action    String
  method    String
  route     String
  body      Json?
  createdAt DateTime @default(now())
  orgId     String   @db.Uuid
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model BusinessHour {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  orgId String @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name        String
  timezone    String
  channels    String[]
  description String?

  schedule Json // <---- stores 7 days + timeslots

  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  waAutomatedReplyCommands WaAutomatedReplyCommands[]
  ruleMessageBodyLocks     RuleMessageBodyLock[]
}

model ConversationAssignedUserTeamMap {
  userId                 String       @db.Uuid
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade, name: "ConversationAssignedUser")
  teamId                 String       @db.Uuid
  Team                   Team         @relation(fields: [teamId], references: [id])
  conversationId         String       @db.Uuid
  Conversation           Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lastAssignedAt         DateTime?
  lastRemovedAt          DateTime?
  lastRemovedBy          String?      @db.Uuid
  lastRemovedByUser      User?        @relation(fields: [lastRemovedBy], references: [id], name: "ConversationRemovedUser")
  lastAssignedBy         String?      @db.Uuid
  lastAssignedByUser     User?        @relation(fields: [lastAssignedBy], references: [id], name: "ConversationAssignedByUser")
  isAssignedByAutomation Boolean      @default(false)
  actionHistory          Json[]       @default([])

  @@id([userId, conversationId])
  @@index([userId, conversationId])
  @@index([conversationId])
  @@index([userId, lastAssignedAt, lastRemovedAt])
}

model Conversation {
  id                     String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId              String                            @db.Uuid
  contact                Contact                           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages               WaMessage[]
  status                 String                            @default("UNASSIGNED")
  firstRespondedAt       DateTime?
  firstRespondedByUserAt DateTime?
  assignedUsers          ConversationAssignedUserTeamMap[]
  assignedAt             DateTime?
  closedAt               DateTime?
  closedBy               String?                           @db.Uuid
  closedByUser           User?                             @relation(fields: [closedBy], references: [id])
  createdAt              DateTime                          @default(now())

  @@index([contactId])
  @@index([firstRespondedAt])
  @@index([createdAt])
}
