// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  // can access all the team
  SUPER_ADMIN
  // can access only to the teams they are member of
  ADMIN
  //can access only team based survey responses, stats
  MEMBER
}

enum InviteStatus {
  // initial
  PENDING
  // accept invite
  ACCEPTED
  // decline invite
  DECLINED
}

enum InviteType {
  ORG
  TEAM
}

enum ResponsePlatform {
  WEB
  WHATSAPP
  APP
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  createdAt    DateTime     @default(now())
  email        String       @unique
  name         String?
  profilePhoto String?
  phone        String?
  active       Boolean      @default(true)
  gender       Gender?
  org          Org[]
  orgMember    OrgMember[]
  teamMember   TeamMember[]
  surveys      Survey[]
}

model Org {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime          @default(now())
  name             String
  owner            User              @relation(fields: [ownerId], references: [id])
  ownerId          String            @db.Uuid
  logo             String?
  phone            String?
  address          String?
  members          OrgMember[]
  teams            Team[]
  invitations      Invitation[]
  whatsappSettings WhatsappSettings?
  templates        WaTemplate[]
}

model WhatsappSettings {
  org   Org    @relation(fields: [orgId], references: [id])
  orgId String @unique @db.Uuid

  accessToken     String
  businessId      String
  phoneId         String
  webhookPassword String
}

model OrgMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id])
  orgId     String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
  role      Role

  @@unique([userId, orgId], name: "userId_orgId")
}

model Team {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime @default(now())
  name       String
  code       String
  googleLink String?
  tags       String[] @default([])

  org               Org                @relation(fields: [orgId], references: [id])
  orgId             String             @db.Uuid
  members           TeamMember[]
  surveys           SurveyTeamMap[]
  invitations       Invitation[]
  contacts          Contact[]
  contactGroups     ContactGroup[]
  menu              Menu[]
  campaigns         Campaign[]
  reviewSuggestions ReviewSuggestion[]

  @@unique([name, orgId], name: "team_name_org_id_unique")
  @@unique([code, orgId], name: "team_code_org_id_unique")
}

model TeamMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
}

model Invitation {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  name      String
  type      InviteType
  org       Org          @relation(fields: [orgId], references: [id])
  orgId     String       @db.Uuid
  team      Team?        @relation(fields: [teamId], references: [id])
  teamId    String?      @db.Uuid
  invitedBy String
  createdAt DateTime     @default(now())
  status    InviteStatus @default(PENDING)

  @@unique([email, teamId], name: "team_id_email_unique")
}

model Survey {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime        @default(now())
  updatedAt          DateTime?       @updatedAt
  title              String
  description        String?         @default("")
  questions          Json[]          @default([])
  languages          String[]
  user               User            @relation(fields: [createdBy], references: [id])
  createdBy          String          @db.Uuid
  teams              SurveyTeamMap[]
  active             Boolean         @default(true)
  isPublished        Boolean         @default(false)
  isProtected        Boolean         @default(false)
  kioskMode          Boolean         @default(false)
  password           String?
  type               String          @default("web")
  getLocation        Boolean         @default(false)
  welcomePageEnabled Boolean         @default(true)
  tags               String[]        @default([])
}

model SurveyTeamMap {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId    String           @db.Uuid
  teamId      String           @db.Uuid
  survey      Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  responses   SurveyResponse[]
  sessions    WaSession[]
  surveyStats SurveyStats?
  campaign    Campaign[]
  menuLanding MenuLanding[]
}

model SurveyLanding {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt
  title              String
  header             String    @default("")
  description        String?   @default("")
  surveys            String[]
  createdBy          String    @db.Uuid
  welcomePageEnabled Boolean   @default(true)
}

model SurveyResponse {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime         @default(now())
  surveyTeamMap   SurveyTeamMap    @relation(fields: [surveyTeamMapId], references: [id])
  surveyTeamMapId String           @db.Uuid
  responses       Json[]
  language        String           @default("")
  platform        ResponsePlatform @default(WEB)

  ip                   String?
  location             Json? // { 
  //                      coordinates: {latitude: number, longitude: number},
  //                      city: string, state: string, country: string
  //                    }
  deviceData           Json?
  Contact              Contact?              @relation(fields: [contactId], references: [id])
  contactId            String?               @db.Uuid
  CampaignParticipants CampaignParticipant[]
}

model SurveyStats {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyTeamMap   SurveyTeamMap @relation(fields: [surveyTeamMapId], references: [id])
  surveyTeamMapId String        @unique @db.Uuid
  visited         Int           @default(0)
  started         Int           @default(0)
  completed       Int           @default(0)
}

// Whatsapp session
model WaSession {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt             DateTime             @default(now())
  phone                 String
  surveyTeamMap         SurveyTeamMap        @relation(fields: [surveyTeamMapId], references: [id])
  surveyTeamMapId       String               @db.Uuid
  template              WaTemplate?          @relation(fields: [templateId], references: [id])
  templateId            String?              @db.Uuid
  currentQuestionId     String?
  campaignParticipant   CampaignParticipant? @relation(fields: [campaignParticipantId], references: [id])
  campaignParticipantId String?              @unique @db.Uuid
  responses             Json[]
  language              String               @default("")
  orgId                 String               @db.Uuid

  @@unique([phone, orgId])
}

model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  name  String?
  phone String?
  email String?

  team                 Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId               String                @db.Uuid
  responses            SurveyResponse[]
  contactGroups        ContactGroupMap[]
  campaignParticipants CampaignParticipant[]

  @@unique([phone, teamId], name: "contact_phone_team_id_unique")
  @@unique([email, teamId], name: "contact_email_team_id_unique")
}

model ContactGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  name String
  icon String?

  contacts             ContactGroupMap[]
  team                 Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId               String                @db.Uuid
  campaignParticipants CampaignParticipant[]

  @@unique([name, teamId], name: "group_name_team_id_unique")
}

model ContactGroupMap {
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId      String       @db.Uuid
  contactGroup   ContactGroup @relation(fields: [contactGroupId], references: [id], onDelete: Cascade)
  contactGroupId String       @db.Uuid

  @@id([contactId, contactGroupId])
}

model Campaign {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  name      String
  startedAt DateTime?
  endedAt   DateTime?
  status    String    @default("INACTIVE") // enums.ts: CampaignStatus
  type      String // enums.ts: CampaignType

  team                 Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId               String                @db.Uuid
  surveyTeamMap        SurveyTeamMap         @relation(fields: [surveyTeamMapId], references: [id], onDelete: Cascade)
  surveyTeamMapId      String                @db.Uuid
  waTemplate           WaTemplate?           @relation(fields: [waTemplateId], references: [id], onDelete: Cascade)
  waTemplateId         String?               @db.Uuid
  // TODO: add email template?
  campaignParticipants CampaignParticipant[]
}

model CampaignParticipant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  status      String    @default("PENDING") // enums.ts: CampaignParticipantStatus
  sentAt      DateTime?
  respondedAt DateTime?
  source      String    @default("INDIVIDUAL") // enums.ts: CampaignParticipantSource

  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId     String          @db.Uuid
  contact        Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId      String          @db.Uuid
  contactGroup   ContactGroup?   @relation(fields: [contactGroupId], references: [id], onDelete: Cascade)
  contactGroupId String?         @db.Uuid
  response       SurveyResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  responseId     String?         @db.Uuid
  WaSession      WaSession?

  @@unique([campaignId, contactId], name: "campaign_contact_unique")
}

//----------welcome page styles-----------
model WelcomeTheme {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt
  landingId    String?   @db.Uuid
  surveyId     String?   @db.Uuid
  headerText   String    @default("")
  descText     String    @default("")
  buttonText   String    @default("")
  headerStyles Json
  descStyles   Json
  buttonStyles Json
  bgStyles     Json
  logoStyles   Json
  logoUrl      String?
  bgUrl        String?
  bgType       String?   @default("bgcolor")
}

model Menu {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime       @default(now())
  name         String // name of the menu
  displayName  String // name displayed to clients (eg: Restaurant's Name)
  locationText String? // location of the restaurant
  locationUrl  String? // google maps url
  websiteUrl   String? // website url
  websiteText  String? // text to display for website url
  logo         String? // logo url
  isPublished  Boolean        @default(false)
  categories   MenuCategory[]
  team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String         @db.Uuid
  menuLanding  MenuLanding?
}

model MenuCategory {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime   @default(now())
  name      String
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId    String     @db.Uuid
  items     MenuItem[]
  image     String?
}

model MenuItem {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime     @default(now())
  name        String
  description String
  images      String[]
  videoUrl    String?
  price       Json
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String       @db.Uuid
}

//homepage contact form
model ContactForm {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  name      String
  email     String
  message   String
}

//media associated with the election
model Media {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  type      String
  name      String
  image     String
}

model WaTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now())
  data         Json
  acceptButton String // QuickReplyButton text which on clicking will send the survey to the user

  org       Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String      @db.Uuid
  waSession WaSession[]
  Campaign  Campaign[]
}

model MenuLanding {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt             DateTime       @default(now())
  updatedAt             DateTime?      @updatedAt
  headerText            String?
  headerStyle           Json?
  titleStyle            Json?
  otherStyle            Json?
  logoStyles            Json?
  backgroundImage       String?
  mobileBackgroundImage String?
  menuPageEnabled       Boolean        @default(true)
  feedbackPageEnabled   Boolean        @default(false)
  menu                  Menu           @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId                String         @unique @db.Uuid
  surveyTeamMap         SurveyTeamMap? @relation(fields: [surveyTeamMapId], references: [id], onDelete: Cascade)
  surveyTeamMapId          String?        @db.Uuid
  // Survey                Survey?       @relation(fields: [surveyId], references: [id])
  // surveyId              String?       @db.Uuid
}

model ReviewSuggestion {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String @db.Uuid
  review String
}
