// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// for having typed Json fields
// TODO: remove this when prisma allows types for Json
generator json {
  provider  = "prisma-json-types-generator"
  namespace = "PrismaJson"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  // can access all the team
  // can access only to the teams they are member of
  SUPER_ADMIN
  ADMIN
  //can access only team based survey responses, stats
  MEMBER
}

enum InviteStatus {
  // initial
  PENDING
  // accept invite
  ACCEPTED
  // decline invite
  DECLINED
}

enum InviteType {
  ORG
  TEAM
}

enum ResponsePlatform {
  WEB
  WHATSAPP
  APP
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserRecipes {
  EmailPassword
  ThirdPartyGoogle
  PasswordLess
}

enum TemplateType {
  GENERAL_NOTIFICATION
  ORDER_DETAILS
  PAYMENT_CONFIRMATION
  LOYALTY
  CAROUSEL
}

enum ContactGroupType {
  NORMAL
  LOYALTY
}

enum UserPresenceMode {
  automatic
  manual
}

enum CustomerRewardStatus {
  ISSUED
  REDEEMED
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  createdAt      DateTime         @default(now())
  email          String           @unique
  name           String?
  profilePhoto   String?
  phone          String?
  active         Boolean          @default(true)
  gender         Gender?
  recipeName     UserRecipes?
  isPaused       Boolean?         @default(false)
  pausedBy       String?
  prefLanguage   String?          @default("English")
  deletedAt      DateTime?
  lastLoggedInAt DateTime?
  presenceMode   UserPresenceMode @default(automatic)

  org                         Org[]
  orgMember                   OrgMember[]
  teamMember                  TeamMember[]
  surveys                     Survey[]
  Order                       Order[]
  assignedTicket              Ticket[]                          @relation("AssignedTicket")
  createdTicket               Ticket[]                          @relation("CreatedTicket")
  TicketComment               TicketComment[]
  linktree                    Linktree[]
  generateQr                  GenerateQr[]
  landingPage                 LandingPage[]
  WaMessage                   WaMessage[]
  waInboxAssign               WaInboxAssign[]
  ticketActivity              TicketActivity[]
  assignedTicketCards         TicketCardAssignee[]
  assignedBoards              TicketBoardNotification[]
  expoPushTokens              ExpoPushToken[]
  // Add relation for WaAutomatedReply many-to-many
  UserAssignedCount           UserAssignedCount[]
  AuditLog                    AuditLog[]
  LastClosedContacts          Contact[]
  ClosedConversations         Conversation[]
  AssignedConversations       ConversationAssignedUserTeamMap[] @relation("ConversationAssignedUser")
  removedAssignees            ConversationAssignedUserTeamMap[] @relation("ConversationRemovedUser")
  assignedStafftoConversation ConversationAssignedUserTeamMap[] @relation("ConversationAssignedByUser")
}

model Org {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                DateTime @default(now())
  name                     String
  owner                    User     @relation(fields: [ownerId], references: [id])
  ownerId                  String   @db.Uuid
  logo                     String?
  phone                    String?
  address                  String?
  encryptionKeys           Json? //{privateKey:string,publicKey:string}
  isPaused                 Boolean? @default(false)
  waAssignedChatPermission String   @default("All")

  onboarding          Json?
  onboardingCompleted Boolean @default(false)

  showLifecycle Boolean @default(true)

  members                  OrgMember[]
  teams                    Team[]
  invitations              Invitation[]
  templates                WaTemplate[]
  Subscription             Subscription?
  Order                    Order[]
  WaFlow                   WaFlow[]
  contacts                 Contact[]
  linktree                 Linktree[]
  ApiAccessToken           ApiAccessToken?
  surveyThemes             WebSurveyTheme[]
  UsageStats               UsageStats?
  chatbot                  Chatbot[]
  Survey                   Survey[]
  WaAccountSettings        WaAccountSettings?
  generateQr               GenerateQr[]
  landingPage              LandingPage[]
  Integration              Integration[]
  waMessageSchedule        WaMessageSchedule[]
  WaLogs                   WaLogs[]
  loyaltyProgram           LoyaltyProgram?
  loyaltyTemplates         LoyaltyWaCommand[]
  WaAutomatedReplyMessage  WaAutomatedReplyMessage[]
  WaAutomatedReplyCommands WaAutomatedReplyCommands[]
  WaAutomatedReply         WaAutomatedReply[]
  whatsappQuickReplies     WhatsappQuickReply[]
  loyaltyApiSettings       LoyaltyApiSettings[]
  expoPushTokens           ExpoPushToken[]
  WhatsappSettings         WhatsappSettings[]
  WaCatalog                WhatsappCatalog[]
  productSets              WhatsappProductSet[]
  UserAssignedCount        UserAssignedCount[]
  Lifecycle                Lifecycle[]
  ContactCustomField       ContactCustomField[]
  AuditLog                 AuditLog[]
  ContactLabel             ContactLabel[]
  businessHours            BusinessHour[]
  rules                    Rule[]
  ruleMessageBodyLocks     RuleMessageBodyLock[]
}

model UsageStats {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String   @unique @db.Uuid

  teamsCount              Int @default(0)
  teamMembersCount        Int @default(0)
  surveysCount            Int @default(0)
  surveyResponsesCount    Int @default(0)
  waSurveysCount          Int @default(0)
  waSurveyResponsesCount  Int @default(0)
  menusCount              Int @default(0)
  menuViewsCount          Int @default(0)
  messagesCount           Int @default(0)
  aiPromptTokensCount     Int @default(0)
  aiCompletionTokensCount Int @default(0)
  loyaltyActionCount      Int @default(0)
  loyaltyRewardCount      Int @default(0)
  loyaltyCustomerCount    Int @default(0)
  waAutomationCount       Int @default(0)

  annualMessageCount       Int @default(0)
  monthlySurveyResponses   Int @default(0)
  monthlyWaSurveyResponses Int @default(0)
  monthlyMenuViews         Int @default(0)
  monthlyMessagesCount     Int @default(0)

  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?

  allowedTeams           Int @default(0)
  allowedTeamMembers     Int @default(0)
  allowedSurveys         Int @default(0)
  allowedSurveyResponses Int @default(0)
  allowedMenus           Int @default(0)
  allowedMenuViews       Int @default(0)
  allowedMessagesCount   Int @default(0)

  annualTemplateMessageCount  Int @default(0)
  monthlyTemplateMessageCount Int @default(0)
  templateMessagesCount       Int @default(0)

  monthlyAutomationTriggerCount Int @default(0)

  lastMonthlyResettedDate DateTime? @db.Date()
}

enum StageCategory {
  active
  won
  lost
}

model Lifecycle {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  ordering    Int           @default(0)
  isDefault   Boolean       @default(false)
  category    StageCategory
  emoji       String
  description String
  isWon       Boolean       @default(false)
  color       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]

  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String? @db.Uuid
}

model WhatsappSettings {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String @db.Uuid

  accessToken      String // encrypted
  accessToken_iv   String?
  wabaId           String? // WhatsApp Business Account ID
  phoneId          String? @unique
  phone            String? @unique
  appId            String
  webhookPassword  String?
  fbPageId         String? @unique //Facebook Page ID
  ibaId            String? @unique //Instagram Business Account ID
  pageAccessToken  String? //Facebook Page access token
  igUserName       String?
  igDisplayName    String?
  phoneDisplayName String?

  type             String // enums.ts: WaConfigType
  createdAt        DateTime           @default(now())
  /// [PWaEncryptionKeys]
  encryption       Json? // for flow {publicKey: string, privateKey: string}
  Campaign         Campaign[]
  LoyaltyWaCommand LoyaltyWaCommand[]
  metaAssets       MetaAssets[]
  catalog          CatalogPhoneIdMap?
  assets           String[]           @default([]) //enum.ts MetaLoginAssets (assets selected on login)
  teams            Team[]
}

model Rule {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id])
  orgId String @db.Uuid

  name                     String
  operator                 RuleOperator @default(AND) // AND / OR
  isActive                 Boolean      @default(true)
  triggerEvent             TriggerEvent
  whatsappSettingsPhoneIds String[]     @default([]) //for multiple whatsapp integration
  options                  Json? // Stores sendOncePerDay and businessHours configuration

  groups  RuleConditionGroup[]
  actions RuleAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, orgId], name: "rule_name_org_id_unique")
}

enum RuleOperator {
  AND
  OR
}

model RuleConditionGroup {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rule   Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId String @db.Uuid

  operator   RuleOperator    @default(AND)
  conditions RuleCondition[]
}

model RuleCondition {
  id      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group   RuleConditionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String             @db.Uuid

  field           ConditionField
  operator        ConditionOperator
  value           String? // 'order', '@gmail.com', 'yes', etc.
  messageBodyLock RuleMessageBodyLock?
}

enum ConditionField {
  MESSAGE_BODY
  CONTACT_EMAIL
  // ELAPSED_TIME
  CONTACT_GROUP
  CONTACT_LABEL
  CONTACT_LIFECYCLE
}

enum ConditionOperator {
  CONTAINS
  EQUALS
  STARTS_WITH
  ENDS_WITH
}

enum TriggerEvent {
  MESSAGE_RECEIVED
  CHAT_CLOSED
  CHAT_ASSIGNED
  CONTACT_CREATED
  LIFECYCLE_UPDATED
}

model RuleAction {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rule   Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId String @db.Uuid

  type  ActionType
  value Json? // userId, labelId, message text, templateId, etc.
}

enum ActionType {
  CLOSE_TICKET
  ATTACH_LABEL
  ASSIGN_USER
  ASSIGN_TEAM
  ASSIGN_LIFECYCLE
  SEND_MESSAGE
  SEND_TEMPLATE
  SEND_FLOW
  TRIGGER_CHATBOT
}

model WaAccountSettings {
  org              Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId            String   @unique @db.Uuid
  contactTags      String[] @default([])
  contactGroupTags String[] @default([])
}

model WaLogs {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  phone     String?
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String   @db.Uuid
  logs      Json[]
}

model OrgMember {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt           DateTime             @default(now())
  org                 Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId               String               @db.Uuid
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String               @db.Uuid
  role                Role
  status              String               @default("online")
  notifications       Notification[]
  notificationSetting NotificationSetting?

  @@unique([userId, orgId], name: "userId_orgId")
}

model Team {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime @default(now())
  name            String
  code            String
  color           String   @default("blue")
  googleLink      String?
  reviewPageLinks Json?
  tags            String[] @default([])

  org                    Org                               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId                  String                            @db.Uuid
  members                TeamMember[]
  surveys                SurveyTeamMap[]
  invitations            Invitation[]
  contactGroups          ContactGroup[]
  menu                   Menu[]
  campaigns              Campaign[]
  reviewSuggestions      ReviewSuggestion[]
  Review                 Review[]
  RM_Topic               RM_Topic[]
  testimonialCollections TestimonialCollection[]
  Ticket                 Ticket[]
  waInboxAssign          WaInboxAssign[]
  ticketBoards           TicketBoardTeam[]
  assignedConversations  ConversationAssignedUserTeamMap[]
  whatsappChannels       WhatsappSettings[]

  @@unique([name, orgId], name: "team_name_org_id_unique")
  @@unique([code, orgId], name: "team_code_org_id_unique")
}

model TeamMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
}

model Invitation {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  name      String
  type      InviteType
  org       Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String       @db.Uuid
  team      Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String?      @db.Uuid
  invitedBy String
  createdAt DateTime     @default(now())
  status    InviteStatus @default(PENDING)

  @@unique([email, teamId], name: "team_id_email_unique")
}

model Survey {
  id                                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                         DateTime          @default(now())
  updatedAt                         DateTime?         @updatedAt
  title                             String
  description                       String?           @default("")
  /// [PQuestion]
  questions                         Json[]            @default([])
  languages                         String[]
  user                              User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdBy                         String            @db.Uuid
  teams                             SurveyTeamMap[]
  active                            Boolean           @default(true)
  isPublished                       Boolean           @default(false)
  isProtected                       Boolean           @default(false)
  kioskMode                         Boolean           @default(false)
  uniqueDeviceResponse              Boolean           @default(false) //avoid duplicate entry from same IP
  password                          String?
  type                              String            @default("web")
  getLocation                       Boolean           @default(false)
  welcomePageEnabled                Boolean           @default(true)
  tags                              String[]          @default([])
  skipPreview                       Boolean           @default(true)
  enableNotificationEmail           Boolean           @default(false)
  notificationEmail                 String            @default("")
  enableTickets                     Boolean           @default(false)
  enableTicketEmailAlerts           Boolean           @default(false)
  enableAutoGenerateTicket          Boolean           @default(false)
  ticketBoardId                     String?
  ticketColumnId                    String?
  enableTicketWaMessageAlerts       Boolean           @default(false)
  webSurveyAutoTransitionToNextQues Boolean           @default(true)
  shareSettings                     Json?
  publicKey                         String?
  isEncrypted                       Boolean           @default(false)
  surveyTheme                       SurveyTheme?
  webSurveyThemeId                  String?           @db.Uuid
  webSurveyTheme                    WebSurveyTheme?   @relation(fields: [webSurveyThemeId], references: [id])
  webSurveyPagesTheme               Json?             @default("{}")
  WaFlow                            WaFlow?
  spreadSheetId                     String?
  redirect                          Json              @default("{\"url\": \"/\",\"time\": \"5\" }")
  org                               Org?              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId                             String?           @db.Uuid
  surveyVariables                   SurveyVariables[]
  surveyPublishAt                   DateTime?
  surveyEndAt                       DateTime?
  uiTextTranslations                Json?             @default("{\"nextBtn\": { \"english\": \"Next\"}, \"submitBtn\": { \"english\": \"Submit\" }}")
  responseWebhookEndpoint           String?
  sendWeeklyReport                  Boolean           @default(true)
  ///[ResponseSummary[]]
  aiResponseSummary                 Json[]
}

model SurveyTeamMap {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId          String              @db.Uuid
  teamId            String              @db.Uuid
  shortUrlId        String?             @unique
  survey            Survey              @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  team              Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  responses         SurveyResponse[]
  sessions          WaSession[]
  surveyStats       SurveyStats?
  menuLanding       MenuLanding[]
  waMessageSchedule WaMessageSchedule[]

  @@unique([surveyId, teamId], name: "survey_team_unique")
}

//this is the model for grouped surveys
model SurveyLanding {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt
  title              String
  header             String    @default("")
  description        String?   @default("")
  surveys            String[]
  createdBy          String    @db.Uuid
  welcomePageEnabled Boolean   @default(true)
}

model SurveyResponse {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime         @default(now())
  surveyTeamMap      SurveyTeamMap    @relation(fields: [surveyTeamMapId], references: [id], onDelete: Cascade)
  surveyTeamMapId    String           @db.Uuid
  /// [PQuestionResponse]
  responses          Json[]           @default([])
  encryptedResponses String?
  language           String           @default("")
  platform           ResponsePlatform @default(WEB)
  tag                String?          @default("")

  ip                   String?
  location             Json? // { 
  //                      coordinates: {latitude: number, longitude: number},
  //                      city: string, state: string, country: string
  //                    }
  deviceData           Json?
  Contact              Contact?              @relation(fields: [contactId], references: [id])
  contactId            String?               @db.Uuid
  CampaignParticipants CampaignParticipant[]
  Testimonial          Testimonial[]
  Ticket               Ticket[]
  ticketCards          TicketCard[]
}

model SurveyStats {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyTeamMap     SurveyTeamMap @relation(fields: [surveyTeamMapId], references: [id], onDelete: Cascade)
  surveyTeamMapId   String        @unique @db.Uuid
  visited           Int           @default(0)
  started           Int           @default(0)
  completed         Int           @default(0)
  reviewLinkVisited Int           @default(0)
}

// Whatsapp session
model WaSession {
  id                             String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                      DateTime                      @default(now())
  phone                          String
  surveyTeamMap                  SurveyTeamMap?                @relation(fields: [surveyTeamMapId], references: [id])
  surveyTeamMapId                String?                       @db.Uuid
  template                       WaTemplate?                   @relation(fields: [templateId], references: [id])
  templateId                     String?                       @db.Uuid
  currentQuestionId              String?
  campaignParticipant            CampaignParticipant?          @relation(fields: [campaignParticipantId], references: [id])
  campaignParticipantId          String?                       @unique @db.Uuid
  CampaignParticipantDripStage   CampaignParticipantDripStage? @relation(fields: [campaignParticipantDripStageId], references: [id])
  campaignParticipantDripStageId String?                       @db.Uuid

  /// [PQuestionResponse]
  responses Json[]
  language  String  @default("")
  orgId     String  @db.Uuid
  ip        String?
  type      String  @default("survey") // WaSessionType
  tag       String? @default("")

  @@unique([phone, orgId])
}

model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  name   String?
  phone  String?
  source String?

  org                          Org                       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId                        String                    @db.Uuid
  responses                    SurveyResponse[]
  contactGroups                ContactGroupMap[]
  campaignParticipants         CampaignParticipant[]
  tags                         Json?
  WaMessage                    WaMessage[]
  consent                      Boolean                   @default(true)
  email                        String?
  dob                          DateTime?
  external_id                  String?
  aiWaChat                     Boolean                   @default(false)
  isAiBotActive                Boolean                   @default(false)
  chatbotId                    String                    @default("")
  waMessageAssignStatus        String                    @default("UNASSIGNED")
  waInboxAssign                WaInboxAssign[]
  lastReceivedMessageTimeStamp DateTime?
  whatsappUserName             String? //whatsapp or instagram username
  blockedOnWhatsApp            Boolean                   @default(false)
  waCatalogOrders              WaCatalogOrder[]
  igsId                        String? //Instagram Scoped User ID
  profilePic                   String?
  followerCount                Int?
  isIgVerifiedUser             Boolean?
  other                        String?
  Lifecycle                    Lifecycle?                @relation(fields: [lifecycleId], references: [id])
  lifecycleId                  String?                   @db.Uuid
  customFields                 ContactCustomFieldValue[]
  closedAt                     DateTime?
  closedBy                     String?                   @db.Uuid
  closedByUser                 User?                     @relation(fields: [closedBy], references: [id])

  lastMessageBody             Json?
  lastMessageWaCreatedAt      DateTime?
  lastMessagePlatform         String?
  lastReceivedMetadata        Json?
  lastMessageSourceIdentifier String?
  lastSentMessageTimeStamp    DateTime?
  ContactLabelMap             ContactLabelMap[]
  notes                       String?
  Conversations               Conversation[]
  loyaltyAccounts             CustomerLoyaltyAccount[]

  @@unique([external_id, orgId], name: "external_id_org_id_unique")
  @@unique([phone, orgId], name: "contact_phone_org_id_unique")
  @@unique([igsId, orgId], name: "contact_igsid_org_id_unique")
  @@index([orgId])
  @@index([orgId, id])
  @@index([orgId, waMessageAssignStatus])
  @@index([lastReceivedMessageTimeStamp])
  @@index([orgId, waMessageAssignStatus, lastReceivedMessageTimeStamp(sort: Desc)])
  @@index([orgId, blockedOnWhatsApp, lastReceivedMessageTimeStamp(sort: Desc)])
  @@index([orgId, lifecycleId])
  @@index([name])
}

model ContactLabel {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  color       String?  @default("#3b82f6")
  description String?
  createdAt   DateTime @default(now())
  orgId       String   @db.Uuid
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  contactLabels ContactLabelMap[]

  @@unique([name, orgId], name: "label_name_org_id_unique")
  @@index([orgId])
}

model ContactLabelMap {
  contactId String  @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  labelId String       @db.Uuid
  label   ContactLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([contactId, labelId])
  @@index([contactId])
  @@index([labelId])
}

model ContactCustomField {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org         Org                       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String                    @db.Uuid
  slug        String // e.g. tag.toLowerCase().replace(/\s+/g, "_")
  name        String // Display name
  description String?
  visibility  Boolean                   @default(true)
  type        String // e.g. number, string, date
  createdAt   DateTime                  @default(now())
  listValues  String[]                  @default([])
  values      ContactCustomFieldValue[]
}

model ContactCustomFieldValue {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String  @db.Uuid

  field   ContactCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId String             @db.Uuid

  value     String // store as string; parse based on field.type
  createdAt DateTime @default(now())
}

model WaInboxAssign {
  contactId      String  @db.Uuid
  contact        Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUserId String  @db.Uuid
  assignedUser   User    @relation(fields: [assignedUserId], references: [id], onDelete: Cascade)
  teamId         String  @db.Uuid
  Team           Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([contactId, assignedUserId], name: "contact_id_assigned_user_id_unique")
  @@index([contactId, assignedUserId])
  @@index([contactId, teamId])
  @@index([assignedUserId])
  @@index([teamId])
}

model UserAssignedCount {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  orgId       String   @db.Uuid
  assignCount Int      @default(0)
  createdAt   DateTime @default(now())
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId], name: "user_org_unique")
}

