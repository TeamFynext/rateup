// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// for having typed Json fields
// TODO: remove this when prisma allows types for Json
generator json {
  provider  = "prisma-json-types-generator"
  namespace = "PrismaJson"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  // can access all the team
  // can access only to the teams they are member of
  SUPER_ADMIN
  ADMIN
  //can access only team based survey responses, stats
  MEMBER
}

enum TeamFeature {
  inbox
  analytics
  contacts
  campaigns
  flows
  chatbots
  templates
  automation
  loyalty
  web_forms
  tickets
  qr_studio
  ai_chatbot
  apps_services
  settings
}

enum InviteStatus {
  // initial
  PENDING
  // accept invite
  ACCEPTED
  // decline invite
  DECLINED
}

enum InviteType {
  ORG
  TEAM
}

enum ResponsePlatform {
  WEB
  WHATSAPP
  APP
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserRecipes {
  EmailPassword
  ThirdPartyGoogle
  PasswordLess
  ThirdPartyApple
}

enum TemplateType {
  GENERAL_NOTIFICATION
  ORDER_DETAILS
  PAYMENT_CONFIRMATION
  LOYALTY
  CAROUSEL
}

enum ContactGroupType {
  NORMAL
  LOYALTY
}

enum UserPresenceMode {
  automatic
  manual
}

enum CustomerRewardStatus {
  ISSUED
  REDEEMED
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  createdAt      DateTime         @default(now())
  email          String           @unique
  name           String?
  profilePhoto   String?
  phone          String?
  active         Boolean          @default(true)
  gender         Gender?
  recipeName     UserRecipes?
  isPaused       Boolean?         @default(false)
  pausedBy       String?
  prefLanguage   String?          @default("English")
  deletedAt      DateTime?
  lastLoggedInAt DateTime?
  presenceMode   UserPresenceMode @default(automatic)

  org                         Org[]
  orgMember                   OrgMember[]
  teamMember                  TeamMember[]
  surveys                     Survey[]
  Order                       Order[]
  assignedTicket              Ticket[]                          @relation("AssignedTicket")
  createdTicket               Ticket[]                          @relation("CreatedTicket")
  TicketComment               TicketComment[]
  linktree                    Linktree[]
  generateQr                  GenerateQr[]
  WaMessage                   WaMessage[]
  waInboxAssign               WaInboxAssign[]
  ticketActivity              TicketActivity[]
  assignedTicketCards         TicketCardAssignee[]
  assignedBoards              TicketBoardNotification[]
  expoPushTokens              ExpoPushToken[]
  // Add relation for WaAutomatedReply many-to-many
  UserAssignedCount           UserAssignedCount[]
  AuditLog                    AuditLog[]
  LastClosedContacts          Contact[]
  ClosedConversations         Conversation[]
  AssignedConversations       ConversationAssignedUserTeamMap[] @relation("ConversationAssignedUser")
  removedAssignees            ConversationAssignedUserTeamMap[] @relation("ConversationRemovedUser")
  assignedStafftoConversation ConversationAssignedUserTeamMap[] @relation("ConversationAssignedByUser")
  inboxMentions               InboxMention[]
}

model Org {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                DateTime @default(now())
  name                     String
  owner                    User     @relation(fields: [ownerId], references: [id])
  ownerId                  String   @db.Uuid
  logo                     String?
  phone                    String?
  address                  String?
  encryptionKeys           Json? //{privateKey:string,publicKey:string}
  isPaused                 Boolean? @default(false)
  waAssignedChatPermission String   @default("All")

  onboarding          Json?
  onboardingCompleted Boolean @default(false)

  showLifecycle Boolean @default(true)

  isConversionApiActive        Boolean @default(false)
  onboardingChecklist          Json?
  onboardingChecklistCompleted Boolean @default(false)

  deletionMailSent DateTime?

  members                  OrgMember[]
  teams                    Team[]
  invitations              Invitation[]
  templates                WaTemplate[]
  Subscription             Subscription?
  Order                    Order[]
  WaFlow                   WaFlow[]
  contacts                 Contact[]
  linktree                 Linktree[]
  ApiAccessToken           ApiAccessToken?
  surveyThemes             WebSurveyTheme[]
  UsageStats               UsageStats?
  chatbot                  Chatbot[]
  Survey                   Survey[]
  WaAccountSettings        WaAccountSettings?
  generateQr               GenerateQr[]
  Integration              Integration[]
  waMessageSchedule        WaMessageSchedule[]
  loyaltyProgram           LoyaltyProgram?
  loyaltyTemplates         LoyaltyWaCommand[]
  WaAutomatedReplyMessage  WaAutomatedReplyMessage[]
  WaAutomatedReply         WaAutomatedReply[]
  whatsappQuickReplies     WhatsappQuickReply[]
  loyaltyApiSettings       LoyaltyApiSettings[]
  expoPushTokens           ExpoPushToken[]
  WhatsappSettings         WhatsappSettings[]
  metaBusinessAgents       MetaBusinessAgent[]
  WaCatalog                WhatsappCatalog[]
  productSets              WhatsappProductSet[]
  UserAssignedCount        UserAssignedCount[]
  Lifecycle                Lifecycle[]
  ContactCustomField       ContactCustomField[]
  AuditLog                 AuditLog[]
  ContactLabel             ContactLabel[]
  businessHours            BusinessHour[]
  rules                    Rule[]
  ruleMessageBodyLocks     RuleMessageBodyLock[]
  waMessageOrgTeamMaps     WaMessageOrgTeamMap[]
  Webhook                  Webhook?
  inboxAutomations         InboxAutomation[]
  inboxStats               InboxStats?
  inboxMentions            InboxMention[]
  conversationTags         ConversationTag[]
}

model UsageStats {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String   @unique @db.Uuid

  teamsCount              Int @default(0)
  teamMembersCount        Int @default(0)
  surveysCount            Int @default(0)
  surveyResponsesCount    Int @default(0)
  waSurveysCount          Int @default(0)
  waSurveyResponsesCount  Int @default(0)
  messagesCount           Int @default(0)
  aiPromptTokensCount     Int @default(0)
  aiCompletionTokensCount Int @default(0)
  loyaltyActionCount      Int @default(0)
  loyaltyRewardCount      Int @default(0)
  loyaltyCustomerCount    Int @default(0)
  waAutomationCount       Int @default(0)

  annualConversationsCount  Int @default(0)
  monthlySurveyResponses    Int @default(0)
  monthlyWaSurveyResponses  Int @default(0)
  monthlyConversationsCount Int @default(0)

  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?

  allowedTeams           Int @default(0)
  allowedTeamMembers     Int @default(0)
  allowedSurveys         Int @default(0)
  allowedSurveyResponses Int @default(0)
  allowedMessagesCount   Int @default(0)

  annualTemplateMessageCount  Int @default(0)
  monthlyTemplateMessageCount Int @default(0)
  templateMessagesCount       Int @default(0)

  monthlyAutomationTriggerCount Int @default(0)

  lastMonthlyResettedDate DateTime? @db.Date()
}

enum StageCategory {
  active
  won
  lost
}

model Lifecycle {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  ordering    Int           @default(0)
  isDefault   Boolean       @default(false)
  category    StageCategory
  emoji       String
  description String
  isWon       Boolean       @default(false)
  color       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]

  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String? @db.Uuid
}

model WhatsappSettings {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String @db.Uuid

  accessToken              String // encrypted
  accessToken_iv           String?
  wabaId                   String? // WhatsApp Business Account ID
  phoneId                  String? @unique
  phone                    String? @unique
  appId                    String
  webhookPassword          String?
  fbPageId                 String? @unique //Facebook Page ID
  ibaId                    String? @unique //Instagram Business Account ID
  pageAccessToken          String? //Facebook Page access token
  igUserName               String?
  igDisplayName            String?
  /// [PInstagramIceBreakers]
  instagramIceBreakers     Json?
  /// [PInstagramPersistentMenu]
  instagramPersistentMenu  Json?
  conversationalAutomation Json?
  phoneDisplayName         String?

  fbUserName String?

  type                    String // enums.ts: WaConfigType
  status                  String                @default("ACTIVE")
  createdAt               DateTime              @default(now())
  /// [PWaEncryptionKeys]
  encryption              Json? // for flow {publicKey: string, privateKey: string}
  WaTemplate              WaTemplate[]
  LoyaltyWaCommand        LoyaltyWaCommand[]
  metaAssets              MetaAssets[]
  catalog                 CatalogPhoneIdMap?
  assets                  String[]              @default([]) //enum.ts MetaLoginAssets (assets selected on login)
  conversionsApiDatasetId String?
  /// [PMetaConversionSettings]
  conversionData          Json?
  paymentMethod           String                @default("NATIVE") // NATIVE, SHOPIFY_LINK
  metaBusinessAgent       MetaBusinessAgent?
  teamAccess              TeamWhatsappChannel[] // teams explicitly granted this channel
  waFlows                 WaFlow[] // flows created under this channel's WABA
}

model MetaBusinessAgent {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String @db.Uuid

  whatsappSettings   WhatsappSettings @relation(fields: [whatsappSettingsId], references: [id], onDelete: Cascade)
  whatsappSettingsId String           @unique @db.Uuid

  agentId              String? // Meta-assigned agent id, returned by agent_onboarding
  channel              String    @default("whatsapp")
  isEligible           Boolean?
  eligibilityCheckedAt DateTime?
  status               String    @default("NOT_ONBOARDED") // NOT_ONBOARDED, ONBOARDED, DISABLED

  // agent_config/settings, cached locally, pushed to Meta on save
  rolloutEnabled          Boolean?
  handoffEnabled          Boolean?
  handoffMessage          String?
  followupEnabled         Boolean?
  followupIntervalSeconds Int?
  followupMessage         String?
  aiAudience              String? // EVERYONE, ALLOWLISTED_ONLY
  neverSayPhrases         String[]  @default([])
  settingsSyncedAt        DateTime?

  // agent_config/business_info, cached locally
  /// [PMetaAgentBusinessInfo]
  businessInfo         Json?
  businessInfoSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allowlist  MetaAgentAllowlistEntry[]
  faqs       MetaAgentFaq[]
  files      MetaAgentFile[]
  websites   MetaAgentWebsite[]
  skills     MetaAgentSkill[]
  uiSkills   MetaAgentUiSkill[]
  connectors MetaAgentConnector[]
}

model MetaAgentAllowlistEntry {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent   MetaBusinessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String            @db.Uuid

  metaId              String? // id returned by Meta, null until synced
  consumerPhoneNumber String

  createdAt DateTime @default(now())
}

model MetaAgentFaq {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent   MetaBusinessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String            @db.Uuid

  metaId   String?
  question String
  answer   String
  /// [PMetaAgentFaqMetadata]
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MetaAgentFile {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent   MetaBusinessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String            @db.Uuid

  metaId   String?
  fileName String

  createdAt DateTime @default(now())
}

model MetaAgentWebsite {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent   MetaBusinessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String            @db.Uuid

  metaId        String?
  url           String
  crawlStatus   String?
  pagesCrawled  Int?
  lastCrawledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MetaAgentSkill {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent   MetaBusinessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String            @db.Uuid

  metaId      String?
  title       String
  description String
  skill       String
  channel     String? // channel Meta filed the skill under, returned on read
  /// [PMetaAgentSkillMetadata]
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// agent-ui-skills — the rich WhatsApp components (carousels, CTAs, flows) the
/// agent is allowed to send. A separate Meta endpoint from `agent_config/skills`.
model MetaAgentUiSkill {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent   MetaBusinessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String            @db.Uuid

  metaId        String?
  title         String
  componentType String // carousel_quick_reply, carousel_url, cta_url, flow, image, interactive_list, location, location_request
  status        String  @default("enabled") // enabled, disabled
  instruction   String
  // Meta types this as an integer, but flow ids run to 16 digits — kept as text
  // so nothing rounds on the way through, and parsed at the Meta boundary.
  flowId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MetaAgentConnector {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent   MetaBusinessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String            @db.Uuid

  metaId              String?
  name                String
  description         String
  baseUrl             String
  authType            String  @default("NONE") // OAUTH2_CLIENT_CREDENTIALS, OAUTH2, API_KEY, BASIC, CUSTOM, NONE
  requiresCertificate Boolean @default(false)
  connectionStatus    String  @default("PENDING_OAUTH") // PENDING_OAUTH, ACTIVE, EXPIRED, ERROR
  // Meta returns connection_status as an object; the failure reason rides along
  // with the status and is the only thing that explains an ERROR to the user.
  connectionError     String?

  /// [PMetaAgentUserAuthInjectionConfig]
  userAuthInjectionConfig Json?
  /// Non-secret mTLS metadata Meta echoes back (fingerprint, subject, expiry).
  /// [PMetaAgentMtlsConfig]
  mtlsConfig              Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tools MetaAgentConnectorTool[]
}

model MetaAgentConnectorTool {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connector   MetaAgentConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  connectorId String             @db.Uuid

  metaId            String?
  name              String
  description       String
  /// [PMetaAgentRequestDefinition]
  requestDefinition Json
  userAuthRequired  Boolean @default(false)
  /// How to pull tokens out of an auth/refresh call's response.
  /// [PMetaAgentUserAuthActionConfig]
  userAuthActionConfig Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rule {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id])
  orgId String @db.Uuid

  name                     String
  platform                 RulePlatform @default(WHATSAPP)
  operator                 RuleOperator @default(AND) // AND / OR
  isActive                 Boolean      @default(true)
  triggerEvent             TriggerEvent
  whatsappSettingsPhoneIds String[]     @default([]) //for multiple whatsapp integration
  /// [PWaRuleOptions]
  options                  Json? // Stores sendOncePerDay and businessHours configuration

  groups  RuleConditionGroup[]
  actions RuleAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, orgId], name: "rule_name_org_id_unique")
}

enum RulePlatform {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
}

enum RuleOperator {
  AND
  OR
}

model RuleConditionGroup {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rule   Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId String @db.Uuid

  operator   RuleOperator    @default(AND)
  conditions RuleCondition[]
}

model RuleCondition {
  id      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group   RuleConditionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String             @db.Uuid

  field           ConditionField
  operator        ConditionOperator
  value           String? // 'order', '@gmail.com', 'yes', etc.
  messageBodyLock RuleMessageBodyLock?
}

enum ConditionField {
  MESSAGE_BODY
  CONTACT_EMAIL
  // ELAPSED_TIME
  CONTACT_GROUP
  CONTACT_LABEL
  CONTACT_LIFECYCLE
}

enum ConditionOperator {
  CONTAINS
  EQUALS
  STARTS_WITH
  ENDS_WITH
}

enum TriggerEvent {
  MESSAGE_RECEIVED
  CHAT_CLOSED
  CHAT_ASSIGNED
  CONTACT_CREATED
  LIFECYCLE_UPDATED
  SHOPIFY_EVENT
  INSTAGRAM_COMMENT
  INSTAGRAM_STORY_MENTION
}

model RuleAction {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rule   Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId String @db.Uuid

  type  ActionType
  value Json? // userId, labelId, message text, templateId, etc.
}

enum ActionType {
  CLOSE_TICKET
  ATTACH_LABEL
  ASSIGN_USER
  ASSIGN_TEAM
  ASSIGN_LIFECYCLE
  SEND_MESSAGE
  SEND_WEB_SURVEY
  SEND_TEMPLATE
  SEND_FLOW
  TRIGGER_CHATBOT
  CALL_EXTERNAL_API
}

model WaAccountSettings {
  org              Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId            String   @unique @db.Uuid
  contactTags      String[] @default([])
  contactGroupTags String[] @default([])
}

model OrgMember {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt           DateTime             @default(now())
  org                 Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId               String               @db.Uuid
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String               @db.Uuid
  role                Role
  status              String               @default("online")
  notifications       Notification[]
  notificationSetting NotificationSetting?

  @@unique([userId, orgId], name: "userId_orgId")
}

model Team {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime @default(now())
  name            String
  code            String
  color           String   @default("blue")
  googleLink      String?
  reviewPageLinks Json?
  tags            String[] @default([])

  org           Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId         String          @db.Uuid
  members       TeamMember[]
  surveys       SurveyTeamMap[]
  invitations   Invitation[]
  contactGroups ContactGroup[]

  campaigns              Campaign[]
  reviewSuggestions      ReviewSuggestion[]
  Review                 Review[]
  RM_Topic               RM_Topic[]
  testimonialCollections TestimonialCollection[]
  Ticket                 Ticket[]
  waInboxAssign          WaInboxAssign[]
  ticketBoards           TicketBoardTeam[]
  assignedConversations  ConversationAssignedUserTeamMap[]
  waMessageOrgTeamMaps   WaMessageOrgTeamMap[]
  waMessageSchedule      WaMessageSchedule[]
  featureAccess          TeamFeatureAccess[]

  /// When true the team reaches every channel in the org, including ones connected later.
  /// When false access is limited to `channelAccess`. Defaults to true so new teams —
  /// and every team existing at rollout — keep full access until scoped explicitly.
  allChannels   Boolean               @default(true)
  channelAccess TeamWhatsappChannel[]

  @@unique([name, orgId], name: "team_name_org_id_unique")
  @@unique([code, orgId], name: "team_code_org_id_unique")
}

model TeamFeatureAccess {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String      @db.Uuid
  feature   TeamFeature
  createdAt DateTime    @default(now())

  @@unique([teamId, feature])
}

/// Grants one team access to one channel. Only consulted while `Team.allChannels` is false —
/// when that flag is true the team reaches every channel and these rows are cleared.
model TeamWhatsappChannel {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String           @db.Uuid
  channel   WhatsappSettings @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String           @db.Uuid
  createdAt DateTime         @default(now())

  @@unique([teamId, channelId])
  @@index([channelId])
}

model TeamMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
}

model Invitation {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  name      String
  type      InviteType
  org       Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String       @db.Uuid
  team      Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String?      @db.Uuid
  invitedBy String
  createdAt DateTime     @default(now())
  status    InviteStatus @default(PENDING)

  @@unique([email, teamId], name: "team_id_email_unique")
}

model Survey {
  id                                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                         DateTime          @default(now())
  updatedAt                         DateTime?         @updatedAt
  title                             String
  description                       String?           @default("")
  /// [PQuestion]
  questions                         Json[]            @default([])
  languages                         String[]
  user                              User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdBy                         String            @db.Uuid
  teams                             SurveyTeamMap[]
  active                            Boolean           @default(true)
  isPublished                       Boolean           @default(false)
  isProtected                       Boolean           @default(false)
  kioskMode                         Boolean           @default(false)
  uniqueDeviceResponse              Boolean           @default(false) //avoid duplicate entry from same IP
  password                          String?
  type                              String            @default("web")
  getLocation                       Boolean           @default(false)
  welcomePageEnabled                Boolean           @default(true)
  tags                              String[]          @default([])
  skipPreview                       Boolean           @default(true)
  enableNotificationEmail           Boolean           @default(false)
  notificationEmail                 String            @default("")
  enableTickets                     Boolean           @default(false)
  enableTicketEmailAlerts           Boolean           @default(false)
  enableAutoGenerateTicket          Boolean           @default(false)
  ticketBoardId                     String?
  ticketColumnId                    String?
  enableTicketWaMessageAlerts       Boolean           @default(false)
  webSurveyAutoTransitionToNextQues Boolean           @default(true)
  shareSettings                     Json?
  publicKey                         String?
  isEncrypted                       Boolean           @default(false)
  surveyTheme                       SurveyTheme?
  webSurveyThemeId                  String?           @db.Uuid
  webSurveyTheme                    WebSurveyTheme?   @relation(fields: [webSurveyThemeId], references: [id])
  webSurveyPagesTheme               Json?             @default("{}")
  WaFlow                            WaFlow?
  spreadSheetId                     String?
  redirect                          Json              @default("{\"url\": \"/\",\"time\": \"5\" }")
  org                               Org?              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId                             String?           @db.Uuid
  surveyVariables                   SurveyVariables[]
  surveyPublishAt                   DateTime?
  surveyEndAt                       DateTime?
  uiTextTranslations                Json?             @default("{\"nextBtn\": { \"english\": \"Next\"}, \"submitBtn\": { \"english\": \"Submit\" }}")
  responseWebhookEndpoint           String?
  sendWeeklyReport                  Boolean           @default(true)
  ///[ResponseSummary[]]
  aiResponseSummary                 Json[]
}

model SurveyTeamMap {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId    String           @db.Uuid
  teamId      String           @db.Uuid
  shortUrlId  String?          @unique
  survey      Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  responses   SurveyResponse[]
  sessions    WaSession[]
  surveyStats SurveyStats?

  waMessageSchedule WaMessageSchedule[]

  @@unique([surveyId, teamId], name: "survey_team_unique")
}

//this is the model for grouped surveys
model SurveyLanding {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt
  title              String
