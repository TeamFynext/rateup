  isAmountBased                 Boolean                    @default(false)
  isAmountBasedForReferee       Boolean                    @default(false)
  amount                        Float                      @default(0)
  maxPoints                     Int? //Max points per transaction   
  maxPointsForReferee           Int?
  startDate                     DateTime
  endDate                       DateTime
  createdAt                     DateTime                   @default(now())
  orgId                         String                     @db.Uuid
  org                           Org                        @relation(fields: [orgId], references: [id], onDelete: Cascade)
