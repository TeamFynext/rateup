/// Storage vocabulary for inbox status. Mirrored between `Contact.waMessageAssignStatus`
/// (live-inbox source of truth) and `Conversation.status`. "NEW" is a derived UI tab
/// (unassigned + recent) and "BLOCKED" is `Contact.blockedOnWhatsApp`; neither is stored here.
///
/// SPAM is DEPRECATED as a stored status — spam moved onto the contact
/// (`Contact.isSpam`) and a spam ticket is now simply CLOSED with
/// `closeReason = SPAM`. The value is kept only so pre-migration rows and the
/// internal-message event vocabulary still parse; never write it.
enum InboxStatus {
  UNASSIGNED
  ASSIGNED
  CLOSED
  SPAM
  RESOLVED
  UNRESOLVED
}

enum CloseReason {
  MANUAL
  AUTOMATION_IDLE
  RULE
  SPAM
}

/// Resolution *quality* chosen by the agent when closing a conversation/ticket.
/// Distinct from `CloseReason` (which records *why/who* closed it).
enum ResolutionResult {
  RESOLVED
  ANSWERED
  NO_RESPONSE
  DUPLICATE
}

model Conversation {
  id                     String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId              String                            @db.Uuid
  contact                Contact                           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// Denormalized from `Contact.orgId` so analytics can scope by org without joining Contact.
  orgId                  String?                           @db.Uuid
  messages               WaMessage[]
  status                 InboxStatus                       @default(UNASSIGNED)
  firstRespondedAt       DateTime?
  firstRespondedByUserAt DateTime?
  assignedUsers          ConversationAssignedUserTeamMap[]
  assignedAt             DateTime?
  closedAt               DateTime?
  closedBy               String?                           @db.Uuid
  closedByUser           User?                             @relation(fields: [closedBy], references: [id])
  /// Set only when status becomes RESOLVED; `closedAt` covers any terminal state.
  resolvedAt             DateTime?
  closeReason            CloseReason?
  closedByAutomation     Boolean                           @default(false)
  lastMessageAt          DateTime?
  lastCustomerMessageAt  DateTime?
  lastAgentMessageAt     DateTime?
  messageCount           Int                               @default(0)
  reopenCount            Int                               @default(0)
  /// Star flag is per-ticket (per-conversation), not per-contact, so one contact's
  /// tickets can be starred independently.
  isFavorite             Boolean                           @default(false)
  /// Ticket identity for the "Inbox Tickets" UI. `number` is the human-facing #code,
  /// sequential *per org* (each org starts at 1). Never set it from application code:
  /// the `conversation_assign_number` BEFORE INSERT trigger allocates it from
  /// `ConversationNumberCounter`. The `0` default is the "unset" sentinel the trigger
  /// looks for so Prisma can omit the column on create.
  number                 Int                               @default(0)
  subject                String?
  description            String?
  /// Resolution quality set when the conversation is closed with a result.
  resolutionResult       ResolutionResult?
  inboxMentions          InboxMention[]
  /// Conversation-scoped tags. Distinct from `ContactLabel`, which sticks to the
  /// customer across every ticket they ever open.
  tags                   ConversationTagMap[]
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime?                         @updatedAt

  @@unique([orgId, number], name: "conversation_org_id_number_unique")
  @@index([contactId])
  @@index([firstRespondedAt])
  @@index([createdAt])
  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([orgId, lastMessageAt(sort: Desc)])
  @@index([orgId, isFavorite])
}

/// Org-defined vocabulary for tagging a single conversation ("Bug Report",
/// "Escalated", "Follow-up"). The conversation-grained counterpart to
/// `ContactLabel`: a tag describes *this ticket*, a label describes the *customer*
/// and follows them across every ticket they open.
model ConversationTag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  color       String?  @default("#3b82f6")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orgId       String   @db.Uuid
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  conversationTags ConversationTagMap[]

  @@unique([name, orgId], name: "conversation_tag_name_org_id_unique")
  @@index([orgId])
}

model ConversationTagMap {
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  tagId String          @db.Uuid
  tag   ConversationTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([conversationId, tagId])
  @@index([conversationId])
  @@index([tagId])
}

/// Per-org allocator for `Conversation.number`. One row per org; the
/// `conversation_assign_number` trigger bumps `lastNumber` inside the inserting
/// transaction, so concurrent inserts serialize on the counter row instead of
/// racing a `max(number) + 1` read. Conversations with a null `orgId` share the
/// nil-uuid bucket.
model ConversationNumberCounter {
  orgId      String @id @db.Uuid
  lastNumber Int    @default(0)
}

/// Indexable signal for the inbox "@Mentions" filter. One row per (mention, mentioned user).
/// Written when an internal/private note resolves @mentions; `clearedAt` is set once seen.
model InboxMention {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String        @db.Uuid
  org             Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contactId       String        @db.Uuid
  contact         Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId  String?       @db.Uuid
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  mentionedUserId String        @db.Uuid
  mentionedUser   User          @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)
  messageId       String?       @db.Uuid
  createdAt       DateTime      @default(now())
  clearedAt       DateTime?

  @@index([orgId, mentionedUserId, clearedAt])
  @@index([contactId, mentionedUserId, clearedAt])
  @@index([conversationId])
}

