{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
  },
  "include": ["src/**/*.ts","utils/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}