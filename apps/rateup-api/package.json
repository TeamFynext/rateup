{
  "name": "rateup-api",
  "version": "1.2.0",
  "private": true,
  "description": "A scalable API backend for Rateup platform",
  "license": "MIT",
  "author": "Rateup Team",
  "repository": "https://github.com/TeamFynext/rateup-api",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:bullmq": "tsx watch src/workers/bullmq/index.ts",
    "dev:kafka": "tsx watch src/workers/kafka/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:bullmq": "node dist/src/workers/bullmq/index.js",
    "start:kafka": "node dist/src/workers/kafka/index.js",
    "email:dev": "email dev -d src/emails -p 3002",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest --silent",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "backfill:wa-echoes": "tsx scripts/backfill-wa-echoes.ts",
    "staff:add": "tsx scripts/staff-add.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@faker-js/faker": "^10.6.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "^10.1.4",
    "@fastify/swagger": "^9.9.2",
    "@fastify/websocket": "^11.3.4",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@scalar/fastify-api-reference": "^1.74.0",
    "@shopify/shopify-api": "^15.0.1",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.15",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "fastify-raw-body": "^6.0.2",
    "fastify-type-provider-zod": "^7.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.6",
    "google-spreadsheet": "^5.3.0",
    "googleapis": "^186.0.0",
    "hucre": "^1.2.0",
    "immer": "^11.1.21",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "kafkajs": "^2.2.4",
    "libphonenumber-js": "^1.13.15",
    "lodash": "^4.18.1",
    "nanoid": "^6.0.2",
    "nanoid-dictionary": "^5.0.0",
    "nodemailer": "^10.1.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.3",
    "sharp": "^0.35.5",
    "stripe": "^22.6.2",
    "supertokens-node": "^24.0.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/bcrypt": "^6.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/http-errors": "^2.0.5",
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "prisma": "^7.10.1",
    "prisma-json-types-generator": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,js,md,json}": "oxfmt"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@7.10.1": true,
    "protobufjs@7.6.6": true,
    "@ffmpeg-installer/linux-x64@4.1.0": true,
    "@prisma/engines@7.10.1": true
  }
}
