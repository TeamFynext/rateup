{
  "name": "rateup-api",
  "version": "1.2.0",
  "private": true,
  "description": "A scalable API backend for Rateup platform",
  "license": "MIT",
  "author": "Rateup Team",
  "repository": "https://github.com/TeamFynext/rateup-api",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:bullmq": "tsx watch src/workers/bullmq/index.ts",
    "dev:kafka": "tsx watch src/workers/kafka/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:bullmq": "node dist/src/workers/bullmq/index.js",
    "start:kafka": "node dist/src/workers/kafka/index.js",
    "email:dev": "email dev -d src/emails -p 3002",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest --silent",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "recover:campaign-sends": "tsx scripts/recover-unrecorded-campaign-sends.ts",
    "backfill:first-responded": "tsx scripts/backfill-first-responded-at.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/client-sesv2": "^3.1123.0",
    "@aws-sdk/lib-storage": "^3.1123.0",
    "@casl/ability": "^7.0.1",
    "@faker-js/faker": "^10.6.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/websocket": "^11.3.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google-cloud/language": "^8.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/fastify-api-reference": "^1.67.0",
    "@sendgrid/mail": "^8.1.6",
    "@shopify/shopify-api": "^14.0.1",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.4",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1",
    "fastify-raw-body": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.6",
    "google-spreadsheet": "^5.3.0",
    "googleapis": "^178.0.0",
    "hucre": "^1.1.0",
    "immer": "^11.1.18",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "libphonenumber-js": "^1.13.12",
    "lodash": "^4.18.1",
    "nanoid": "^6.0.1",
    "nanoid-dictionary": "^5.0.0",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.9.3",
    "sharp": "^0.35.4",
    "stripe": "^22.6.0",
    "supertokens-node": "^24.0.3",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/bcrypt": "^6.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/http-errors": "^2.0.5",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ws": "^8.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "prisma": "^7.10.0",
    "prisma-json-types-generator": "^5.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,js,md,json}": "oxfmt"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@7.10.0": true,
    "protobufjs@7.6.6": true,
    "@ffmpeg-installer/linux-x64@4.1.0": true,
    "@prisma/engines@7.10.0": true
  }
}
