    "libphonenumber-js": "^1.13.15",
    "lodash": "^4.18.1",
    "nanoid": "^6.0.2",
    "nanoid-dictionary": "^5.0.0",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
