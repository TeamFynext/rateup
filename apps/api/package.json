{
  "name": "@rateup/api",
  "version": "2.0.0",
  "private": true,
  "description": "RateUp HTTP API (Fastify).",
  "license": "MIT",
  "author": "Rateup Team",
  "repository": "https://github.com/TeamFynext/rateup-api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest --silent",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "backfill:wa-echoes": "tsx --conditions=source scripts/backfill-wa-echoes.ts",
    "staff:add": "tsx --conditions=source scripts/staff-add.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/formbody": "^9.0.1",
    "@fastify/swagger": "^9.9.3",
    "@fastify/websocket": "^11.3.7",
    "@rateup/server": "workspace:*",
    "@scalar/fastify-api-reference": "^1.76.4",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "supertokens-node": "^24.1.0"
  },
  "devDependencies": {
    "@rateup/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "oxlint": "^1.91.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "26.x"
  }
}
