{
  "name": "@rateup/api",
  "version": "2.0.0",
  "private": true,
  "description": "RateUp backend: the HTTP API (Fastify), plus the services, queues and Prisma client the worker apps import.",
  "license": "MIT",
  "author": "Rateup Team",
  "repository": "https://github.com/TeamFynext/rateup-api",
  "type": "module",
  "exports": {
    "./*": {
      "source": "./src/*",
      "default": "./dist/src/*"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "email:dev": "email dev -d src/emails -p 3004",
    "backfill:wa-echoes": "tsx scripts/backfill-wa-echoes.ts",
    "staff:add": "tsx scripts/staff-add.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-sesv2": "^3.1164.0",
    "@aws-sdk/lib-storage": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@faker-js/faker": "^10.6.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "^10.1.8",
    "@fastify/swagger": "^9.9.3",
    "@fastify/websocket": "^11.3.7",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prometheus-io/client": "^0.16.1",
    "@rateup/db": "workspace:*",
    "@scalar/fastify-api-reference": "^1.77.0",
    "@shopify/shopify-api": "^15.1.1",
    "@supertokens-plugins/captcha-nodejs": "catalog:",
    "axios": "catalog:",
    "bcrypt": "^6.0.0",
    "bullmq": "catalog:",
    "cheerio": "^1.2.0",
    "dayjs": "catalog:",
    "dotenv": "catalog:",
    "fastify": "^5.12.8",
    "fastify-raw-body": "^6.0.3",
    "fastify-type-provider-zod": "^7.0.0",
    "form-data": "^4.0.6",
    "google-spreadsheet": "^5.3.0",
    "googleapis": "^189.0.0",
    "hucre": "^1.3.0",
    "immer": "catalog:",
    "ioredis": "^6.0.0",
    "jose": "^6.2.16",
    "kafkajs": "catalog:",
    "libphonenumber-js": "catalog:",
    "lodash": "catalog:",
    "nanoid": "^6.0.2",
    "nanoid-dictionary": "^5.0.0",
    "nodemailer": "^10.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "catalog:",
    "razorpay": "^2.9.8",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "6.11.8",
    "sharp": "catalog:",
    "stripe": "^23.1.0",
    "supertokens-node": "^24.1.0",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rateup/tsconfig": "workspace:*",
    "@react-email/ui": "6.11.8",
    "@types/bcrypt": "^6.0.0",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "catalog:",
