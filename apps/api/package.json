    "@faker-js/faker": "^10.6.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "^10.1.7",
    "@fastify/swagger": "^9.9.3",
    "@fastify/websocket": "^11.3.7",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@scalar/fastify-api-reference": "^1.76.4",
    "@shopify/shopify-api": "^15.0.1",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.6.0",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "fastify-raw-body": "^6.0.3",
    "fastify-type-provider-zod": "^7.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.6",
    "google-spreadsheet": "^5.3.0",
