{
  "extends": "@rateup/tsconfig/node.json",
  "compilerOptions": {
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts"],
  // Generated Prisma files are compiled when something imports them. pjtg.ts is imported by
  // nothing and does not pass nodenext's extension rule.
  "exclude": ["dist", "node_modules", "src/generated"]
}
