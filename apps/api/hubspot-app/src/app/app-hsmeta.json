{
  "uid": "rateup_hubspot_app",
  "type": "app",
  "config": {
    "name": "RateUp",
    "description": "WhatsApp conversations, contacts and Leads board deals from RateUp, kept in step with HubSpot.",
    "distribution": "marketplace",
    "isUserLevel": false,
    "auth": {
      "type": "oauth",
      "redirectUrls": ["http://localhost:3000/dashboard/settings/integrations/hubspot/callback"],
      "requiredScopes": [
        "oauth",
        "crm.objects.contacts.read",
        "crm.objects.contacts.write",
        "crm.objects.deals.read",
        "crm.objects.deals.write"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": [],
      "iframe": [],
      "img": []
    },
    "support": {
      "supportEmail": "hello@rateup.app",
      "documentationUrl": "https://docs.rateup.app",
      "supportUrl": "https://rateup.app"
    }
  }
}
