# rateup-ui — copy to .env and fill in.
#
# Everything prefixed VITE_ is inlined into the client bundle at build time and
# is therefore PUBLIC. Never put a secret behind a VITE_ name — it ships to every
# visitor's browser.

# ── Core ─────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001        # rateup-api base URL
VITE_FRONTEND_URL=http://localhost:5173   # this app's own public URL
# LAN address of the API, for testing on a phone against your dev machine.
VITE_API_IP=

# ── Assets ───────────────────────────────────────────────────────────────────
VITE_AWS_CLOUDFRONT_URL=
VITE_CLOUDFRONT_WEB_IMAGES_URL=
VITE_UNSPLASH_URL=

# ── Meta embedded signup ─────────────────────────────────────────────────────
# App id plus the per-flow configuration ids. Each config id maps to one signup
# variant (WhatsApp, WhatsApp + Instagram, + catalog, + ads, …); leave the
# variants you do not offer unset.
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
VITE_META_CONFIG_ID_ALL=
VITE_META_CONFIG_ID_WA_AD=
VITE_META_CONFIG_ID_WA_AD_CG=
VITE_META_CONFIG_ID_WA_AD_IG=
VITE_META_CONFIG_ID_WA_CG=
VITE_META_CONFIG_ID_WA_IG=
VITE_META_CONFIG_ID_WA_IG_CG=
VITE_META_USER_CONFIG_ID=

# ── Third party ──────────────────────────────────────────────────────────────
VITE_RAZORPAY_API_KEY=                    # publishable key only
VITE_ZOHO_CLIENT_ID=
VITE_FACEBOOK_PIXEL_ID=
VITE_SUPPORT_WHATSAPP=                    # support number shown in the UI

# ── Feature flags / org defaults ─────────────────────────────────────────────
VITE_ROOT_ORG=
VITE_ROOT_TOKEN=
# Comma-separated module keys to hide from the nav.
VITE_HIDDEN_MODULES=
VITE_EXPERIMENT=
VITE_PRICING_DEV=

# ── Build tooling (not part of the bundle) ───────────────────────────────────
# Uploads source maps during a production build; unset locally.
SENTRY_AUTH_TOKEN=
