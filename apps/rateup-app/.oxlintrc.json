{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "error"
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["src/utils/logger.ts", "**/*.test.ts", "**/*.test.tsx", "scripts/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
