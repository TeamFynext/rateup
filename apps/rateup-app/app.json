{
  "expo": {
    "name": "RateUp",
    "slug": "rateup",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "RateUp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "bundleIdentifier": "com.rateupapp.rateup",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow RateUp to access microphone.",
        "CFBundleURLTypes": [
      {
        "CFBundleURLSchemes": [
          "com.googleusercontent.apps.42123891439-smrmrokcalpi6j7m1dg1ep23keh4829f"
        ]
      }
    ]
      } 
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ],
      "statusBar": {
        "translucent": true,
        "backgroundColor": "transparent"
      },
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.rateupapp.rateup",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "backgroudColor": "#FFFFFF",
          "resizeMode": "cover",
          "splashScreenStyle": "single-screen",
          "light": {
            "backgroudColor": "#FFFFFF"
          }
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "62982a5a-c2c6-4de4-931a-6af66d273ba8"
      }
    },
    "owner": "rateup-app"
  }
}
