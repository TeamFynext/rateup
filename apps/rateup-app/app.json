{
  "expo": {
    "name": "RateUp",
    "slug": "rateup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "RateUp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
       "permissions": [
          "RECORD_AUDIO",
          "READ_MEDIA_AUDIO"
        ],
      "statusBar": {
        "translucent": true,
        "backgroundColor": "transparent"
      },
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.rateupapp.rateup",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "backgroudColor":"#FFFFFF",
          "resizeMode":"cover",
          "splashScreenStyle":"single-screen",
          "light":{
            "backgroudColor":"#FFFFFF"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "62982a5a-c2c6-4de4-931a-6af66d273ba8"
      }
    },
    "owner": "rateup-app"
  }
}
