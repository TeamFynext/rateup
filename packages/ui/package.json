{
  "name": "@rateup/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The RateUp design system for apps/web and apps/admin: shadcn components, theme provider and the shared theme CSS. Source-only: the apps bundle it.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tabler/icons-react": "^3.50.0",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@rateup/tsconfig": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
