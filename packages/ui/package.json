{
  "name": "@rateup/ui",
  "version": "1.0.0",
  "private": true,
  "description": "The RateUp design system for apps/web and apps/admin: shadcn components, theme provider and the shared theme CSS. Source-only: the apps bundle it.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@tabler/icons-react": "catalog:",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "catalog:",
    "cmdk": "^1.1.1",
    "cn": "catalog:",
    "react-is": "catalog:",
    "recharts": "catalog:",
    "shadcn": "^4.23.0",
    "sonner": "catalog:",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@rateup/tsconfig": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-router": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
