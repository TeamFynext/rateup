{
  "extends": "@rateup/tsconfig/node.json",
  "compilerOptions": {
    "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // Generated Prisma files are compiled when something imports them, as before the split.
  // pjtg.ts is imported by nothing and does not pass nodenext's extension rule.
  "exclude": ["dist", "node_modules", "src/generated"]
}
