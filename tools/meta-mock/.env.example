# The account under test. These are stamped onto status callbacks and replayed
# webhooks, and the receiving app resolves the tenant from them — get them wrong
# and the notification is silently ignored. They must match the WhatsappSettings
# row for the org you are testing.
META_MOCK_WABA_ID=
META_MOCK_PHONE_NUMBER_ID=
META_MOCK_DISPLAY_PHONE_NUMBER=

# Where status callbacks and replayed webhooks are delivered.
META_MOCK_WEBHOOK_URL=http://localhost:3001/api/wa/webhook

# Deliver sent -> delivered -> read after each send. Without this a send is
# answered and nothing follows, so campaign and message statuses never update.
META_MOCK_STATUS_PROGRESSION=1

# Fraction of sends that fail after "sent". Zero means never.
META_MOCK_FAILURE_RATE=0.2

# Refuse EVERY send synchronously with this Graph error code, the way Meta does
# for an account-level problem. 131042 is a broken payment method. Leave blank
# for normal sends. Flip it at runtime without restarting:
#   curl -X POST   localhost:8081/__stub/send-error -H 'content-type: application/json' -d '{"code":131042}'
#   curl -X DELETE localhost:8081/__stub/send-error
# META_MOCK_SEND_ERROR=131042

# Refuse this fraction of sends with a RANDOM Graph error — any code a send can
# return from Meta's error reference, except 131042, which only the variable
# above produces. Zero means never.
# META_MOCK_SEND_ERROR_RATE=0.1
# Narrow the random pool to specific codes (comma separated).
# META_MOCK_SEND_ERROR_CODES=131026,130429,131049

# PORT=8081
# META_MOCK_VERBOSE=1

# Bind address. Defaults to 127.0.0.1; set 0.0.0.0 to reach the mock from a
# container or another machine on the network.
# META_MOCK_HOST=0.0.0.0

# Which Graph API a bare request is assumed to target when the path alone is
# ambiguous. Defaults to the WhatsApp Cloud API.
# META_MOCK_DEFAULT_API=
