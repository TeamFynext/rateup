{
  "name": "@rateup/meta-mock",
  "version": "2.0.0",
  "private": true,
  "description": "A local stand-in for Meta's Graph API — WhatsApp Cloud API and Instagram — generated from Meta's published Postman collections.",
  "license": "MIT",
  "repository": "https://github.com/TeamFynext/whatsapp-mock-api",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./graph-fixtures.json": "./graph-fixtures.json"
  },
  "bin": {
    "meta-mock": "./bin/meta-mock.mjs"
  },
  "files": [
    "README.md",
    "ROUTES.md",
    "bin",
    "graph-fixtures.json",
    "index.d.ts",
    "index.mjs",
    "src"
  ],
  "scripts": {
    "start": "node bin/meta-mock.mjs --status-progression",
    "sync": "node scripts/sync-from-postman.mjs",
    "sync:check": "node scripts/sync-from-postman.mjs --check",
    "test": "node --test test/*.test.mjs",
    "routes": "node scripts/print-routes.mjs",
    "dev": "node bin/meta-mock.mjs --status-progression --verbose"
  },
  "engines": {
    "node": ">=26"
  }
}
