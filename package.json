{
  "name": "rateup-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev": "vp run --parallel --filter rateup-api --filter rateup-ui dev",
    "build": "vp run -r build",
    "typecheck": "vp run -r typecheck",
    "check": "vp check",
    "ready": "vp check && vp run -r typecheck && vp run -r build"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.16.1"
}
