{
  "name": "rateup-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev": "vp run --parallel --filter @rateup/api --filter @rateup/web dev",
    "dev:workers": "vp run --parallel --filter @rateup/worker-bullmq --filter @rateup/worker-kafka dev",
    "build": "vp run -r build",
    "typecheck": "vp run -r typecheck && pnpm --dir apps/mobile run typecheck",
    "check": "vp check",
    "ready": "vp check && vp run -r typecheck && vp run -r build",
    "install:mobile": "pnpm --dir apps/mobile install"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.16.1"
}
