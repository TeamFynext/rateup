# Each app keeps its own .gitignore for build output; these apply everywhere.
node_modules
*.log
*.tsbuildinfo
.DS_Store
.idea

# dotenv environment variable files
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json

# Vite+ hook dispatcher (generated by `vp config`)
.vite-hooks/_

# AI agent worktrees
.claude/worktrees/
